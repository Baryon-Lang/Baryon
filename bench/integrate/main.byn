import sys
from math import cos, exp, inf, sin
from integrate import IntegrationError, quad, simpson, solve_ivp, trapezoid

Vec2 = Fixed[f64, (2,)]


def van_der_pol(t: f64, y: Vec2, mu: f64) -> Vec2:
    return Vec2(y[1], mu * (1.0 - y[0] * y[0]) * y[1] - y[0])


def damped(x: f64, a: f64) -> f64:
    return exp(-a * x) * sin(x) * sin(x)


def gaussian(x: f64, a: f64) -> f64:
    return exp(-a * x * x) * cos(x)


def main() -> Raises[None, IntegrationError]:
    """Runs the case `sys.argv[1]` names and prints one number that sums its results, which the
    SciPy side prints too, so the two can be compared. Raises `IntegrationError` if a `quad`
    call fails, which none does."""
    which = sys.argv[1].copy()
    total = 0.0
    if which == "quad":
        # 100,000 integrals of exp(-a x) sin(x)**2 over [0, 10], a from 0.1 to 2.1.
        n = 100_000
        for i in range(n):
            a = 0.1 + 2.0 * ((i + 0.5) / n)
            value, error = quad(damped, 0.0, 10.0, args=(a,))
            total += value
    elif which == "quad_inf":
        # 10,000 integrals of exp(-a x**2) cos(x) over [0, inf), a from 0.5 to 2.5.
        n = 10_000
        for i in range(n):
            a = 0.5 + 2.0 * ((i + 0.5) / n)
            value, error = quad(gaussian, 0.0, inf, args=(a,))
            total += value
    elif which == "simpson" or which == "trapezoid":
        # 10 million samples of sin(x) on [0, pi], x evenly spaced.
        n = 10_000_000
        y: Array[f64, 1] = Array.zeros(n)
        for i in range(n):
            y[i] = sin(3.141592653589793 * f64(i) / f64(n - 1))
        dx = 3.141592653589793 / f64(n - 1)
        if which == "simpson":
            total = simpson(y, dx=dx)
        else:
            total = trapezoid(y, dx=dx)
    elif which == "rk45" or which == "dop853":
        # 100 runs of the van der Pol oscillator with mu = 2 to t = 100, from x = 1 + k / 100:
        # rtol 1e-6 and atol 1e-9 for RK45, 1e-10 and 1e-12 for DOP853. The sum of the calls of
        # the right-hand side, then the sum of the last x.
        calls = 0
        for k in range(100):
            y0 = Vec2(1.0 + 0.01 * f64(k), 0.0)
            if which == "rk45":
                r = solve_ivp(van_der_pol, (0.0, 100.0), y0, args=(2.0,), rtol=1e-6, atol=1e-9)
                calls += r.nfev
                total += r.y[0, len(r.t) - 1]
            else:
                r = solve_ivp(
                    van_der_pol, (0.0, 100.0), y0, "DOP853", args=(2.0,), rtol=1e-10, atol=1e-12
                )
                calls += r.nfev
                total += r.y[0, len(r.t) - 1]
        print(calls)
    print(total)
