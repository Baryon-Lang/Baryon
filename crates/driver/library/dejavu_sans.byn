def kerning() -> str:
    """The font's kerning pairs among these characters: six letters each, the first character's
    place, the second's, and the change to the gap between them, as `font` reads them."""
    return (
        "AiAig5AiAkfcAiAofcAiAwfcAiAyfcAiA1dhAiA3d9AiA4eQAiA6dhAiBEfcAiAbfcAiBFfcAiBGfcAiBHe3AiAO"
        + "fTAiBQfcAiAPfcAiBSfcAiBVfcAiBXeIAiBYetAiBad1AjAkfcAjAofcAjAwfcAjA0fcAjA3fBAjA4e3AjA6eQAk"
        + "A6fcAlAifcAlA3fcAlA6eQAnAidEAnA0fcAnA1fcAnBCdEAnAbdhAnBGeQAnBKdrAnBQe3AnAPa3AnBTdrAnBWeQ"
        + "AnBadEAoA1e3AoA6eaApAPfcArAifcArAOe3AsAifcAsAkeQAsAweQAsA1dhAsA2fJAsA4e3AsA6e3AsBCfcAsBG"
        + "eaAsAOcpAsBQeaAsBWeaAsBadrAtAigvAtAwe3AtA1bmAtA2eaAtA3cfAtA4dEAtA6bwAtBGfcAtAOfcAtBQfcAt"
        + "BWfcAtBadEAwAifcAwA3fcAwA5d9AwA6eQAwAbfcAwAOg5AwAPetAxAid9AxA6fTAxBCekAxBGe3AxAOfTAxBKfT"
        + "AxBPfcAxBQe3AxAPbBAxBTfcAxBUfcAxBWfcAyAOg5AzAietAzAkeaAzA1drAzA3eQAzA4etAzA6d9AzBCfTAzAb"
