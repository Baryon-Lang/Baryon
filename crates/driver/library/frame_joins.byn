"""The join of two `DataFrame`s, written in Baryon (decision 0045): `left.merge(right, on=...)`.

The compiler calls these functions; a program cannot import this file. Its sort is the one in
`<std>/frames.byn`.

An inner join pairs each row of the left frame with every row of the right frame whose key
columns hold the same values. The compiler puts each key column of the two frames end to end
with `joined`, the left frame's rows first, and sorts the rows of the two frames together by
the keys. `key_marks`, once for each key column, finds where the keys change, and `group_ids`
numbers the rows so that two rows have one number exactly when their keys are equal. From
there the join is a join on one column of integers: `join_pairs` lists the pairs, and
`pair_side` gives the rows of one frame, which `taken` copies column by column.

Cost for `n` rows in the two frames together and `k` pairs: a sort, about `n log n`
comparisons for each key column, then `n + k` steps, with arrays of `n` and of `2k` integers.

The file also holds `text_masked` and `text_taken`, which choose rows of a column of `str` as
`masked` and `taken` of `<std>/frames.byn` do for a column of numbers, `text_joined`, which
is `joined` for a column of `str`, and `text_codes`, which turns a column of `str` into
integers in the same order, so that a sort by text is a sort by integers. `counted_values`
counts for an array's `nunique`, and `valued_rows` and `id_counts` for a frame's
`value_counts`. `group_rows` picks the row of each group whose text `agg` gives, and
`statistic_names` and `described` make the columns of a frame's `describe`.
"""

from math import fsum, isnan, nan, sqrt


def joined[T: Number](left: Array[T, 1], right: Array[T, 1]) -> Array[T, 1]:
    """The elements of `left`, then those of `right`, as a new array."""
    count = len(left)
    return Array([
        left[at] if at < count else right[at - count] for at in range(count + len(right))
    ])


def key_marks[T: Number](
    column: Array[T, 1], order: Array[i64, 1], marks: Array[bool, 1]
) -> Array[bool, 1]:
    """`marks` with one more key column taken in: element `i` is true where row `order[i]`
    has another key than the row before it in `order`, or is the first row. Two NaN are one
    key here, as pandas joins them, though NaN is not equal to NaN."""
    result = [flag for flag in marks]
    for at in range(len(order)):
        if at == 0:
            result[at] = True
        else:
            value = column[order[at]]
            before = column[order[at - 1]]
            if value != before and (value == value or before == before):
                result[at] = True
    return Array(result)


def group_ids(order: Array[i64, 1], marks: Array[bool, 1]) -> Array[i64, 1]:
    """A number for each row, the same for two rows exactly when their keys are equal:
    element `r` is the number of the group that row `r` is in, counting from 0 in the order
    of the keys."""
    ids = [0 for at in order]
    group = -1
    for at in range(len(order)):
        if marks[at]:
            group += 1
        ids[order[at]] = group
    return Array(ids)


def join_pairs(ids: Array[i64, 1], left_count: int) -> Array[i64, 1]:
    """The pairs of an inner join, one after another: a row of the left frame, then the row
    of the right frame it is paired with. `ids` holds the group of each row, the left
    frame's `left_count` rows first. The pairs follow the left frame's rows in order, and
    for one left row the right frame's rows in order, as pandas's do."""
    total = len(ids)
    groups = 0
    for at in range(total):
        groups = max(groups, ids[at] + 1)
    # Where each group's right rows start among the right rows sorted by group.
    starts = [0 for group in range(groups + 1)]
    for at in range(left_count, total):
        starts[ids[at] + 1] += 1
    for group in range(groups):
        starts[group + 1] += starts[group]
    filled = [start for start in starts]
    rows = [0 for at in range(left_count, total)]
    for at in range(left_count, total):
        group = ids[at]
        rows[filled[group]] = at - left_count
        filled[group] += 1
    pairs: list[int] = []
    for at in range(left_count):
        group = ids[at]
        for slot in range(starts[group], starts[group + 1]):
            pairs.append(at)
            pairs.append(rows[slot])
    return Array(pairs)


def pair_side(pairs: Array[i64, 1], side: int) -> Array[i64, 1]:
    """The rows of one frame in the pairs `join_pairs` gives: the left frame's when `side`
    is 0, the right frame's when it is 1."""
    return Array([pairs[2 * at + side] for at in range(len(pairs) // 2)])


def first_rows(ids: Array[i64, 1]) -> Array[i64, 1]:
    """The rows that `drop_duplicates` keeps, in order: each row whose number in `ids`, the
    number `group_ids` gives its key, no row before it has. Cost: one pass over the rows."""
    groups = 0
    for at in range(len(ids)):
        groups = max(groups, ids[at] + 1)
    seen = [False for group in range(groups)]
    rows: list[int] = []
    for at in range(len(ids)):
        if not seen[ids[at]]:
            seen[ids[at]] = True
            rows.append(at)
    return Array(rows)


def text_masked(column: Array[str, 1], mask: Array[bool, 1]) -> Array[str, 1]:
    """`masked` for a column of `str`: the elements of `column` where `mask` is true, as a
    new text array. Cost: one copy of each element kept, in a list, before the array is
    built from the list."""
    return Array([column[row].copy() for row in range(len(column)) if mask[row]])


def text_taken(column: Array[str, 1], positions: Array[i64, 1]) -> Array[str, 1]:
    """`taken` for a column of `str`: the elements of `column` at `positions`, in that order,
    as a new text array. Cost: as `text_masked`."""
    return Array([column[positions[row]].copy() for row in range(len(positions))])


def text_joined(left: Array[str, 1], right: Array[str, 1]) -> Array[str, 1]:
    """`joined` for a column of `str`: the elements of `left`, then those of `right`, as a new
    text array. Cost: as `text_masked`."""
    count = len(left)
    return Array([
        left[at].copy() if at < count else right[at - count].copy()
        for at in range(count + len(right))
    ])


def text_codes(column: Array[str, 1]) -> Array[i64, 1]:
    """A whole number for each element of `column` that stands for its text when rows are
    put in order: equal texts get one number, and a text that comes before another, by
    Python's `<`, gets a smaller one. A sort by a column of `str` is `ordered` on these
    numbers, so text keys need no sort of their own.

    A merge sort of the positions from the bottom up, then one pass that numbers the
    distinct texts: `n log n` comparisons of text and three arrays of `n` integers."""
    count = len(column)
    order = Array([at for at in range(count)])
    spare = order.copy()
    width = 1
    while width < count:
        low = 0
        while low < count:
            middle = min(low + width, count)
            high = min(low + 2 * width, count)
            left = low
            right = middle
            for at in range(low, high):
                from_left = right >= high
                if left < middle and right < high:
                    from_left = not (column[order[right]] < column[order[left]])
                if from_left:
                    spare[at] = order[left]
                    left += 1
                else:
                    spare[at] = order[right]
                    right += 1
            low = high
        for at in range(count):
            order[at] = spare[at]
        width *= 2
    code = 0
    for at in range(count):
        if at > 0 and column[order[at - 1]] != column[order[at]]:
            code += 1
        spare[order[at]] = code
    return spare


def counted_values[T: Number](column: Array[T, 1], rows: Array[i64, 1]) -> int:
    """How many of the elements of `column` at the positions `rows` are values, a NaN not
    being one: what `nunique` gives when `rows` holds one position for each distinct
    element, as `first_rows` finds them. Cost: one pass over `rows`."""
    count = 0
    for at in range(len(rows)):
        value = column[rows[at]]
        if value == value:
            count += 1
    return count


def valued_rows[T: Number](column: Array[T, 1], rows: Array[i64, 1]) -> Array[i64, 1]:
    """The positions of `rows` where `column` holds a value, a NaN not being one, in the
    order of `rows`: `value_counts` counts no NaN. Cost: one pass over `rows`."""
    return Array([
        rows[at] for at in range(len(rows)) if column[rows[at]] == column[rows[at]]
    ])


def id_counts(ids: Array[i64, 1], rows: Array[i64, 1]) -> Array[i64, 1]:
    """For each position of `rows`, how many rows have the number that `ids` gives the row
    there: the count of each distinct value when `rows` holds one row of each, as
    `first_rows` finds them. Cost: one pass over `ids` and one over `rows`."""
    groups = 0
    for at in range(len(ids)):
        groups = max(groups, ids[at] + 1)
    counts = [0 for group in range(groups)]
    for at in range(len(ids)):
        counts[ids[at]] += 1
    return Array([counts[ids[rows[at]]] for at in range(len(rows))])


def group_rows(
    values: Array[i64, 1], order: Array[i64, 1], starts: Array[i64, 1], how: int
) -> Array[i64, 1]:
    """One row for each group of `groupby`, the row whose text `agg` gives for a column of
    `str`: by the numbers `group_integers` uses, 1 the row with the smallest of `values`,
    2 the largest, 3 the group's first row and 4 its last. `values` are the numbers
    `text_codes` gives the column, so the smallest is the text that comes first by `<`; of
    equal ones the first row is given. `order` and `starts` are the groups as `frames.byn`
    finds them. One pass over the rows."""
    result = [0 for group in range(len(starts) - 1)]
    for group in range(len(starts) - 1):
        low = starts[group]
        high = starts[group + 1]
        row = order[low]
        if how == 4:
            row = order[high - 1]
        for at in range(low + 1, high):
            other = order[at]
            if how == 1 and values[other] < values[row]:
                row = other
            if how == 2 and values[other] > values[row]:
                row = other
        result[group] = row
    return Array(result)


def statistic_names() -> Array[str, 1]:
    """The column `statistic` of `describe`: the name of each number `described` gives, in
    order, as pandas names them."""
    return Array(["count", "mean", "std", "min", "25%", "50%", "75%", "max"])


def described(column: Array[f64, 1]) -> Array[f64, 1]:
    """The eight numbers `describe` gives for one column, a NaN left out as in pandas: how
    many values there are, their mean, their sample standard deviation, which divides by one
    less than the count and is NaN for one value, the smallest, the quartiles and the
    largest. A quartile that falls between two values is taken on the line between them, as
    NumPy's `percentile` takes it. With no values the count is 0 and the rest are NaN.
    Cost: one copy of the values and a sort of it."""
    values = sorted([value for value in column if not isnan(value)])
    count = len(values)
    result = [nan for at in range(8)]
    result[0] = f64(count)
    if count == 0:
        return Array(result)
    mean = fsum(values) / f64(count)
    result[1] = mean
    if count > 1:
        squares = fsum([(value - mean) * (value - mean) for value in values])
        result[2] = sqrt(squares / f64(count - 1))
    result[3] = values[0]
    for quarter in range(1, 4):
        at = 0.25 * f64(quarter) * f64(count - 1)
        low = int(at)
        high = min(low + 1, count - 1)
        part = at - f64(low)
        gap = values[high] - values[low]
        if part < 0.5:
            result[3 + quarter] = values[low] + gap * part
        else:
            result[3 + quarter] = values[high] - gap * (1.0 - part)
    result[7] = values[count - 1]
    return Array(result)


def _text_holds(left: str, right: str, how: int) -> bool:
    """Whether `left` and `right` compare the way `how` numbers: 0 `==`, 1 `!=`, 2 `<`,
    3 `<=`, 4 `>`, 5 `>=`, each as Python compares `str`."""
    if how == 0:
        return left == right
    if how == 1:
        return left != right
    if how == 2:
        return left < right
    if how == 3:
        return left <= right
    if how == 4:
        return left > right
    return left >= right


def text_compared(left: Array[str, 1], right: Array[str, 1], how: int) -> Array[bool, 1]:
    """A comparison of two text arrays of one length, element by element: true where the
    two elements compare the way `how` numbers, as `_text_holds` reads it."""
    return Array([_text_holds(left[at], right[at], how) for at in range(len(left))])


def text_compared_to(column: Array[str, 1], value: str, how: int) -> Array[bool, 1]:
    """A comparison of each element of a text array with the one text `value`: true where
    the element, on the left, compares with it the way `how` numbers."""
    return Array([_text_holds(column[at], value, how) for at in range(len(column))])


def text_found(column: Array[str, 1], value: str) -> bool:
    """Whether an element of `column` equals `value`: `value in column`. Stops at the
    first one found."""
    for at in range(len(column)):
        if column[at] == value:
            return True
    return False


def _quoted(text: str) -> str:
    """`text` in quotes, as Python's `repr` writes a `str`: in single quotes, or in double
    quotes when it holds a single quote and no double one, with a backslash before a
    backslash and before the quote used, and a new line, a return and a tab written `\\n`,
    `\\r` and `\\t`. Other characters stand as they are, the control characters that `repr`
    would write as numbers among them."""
    escaped = text.replace("\\", "\\\\").replace("\n", "\\n")
    escaped = escaped.replace("\r", "\\r").replace("\t", "\\t")
    if "'" in text and not ("\"" in text):
        return "\"" + escaped + "\""
    return "'" + escaped.replace("'", "\\'") + "'"


def text_shown(column: Array[str, 1]) -> str:
    """A text array as `print` shows it, which is how NumPy shows an array of strings: each
    element as Python's `repr` writes it, a space between two, the whole in brackets. A line
    holds at most 75 characters and the next starts under the first element. Of more than
    1000 elements the first three and the last three are shown, with `...` between. Cost:
    one copy of each element shown."""
    count = len(column)
    shown = [at for at in range(count)]
    if count > 1000:
        shown = [0, 1, 2, -1, count - 3, count - 2, count - 1]
    words: list[str] = []
    for at in shown:
        if at < 0:
            words.append("...")
        else:
            words.append(_quoted(column[at]))
    text = ""
    line = " "
    for at in range(len(words)):
        if len(line) > 1 and len(line) + len(words[at]) > 74:
            text = f"{text}{line.rstrip()}\n"
            line = " "
        line = f"{line}{words[at]}"
        if at < len(words) - 1:
            line = f"{line} "
    text = f"{text}{line}"
    return f"[{text[1:]}]"


def text_extreme(column: Array[str, 1], largest: bool) -> str:
    """A copy of the element of `column` that comes first by Python's `<` on `str`, or last
    when `largest`: a text array's `min` and `max`. `column` has an element, which the
    compiler has checked. One pass, comparing text."""
    best = 0
    for at in range(1, len(column)):
        if largest and column[at] > column[best]:
            best = at
        if not largest and column[at] < column[best]:
            best = at
    return column[best].copy()
