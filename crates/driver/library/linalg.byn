"""The `linalg` module: linear algebra written in Baryon (decision 0040), with NumPy's names.

Every function fixes its order of operations, so a result has the same bits on every machine.

The functions live in internal files of the standard library, one for each family: solving and
factoring in `linalg_factor`, symmetric eigenvalues in `linalg_symmetric`, the singular value
decomposition in `linalg_svd` and general eigenvalues in `linalg_eig`, with `LinAlgError` and
what they share in `linalg_common`. This file re-exports each public name with
`from linalg_factor import solve as solve` (decision 0062), so a program imports `linalg` alone
and never sees the files behind it.
"""

from linalg_common import LinAlgError as LinAlgError
from linalg_factor import lu_factor as lu_factor, lu_solve as lu_solve, solve as solve
from linalg_factor import det as det, inv as inv, cholesky as cholesky, qr as qr
from linalg_symmetric import eigh as eigh, eigvalsh as eigvalsh
from linalg_svd import svd as svd, svdvals as svdvals
from linalg_eig import eig as eig, eigvals as eigvals
