"""The `stats` module: statistics written in Baryon (decision 0042), with NumPy's names.

Each function rounds where NumPy's does, so a result has NumPy's bits. The mean, variance and
standard deviation are array methods, `a.mean()`, `a.var()` and `a.std()`, as in NumPy.
"""

from math import floor, isfinite, isnan, nan, sqrt, trunc


def _has_nan(a: Array[f64, 1]) -> bool:
    """Whether any element of `a` is NaN."""
    for i in range(len(a)):
        if isnan(a[i]):
            return True
    return False


def _select(values: InOut[Array[f64, 1]], k: int) -> f64:
    """The `k`th smallest element of `values`, counting from 0, which holds no NaN.

    Rearranges `values` so the element at `k` is in its sorted place, every element before it
    is no larger and every element after it no smaller: Hoare's selection, with the median of
    the first, middle and last elements as the pivot. Expected cost about 3n comparisons; the
    value found is the same whatever the algorithm, so only the time depends on it.
    """
    low = 0
    high = len(values) - 1
    while low < high:
        middle = low + (high - low) // 2
        if values[middle] < values[low]:
            swap = values[middle]
            values[middle] = values[low]
            values[low] = swap
        if values[high] < values[low]:
            swap = values[high]
            values[high] = values[low]
            values[low] = swap
        if values[high] < values[middle]:
            swap = values[high]
            values[high] = values[middle]
            values[middle] = swap
        pivot = values[middle]
        i = low
        j = high
        while i <= j:
            while values[i] < pivot:
                i += 1
            while pivot < values[j]:
                j -= 1
            if i <= j:
                swap = values[i]
                values[i] = values[j]
                values[j] = swap
                i += 1
                j -= 1
        if k <= j:
            high = j
        elif k >= i:
            low = i
        else:
            return values[k]
    return values[k]


def _smallest_after(values: Array[f64, 1], k: int) -> f64:
    """The smallest element of `values` after position `k`, once `_select` has put the `k`th
    smallest there: the `k + 1`th smallest."""
    best = values[k + 1]
    for i in range(k + 2, len(values)):
        if values[i] < best:
            best = values[i]
    return best


def median(a: Array[f64, 1]) -> f64:
    """The median of `a`, as `numpy.median`: the middle element of `a` sorted, or the mean of
    the two middle elements, `(x + y) / 2`, when the length is even.

    NaN when any element is NaN, and NaN for an empty array, as NumPy gives (it also warns).
    Copies `a` once and selects in place, about 3n comparisons on average; `a` is unchanged.
    """
    n = len(a)
    if n == 0 or _has_nan(a):
        return nan
    values = a.copy()
    half = n // 2
    if n % 2 == 1:
        return _select(values, half)
    low = _select(values, half - 1)
    return (low + _smallest_after(values, half - 1)) / 2.0


def quantile(a: Array[f64, 1], q: f64) -> f64:
    """The `q` quantile of `a`, for `q` from 0 to 1, as `numpy.quantile` with its default
    method, "linear": the element at the fractional position `(n - 1) * q` of `a` sorted,
    interpolated linearly between its two neighbours, rounded as NumPy rounds.

    NaN when any element is NaN. Panics when `q` is outside 0 to 1, where NumPy raises
    `ValueError`, or when `a` is empty. Copies `a` once and selects in place; `a` is unchanged.
    """
    assert q >= 0.0 and q <= 1.0, "quantile needs q from 0 to 1"
    n = len(a)
    assert n > 0, "quantile of an empty array"
    if _has_nan(a):
        return nan
    position = (n - 1) * q
    values = a.copy()
    # NumPy takes the last element for both neighbours at the end of the range, and keeps
    # `position - (-1)` as the weight; the interpolation below then gives that element, or NaN
    # when it is infinite, exactly as NumPy's does.
    previous = 0.0
    following = 0.0
    gamma = 0.0
    if position < n - 1:
        below = floor(position)
        gamma = position - below
        previous = _select(values, below)
        following = _smallest_after(values, below)
    else:
        gamma = position + 1.0
        previous = _select(values, n - 1)
        following = previous
    difference = following - previous
    if gamma >= 0.5:
        return following - difference * (1.0 - gamma)
    return previous + difference * gamma


def percentile(a: Array[f64, 1], q: f64) -> f64:
    """The `q` percentile of `a`, for `q` from 0 to 100, as `numpy.percentile`: the quantile
    `q / 100`, computed as `quantile` does.

    NaN when any element is NaN. Panics when `q` is outside 0 to 100, where NumPy raises
    `ValueError`, or when `a` is empty.
    """
    assert q >= 0.0 and q <= 100.0, "percentile needs q from 0 to 100"
    return quantile(a, q / 100.0)


def average(a: Array[f64, 1], weights: Array[f64, 1]) -> f64:
    """The mean of `a` weighted by `weights`, as `numpy.average(a, weights=weights)`: the sum of
    `a * weights` over the sum of `weights`, each sum added in NumPy's pairwise order.

    The unweighted average is `a.mean()`. Panics when the lengths differ, or when the weights
    sum to zero, where NumPy raises `ZeroDivisionError`. Reads both arrays twice and stores
    nothing.
    """
    assert len(weights) == len(a), "average needs weights as long as a"
    scale = weights.sum()
    assert scale != 0.0, "average needs weights that do not sum to zero"
    return (a * weights).sum() / scale


def histogram(a: Array[f64, 1], bins: int) -> tuple[Array[int, 1], Array[f64, 1]]:
    """The counts of `a` in `bins` equal bins from its smallest to its largest element, and the
    `bins + 1` edges of those bins, as `numpy.histogram(a, bins)`.

    Bin `k` holds the elements from `edges[k]` up to but not including `edges[k + 1]`; the last
    bin also holds the largest element. The edges are `numpy.linspace`'s, `start + k * step`
    with the last edge exactly the largest element, and each element is placed by NumPy's
    arithmetic and corrected against the edges as NumPy's is, so counts and edges match NumPy's
    exactly. When every element is equal the range is widened by 0.5 on each side; an empty `a`
    takes the range 0 to 1. Panics when `bins` is less than 1, or when an element is NaN or
    infinite, where NumPy raises `ValueError`. Two passes over `a`.
    """
    assert bins >= 1, "histogram needs at least one bin"
    first = 0.0
    last = 1.0
    if len(a) > 0:
        first = a.min()
        last = a.max()
        assert isfinite(first) and isfinite(last), "histogram needs finite elements"
    if first == last:
        first = first - 0.5
        last = last + 0.5
    edges = Array.zeros(bins + 1)
    delta = last - first
    step = delta / bins
    for k in range(bins + 1):
        if step == 0.0:
            edges[k] = k / bins * delta + first
        else:
            edges[k] = k * step + first
    edges[bins] = last
    counts = Array.zeros(bins, dtype=int)
    for i in range(len(a)):
        x = a[i]
        index = trunc((x - first) / delta * bins)
        if index == bins:
            index -= 1
        if x < edges[index]:
            index -= 1
        if x >= edges[index + 1] and index != bins - 1:
            index += 1
        counts[index] += 1
    return counts, edges


def _cov_entries(x: Array[f64, 1], y: Array[f64, 1]) -> tuple[f64, f64, f64]:
    """The covariance matrix entries of `x` and `y` as `numpy.cov(x, y)` computes them: the
    variance of `x`, the covariance, and the variance of `y`, each a pairwise dot product of
    deviations from the mean times `1 / (n - 1)`."""
    assert len(x) == len(y), "cov needs x and y of the same length"
    n = len(x)
    dx = x - x.mean()
    dy = y - y.mean()
    fact = 0.0
    if n > 1:
        fact = n - 1.0
    scale = 1.0 / fact
    return dx.dot(dx) * scale, dx.dot(dy) * scale, dy.dot(dy) * scale


def cov(x: Array[f64, 1], y: Array[f64, 1]) -> Array[f64, 2]:
    """The 2 by 2 covariance matrix of `x` and `y`, as `numpy.cov(x, y)`: the sample variances
    on the diagonal and the sample covariance off it, dividing by `n - 1`.

    Each entry is the dot product of the two deviations from the mean, added in NumPy's
    pairwise order, times `1 / (n - 1)` as NumPy multiplies. NumPy forms the products through
    BLAS, whose order depends on the machine, so its last bit can differ. Fewer than two
    elements give infinity or NaN, as NumPy's do. Panics when the lengths differ.
    """
    xx, xy, yy = _cov_entries(x, y)
    result = Array.zeros((2, 2))
    result[0, 0] = xx
    result[0, 1] = xy
    result[1, 0] = xy
    result[1, 1] = yy
    return result


def _clip_unit(value: f64) -> f64:
    """`value` limited to -1 to 1, as `numpy.clip(value, -1, 1)`; NaN stays NaN."""
    if value > 1.0:
        return 1.0
    if value < -1.0:
        return -1.0
    return value


def corrcoef(x: Array[f64, 1], y: Array[f64, 1]) -> Array[f64, 2]:
    """The 2 by 2 matrix of Pearson correlation coefficients of `x` and `y`, as
    `numpy.corrcoef(x, y)`: 1 on the diagonal and the correlation off it.

    Each entry of `cov(x, y)` is divided by the standard deviation of its row and then of its
    column, and limited to -1 to 1, in NumPy's order. NaN when either array is constant, as
    NumPy's is. Panics when the lengths differ.
    """
    xx, xy, yy = _cov_entries(x, y)
    sx = sqrt(xx)
    sy = sqrt(yy)
    result = Array.zeros((2, 2))
    result[0, 0] = _clip_unit(xx / sx / sx)
    result[0, 1] = _clip_unit(xy / sx / sy)
    result[1, 0] = _clip_unit(xy / sy / sx)
    result[1, 1] = _clip_unit(yy / sy / sy)
    return result
