"""Internal file of `linalg` (decision 0040): the shifted double QR iteration of a Hessenberg
matrix with back-substitution for its eigenvectors (EISPACK's `hqr2`), which `eig` and `eigvals`
in `linalg_eig` build on. It is its own file so that neither stays past 500 lines. A program
cannot import this file.
"""

from math import copysign, fabs, sqrt
from linalg_common import LinAlgError, epsilon


def schur[T: Float](
    h: InOut[Array[T, 2]],
    v: InOut[Array[T, 2]],
    real: InOut[Array[T, 1]],
    imaginary: InOut[Array[T, 1]],
) -> Raises[None, LinAlgError]:
    """Finds the eigenvalues of the Hessenberg matrix `h` by the shifted double QR iteration,
    into `real` and `imaginary`, then the eigenvectors by back-substitution, into `v`: EISPACK's
    `hqr2` as JAMA writes it, with the single-letter names of the original. A complex pair's
    eigenvector is two columns of `v`, its real and imaginary parts. Raises `LinAlgError` after
    100 iterations on one eigenvalue.
    """
    size = h.shape[0]
    n = size - 1
    machine_epsilon = epsilon(h[0, 0])
    shift: T = 0.0
    p: T = 0.0
    q: T = 0.0
    r: T = 0.0
    s: T = 0.0
    z: T = 0.0
    norm: T = 0.0
    for i in range(size):
        for j in range(max(i - 1, 0), size):
            norm += fabs(h[i, j])
    iterations = 0
    while n >= 0:
        l = n
        while l > 0:
            s = fabs(h[l - 1, l - 1]) + fabs(h[l, l])
            if s == 0.0:
                s = norm
            if fabs(h[l, l - 1]) < machine_epsilon * s:
                break
            l -= 1
        if l == n:
            h[n, n] += shift
            real[n] = h[n, n]
            imaginary[n] = 0.0
            n -= 1
            iterations = 0
        elif l == n - 1:
            w = h[n, n - 1] * h[n - 1, n]
            p = (h[n - 1, n - 1] - h[n, n]) / 2.0
            q = p * p + w
            z = sqrt(fabs(q))
            h[n, n] += shift
            h[n - 1, n - 1] += shift
            x = h[n, n]
            if q >= 0.0:
                z = p + copysign(z, p)
                real[n - 1] = x + z
                real[n] = real[n - 1]
                if z != 0.0:
                    real[n] = x - w / z
                imaginary[n - 1] = 0.0
                imaginary[n] = 0.0
                x = h[n, n - 1]
                s = fabs(x) + fabs(z)
                p = x / s
                q = z / s
                r = sqrt(p * p + q * q)
                p /= r
                q /= r
                for j in range(n - 1, size):
                    z = h[n - 1, j]
                    h[n - 1, j] = q * z + p * h[n, j]
                    h[n, j] = q * h[n, j] - p * z
                for i in range(n + 1):
                    z = h[i, n - 1]
                    h[i, n - 1] = q * z + p * h[i, n]
                    h[i, n] = q * h[i, n] - p * z
                for i in range(size):
                    z = v[i, n - 1]
                    v[i, n - 1] = q * z + p * v[i, n]
                    v[i, n] = q * v[i, n] - p * z
            else:
                real[n - 1] = x + p
                real[n] = x + p
                imaginary[n - 1] = z
                imaginary[n] = -z
            n -= 2
            iterations = 0
        else:
            x = h[n, n]
            y: T = 0.0
            w = 0.0
            if l < n:
                y = h[n - 1, n - 1]
                w = h[n, n - 1] * h[n - 1, n]
            if iterations == 10:
                shift += x
                for i in range(n + 1):
                    h[i, i] -= x
                s = fabs(h[n, n - 1]) + fabs(h[n - 1, n - 2])
                x = 0.75 * s
                y = x
                w = -0.4375 * s * s
            if iterations == 30:
                s = (y - x) / 2.0
                s = s * s + w
                if s > 0.0:
                    s = sqrt(s)
                    if y < x:
                        s = -s
                    s = x - w / ((y - x) / 2.0 + s)
                    for i in range(n + 1):
                        h[i, i] -= s
                    shift += s
                    x = 0.964
                    y = x
                    w = x
            iterations += 1
            if iterations > 100:
                raise LinAlgError("Eigenvalues did not converge")
            m = n - 2
            while m >= l:
                z = h[m, m]
                r = x - z
                s = y - z
                p = (r * s - w) / h[m + 1, m] + h[m, m + 1]
                q = h[m + 1, m + 1] - z - r - s
                r = h[m + 2, m + 1]
                s = fabs(p) + fabs(q) + fabs(r)
                p /= s
                q /= s
                r /= s
                if m == l:
                    break
                left = fabs(h[m, m - 1]) * (fabs(q) + fabs(r))
                right = machine_epsilon * (fabs(p) * (fabs(h[m - 1, m - 1]) + fabs(z) + fabs(h[m + 1, m + 1])))
                if left < right:
                    break
                m -= 1
            for i in range(m + 2, n + 1):
                h[i, i - 2] = 0.0
                if i > m + 2:
                    h[i, i - 3] = 0.0
            for k in range(m, n):
                not_last = k != n - 1
                if k != m:
                    p = h[k, k - 1]
                    q = h[k + 1, k - 1]
                    r = 0.0
                    if not_last:
                        r = h[k + 2, k - 1]
                    x = fabs(p) + fabs(q) + fabs(r)
                    if x == 0.0:
                        continue
                    p /= x
                    q /= x
                    r /= x
                s = copysign(sqrt(p * p + q * q + r * r), p)
                if s == 0.0:
                    continue
                if k != m:
                    h[k, k - 1] = -s * x
                elif l != m:
                    h[k, k - 1] = -h[k, k - 1]
                p += s
                x = p / s
                y = q / s
                z = r / s
                q /= p
                r /= p
                for j in range(k, size):
                    p = h[k, j] + q * h[k + 1, j]
                    if not_last:
                        p += r * h[k + 2, j]
                        h[k + 2, j] -= p * z
                    h[k, j] -= p * x
                    h[k + 1, j] -= p * y
                for i in range(min(n, k + 3) + 1):
                    p = x * h[i, k] + y * h[i, k + 1]
                    if not_last:
                        p += z * h[i, k + 2]
                        h[i, k + 2] -= p * r
                    h[i, k] -= p
                    h[i, k + 1] -= p * q
                for i in range(size):
                    p = x * v[i, k] + y * v[i, k + 1]
                    if not_last:
                        p += z * v[i, k + 2]
                        v[i, k + 2] -= p * r
                    v[i, k] -= p
                    v[i, k + 1] -= p * q
    if norm == 0.0:
        return
    _back_substitute(h, real, imaginary, norm)
    for j in range(size - 1, -1, -1):
        for i in range(size):
            total: T = 0.0
            for k in range(j + 1):
                total += v[i, k] * h[k, j]
            v[i, j] = total


def _back_substitute[T: Float](h: InOut[Array[T, 2]], real: Array[T, 1], imaginary: Array[T, 1], norm: T):
    """Overwrites the quasi-triangular Schur form `h` with the eigenvectors of that form, by
    back-substitution: the second half of EISPACK's `hqr2`. `norm` is the sum of the magnitudes of
    the Hessenberg matrix's entries, which stands in for a zero divisor.
    """
    size = h.shape[0]
    machine_epsilon = epsilon(h[0, 0])
    z: T = 0.0
    s: T = 0.0
    r: T = 0.0
    for n in range(size - 1, -1, -1):
        p = real[n]
        q = imaginary[n]
        if q == 0.0:
            l = n
            h[n, n] = 1.0
            for i in range(n - 1, -1, -1):
                w = h[i, i] - p
                r = 0.0
                for j in range(l, n + 1):
                    r += h[i, j] * h[j, n]
                if imaginary[i] < 0.0:
                    z = w
                    s = r
                    continue
                l = i
                if imaginary[i] == 0.0:
                    if w != 0.0:
                        h[i, n] = -r / w
                    else:
                        h[i, n] = -r / (machine_epsilon * norm)
                else:
                    x = h[i, i + 1]
                    y = h[i + 1, i]
                    q = (real[i] - p) * (real[i] - p) + imaginary[i] * imaginary[i]
                    t = (x * s - z * r) / q
                    h[i, n] = t
                    if fabs(x) > fabs(z):
                        h[i + 1, n] = (-r - w * t) / x
                    else:
                        h[i + 1, n] = (-s - y * t) / z
                t = fabs(h[i, n])
                if (machine_epsilon * t) * t > 1.0:
                    for j in range(i, n + 1):
                        h[j, n] /= t
        elif q < 0.0:
            l = n - 1
            if fabs(h[n, n - 1]) > fabs(h[n - 1, n]):
                h[n - 1, n - 1] = q / h[n, n - 1]
                h[n - 1, n] = -(h[n, n] - p) / h[n, n - 1]
            else:
                zero: T = 0.0
                h[n - 1, n - 1], h[n - 1, n] = _divide(zero, -h[n - 1, n], h[n - 1, n - 1] - p, q)
            h[n, n - 1] = 0.0
            h[n, n] = 1.0
            for i in range(n - 2, -1, -1):
                ra: T = 0.0
                sa: T = 0.0
                for j in range(l, n + 1):
                    ra += h[i, j] * h[j, n - 1]
                    sa += h[i, j] * h[j, n]
                w = h[i, i] - p
                if imaginary[i] < 0.0:
                    z = w
                    r = ra
                    s = sa
                    continue
                l = i
                if imaginary[i] == 0.0:
                    h[i, n - 1], h[i, n] = _divide(-ra, -sa, w, q)
                else:
                    x = h[i, i + 1]
                    y = h[i + 1, i]
                    vr = (real[i] - p) * (real[i] - p) + imaginary[i] * imaginary[i] - q * q
                    vi = (real[i] - p) * 2.0 * q
                    if vr == 0.0 and vi == 0.0:
                        vr = machine_epsilon * norm * (fabs(w) + fabs(q) + fabs(x) + fabs(y) + fabs(z))
                    h[i, n - 1], h[i, n] = _divide(x * r - z * ra + q * sa, x * s - z * sa - q * ra, vr, vi)
                    if fabs(x) > fabs(z) + fabs(q):
                        h[i + 1, n - 1] = (-ra - w * h[i, n - 1] + q * h[i, n]) / x
                        h[i + 1, n] = (-sa - w * h[i, n] - q * h[i, n - 1]) / x
                    else:
                        h[i + 1, n - 1], h[i + 1, n] = _divide(-r - y * h[i, n - 1], -s - y * h[i, n], z, q)
                t = max(fabs(h[i, n - 1]), fabs(h[i, n]))
                if (machine_epsilon * t) * t > 1.0:
                    for j in range(i, n + 1):
                        h[j, n - 1] /= t
                        h[j, n] /= t


def _divide[T: Float](a_real: T, a_imaginary: T, b_real: T, b_imaginary: T) -> tuple[T, T]:
    """The parts of the complex quotient `(a_real + a_imaginary i) / (b_real + b_imaginary i)` in
    `T`, by Smith's method in exactly the steps the compiler's complex `/` takes (CPython's
    `_Py_c_quot`), so the `f64` form of `eig` keeps the bits it had with `complex128` division.
    A zero `b` divides each part by `+0.0`, and a NaN in `b` gives NaN parts, as that `/` does.
    """
    real_size = fabs(b_real)
    imaginary_size = fabs(b_imaginary)
    if real_size >= imaginary_size:
        if real_size == 0.0:
            return a_real / real_size, a_imaginary / real_size
        ratio = b_imaginary / b_real
        denominator = b_real + b_imaginary * ratio
        return (a_real + a_imaginary * ratio) / denominator, (a_imaginary - a_real * ratio) / denominator
    if imaginary_size >= real_size:
        ratio = b_real / b_imaginary
        denominator = b_real * ratio + b_imaginary
        return (a_real * ratio + a_imaginary) / denominator, (a_imaginary * ratio - a_real) / denominator
    not_a_number = real_size - real_size + imaginary_size - imaginary_size
    return not_a_number, not_a_number
