"""Internal file of `linalg` (decision 0040): eigenvalues and eigenvectors of a general
matrix, `eig` and `eigvals`, by balancing, Hessenberg reduction and the shifted double QR
iteration (EISPACK's `balanc`, `orthes` and `hqr2`). `linalg` re-exports each (decision 0062); a
program cannot import this file.
"""

from math import fabs, hypot, isfinite, sqrt
from linalg_common import LinAlgError
from linalg_schur import schur


def eig(a: Array[f64, 2]) -> Raises[tuple[Array[complex128, 1], Array[complex128, 2]], LinAlgError]:
    """The eigenvalues `w` and right eigenvectors `v` of a square matrix `a`, as
    `numpy.linalg.eig(a)`: `a @ v[:, i]` is `w[i] * v[:, i]`. Each eigenvector has length 1 and
    its largest entry real, as LAPACK's `geev` returns them; complex eigenvalues come in conjugate
    pairs, the one with positive imaginary part first.

    Balancing by powers of two (EISPACK's `balanc`, without permutations), reduction to
    Hessenberg form (`orthes`), then the shifted double QR iteration with back-substitution for
    the eigenvectors (`hqr2`), as JAMA writes them: about 25n³ multiply-adds. The order of the
    eigenvalues is the algorithm's, which can differ from NumPy's. Raises
    `LinAlgError("Array must not contain infs or NaNs")` for such an entry, as NumPy does, and
    `LinAlgError("Eigenvalues did not converge")` after 100 iterations on one eigenvalue; panics
    when `a` is not square.
    """
    scale, v, real, imaginary = _eigen_parts(a)
    n = a.shape[0]
    values = Array.zeros(n, complex128)
    vectors = Array.zeros((n, n), complex128)
    for j in range(n):
        values[j] = complex(real[j], imaginary[j])
        for i in range(n):
            if imaginary[j] > 0.0:
                vectors[i, j] = complex(v[i, j], v[i, j + 1]) * scale[i]
            elif imaginary[j] < 0.0:
                vectors[i, j] = complex(v[i, j - 1], -v[i, j]) * scale[i]
            else:
                vectors[i, j] = complex(v[i, j] * scale[i], 0.0)
    for j in range(n):
        length = 0.0
        largest = 0
        for i in range(n):
            size = abs(vectors[i, j])
            length = hypot(length, size)
            if size > abs(vectors[largest, j]):
                largest = i
        if length == 0.0:
            continue
        turn = vectors[largest, j].conjugate() / abs(vectors[largest, j]) / length
        if imaginary[j] == 0.0:
            turn = complex(1.0 / length, 0.0)
        for i in range(n):
            vectors[i, j] = vectors[i, j] * turn
        if imaginary[j] != 0.0:
            vectors[largest, j] = complex(vectors[largest, j].real, 0.0)
    return values, vectors


def eig(a: Array[f32, 2]) -> Raises[tuple[Array[complex64, 1], Array[complex64, 2]], LinAlgError]:
    """`eig` of an `f32` matrix, worked in `f32`, giving `complex64` eigenvalues and eigenvectors
    as NumPy does for `float32`: the same algorithm and normalization as the `f64` form, which
    stops at `f32`'s machine epsilon.
    """
    scale, v, real, imaginary = _eigen_parts(a)
    n = a.shape[0]
    values = Array.zeros(n, complex64)
    vectors = Array.zeros((n, n), complex64)
    for j in range(n):
        values[j] = complex64(real[j], imaginary[j])
        for i in range(n):
            if imaginary[j] > 0.0:
                vectors[i, j] = complex64(v[i, j], v[i, j + 1]) * scale[i]
            elif imaginary[j] < 0.0:
                vectors[i, j] = complex64(v[i, j - 1], -v[i, j]) * scale[i]
            else:
                vectors[i, j] = complex64(v[i, j] * scale[i], 0.0)
    for j in range(n):
        length: f32 = 0.0
        largest = 0
        for i in range(n):
            size = abs(vectors[i, j])
            length = hypot(length, size)
            if size > abs(vectors[largest, j]):
                largest = i
        if length == 0.0:
            continue
        turn = vectors[largest, j].conjugate() / abs(vectors[largest, j]) / length
        if imaginary[j] == 0.0:
            turn = complex64(1.0 / length, 0.0)
        for i in range(n):
            vectors[i, j] = vectors[i, j] * turn
        if imaginary[j] != 0.0:
            vectors[largest, j] = complex64(vectors[largest, j].real, 0.0)
    return values, vectors


def eigvals(a: Array[f64, 2]) -> Raises[Array[complex128, 1], LinAlgError]:
    """The eigenvalues of a square matrix `a`, as `numpy.linalg.eigvals(a)`: the `w` of `eig(a)`,
    at the same cost.
    """
    w, _ = eig(a)
    return w


def eigvals(a: Array[f32, 2]) -> Raises[Array[complex64, 1], LinAlgError]:
    """`eigvals` of an `f32` matrix: the `complex64` `w` of `eig(a)`."""
    w, _ = eig(a)
    return w


def _eigen_parts[T: Float](
    a: Array[T, 2],
) -> Raises[tuple[Array[T, 1], Array[T, 2], Array[T, 1], Array[T, 1]], LinAlgError]:
    """The real work of `eig` in `a`'s float type: the balancing scale, then the eigenvector
    columns `v` and the eigenvalues' `real` and `imaginary` parts as `schur` leaves them, a
    complex pair's eigenvector being two columns of `v`. The overloads of `eig` turn these into
    complex arrays of their own width. Raises `LinAlgError` for an entry that is infinite or NaN
    and when the iteration does not converge; panics when `a` is not square.
    """
    n = a.shape[0]
    assert a.shape[1] == n, "eig needs a square matrix"
    for i in range(n):
        for j in range(n):
            if not isfinite(a[i, j]):
                raise LinAlgError("Array must not contain infs or NaNs")
    h = a.copy()
    scale = _balance(h)
    v = Array.zeros((n, n), T)
    real = Array.zeros(n, T)
    imaginary = Array.zeros(n, T)
    if n > 0:
        _hessenberg(h, v)
        schur(h, v, real, imaginary)
    return scale, v, real, imaginary


def _balance[T: Float](a: InOut[Array[T, 2]]) -> Array[T, 1]:
    """Scales the rows and columns of `a` by powers of two, `a = d⁻¹ a d`, until each row and its
    column have about the same size, and returns `d`'s diagonal: EISPACK's `balanc` without its
    permutations. Powers of two scale exactly, and a balanced matrix's eigenvalues come out
    accurate when its entries span many orders of magnitude.
    """
    n = a.shape[0]
    scale = Array.ones(n, T)
    unbalanced = True
    while unbalanced:
        unbalanced = False
        for i in range(n):
            column: T = 0.0
            row: T = 0.0
            for j in range(n):
                if j != i:
                    column += fabs(a[j, i])
                    row += fabs(a[i, j])
            if column == 0.0 or row == 0.0:
                continue
            total = column + row
            factor: T = 1.0
            while column < row / 2.0:
                factor *= 2.0
                column *= 4.0
            while column >= row * 2.0:
                factor /= 2.0
                column /= 4.0
            if (column + row) / factor < 0.95 * total:
                unbalanced = True
                scale[i] *= factor
                for j in range(n):
                    a[i, j] /= factor
                    a[j, i] *= factor
    return scale


def _hessenberg[T: Float](h: InOut[Array[T, 2]], v: InOut[Array[T, 2]]):
    """Reduces `h` to upper Hessenberg form by Householder reflections and sets `v` to the
    orthogonal matrix that does it: EISPACK's `orthes` and `ortran` as JAMA writes them.
    """
    n = h.shape[0]
    high = n - 1
    reflector = Array.zeros(n, T)
    for m in range(1, high):
        scale: T = 0.0
        for i in range(m, high + 1):
            scale += fabs(h[i, m - 1])
        if scale == 0.0:
            continue
        total: T = 0.0
        for i in range(high, m - 1, -1):
            reflector[i] = h[i, m - 1] / scale
            total += reflector[i] * reflector[i]
        g = sqrt(total)
        if reflector[m] > 0.0:
            g = -g
        total -= reflector[m] * g
        reflector[m] -= g
        for j in range(m, n):
            f: T = 0.0
            for i in range(high, m - 1, -1):
                f += reflector[i] * h[i, j]
            f /= total
            for i in range(m, high + 1):
                h[i, j] -= f * reflector[i]
        for i in range(high + 1):
            f = 0.0
            for j in range(high, m - 1, -1):
                f += reflector[j] * h[i, j]
            f /= total
            for j in range(m, high + 1):
                h[i, j] -= f * reflector[j]
        reflector[m] *= scale
        h[m, m - 1] = scale * g
    for i in range(n):
        for j in range(n):
            v[i, j] = 0.0
        v[i, i] = 1.0
    for m in range(high - 1, 0, -1):
        if h[m, m - 1] == 0.0:
            continue
        for i in range(m + 1, high + 1):
            reflector[i] = h[i, m - 1]
        for j in range(m, high + 1):
            g = 0.0
            for i in range(m, high + 1):
                g += reflector[i] * v[i, j]
            g = (g / reflector[m]) / h[m, m - 1]
            for i in range(m, high + 1):
                v[i, j] += g * reflector[i]
