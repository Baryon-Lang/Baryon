"""The gamma function and its relatives for `special` (roadmap 3.18.1): `gamma`, `rgamma`,
`gammasgn`, `gammaln`, `loggamma`, `psi`, `digamma` and `polygamma`, with `factorial` (roadmap
3.18.11), which `polygamma` uses.

The coefficients are Taylor coefficients of 1/Γ and Bernoulli numbers, computed with mpmath and
rounded to `f64`. The compiler reads this file for `<std>/special.byn`; a program cannot import
it.
"""

from math import exp, floor, inf, isinf, isnan, log, log1p, nan, pi, pow
from special_common import SQRT_TWO_PI, HALF_LOG_TWO_PI, LARGEST_GAMMA, is_integer, is_odd, sinpi
from special_common import cospi


_PSI_ROOT: Final = 1.4616321449683622  # the positive zero of `psi`, rounded to f64
_PSI_ROOT_LOW: Final = 9.549995429965697e-17  # the zero minus `_PSI_ROOT`


def _rgamma_minus_one(x: f64) -> f64:
    """1/Γ(x) − 1 for `x` from −0.5 to 2.5, by the Taylor series of 1/Γ around 1 or around 2.

    1/Γ is entire, so both series converge everywhere; within half a unit of the centre they
    reach full precision in about 22 terms. Returning the difference from 1 keeps the relative
    precision of `gammaln` near its zeros at 1 and 2, as `-log1p` of it.
    Below 0.5 the argument is read as `p` in 1/Γ(1 + p), which `gamma` uses for small `x`.
    """
    if x < 0.5:
        return rgamma_near_one(x)
    if x < 1.5:
        return rgamma_near_one(x - 1.0)
    return rgamma_near_two(x - 2.0)


def rgamma_near_one(p: f64) -> f64:
    """1/Γ(1 + p) − 1 for `p` from −0.5 to 0.5, by the Taylor series of 1/Γ around 1."""
    q = -2.0583260535665066e-14
    q = q * p + 5.100370287454476e-13
    q = q * p - 3.696805618642206e-12
    q = q * p + 7.782263439905071e-12
    q = q * p + 1.0434267116911005e-10
    q = q * p - 1.18127457048702e-09
    q = q * p + 5.002007644469223e-09
    q = q * p + 6.116095104481416e-09
    q = q * p - 2.056338416977607e-07
    q = q * p + 1.133027231981696e-06
    q = q * p - 1.2504934821426706e-06
    q = q * p - 2.013485478078824e-05
    q = q * p + 0.0001280502823881162
    q = q * p - 0.00021524167411495098
    q = q * p - 0.0011651675918590652
    q = q * p + 0.0072189432466631
    q = q * p - 0.009621971527876973
    q = q * p - 0.04219773455554433
    q = q * p + 0.16653861138229148
    q = q * p - 0.04200263503409524
    q = q * p - 0.6558780715202539
    q = q * p + 0.5772156649015329
    return p * q


def rgamma_near_two(p: f64) -> f64:
    """1/Γ(2 + p) − 1 for `p` from −0.5 to 0.5, by the Taylor series of 1/Γ around 2."""
    q = -1.3890705776659689e-14
    q = q * p + 5.239277345221073e-13
    q = q * p - 4.220733353164313e-12
    q = q * p + 1.2002996793069383e-11
    q = q * p + 9.233967437604067e-11
    q = q * p - 1.2736142448630608e-09
    q = q * p + 6.275621889332284e-09
    q = q * p - 1.5952678485086793e-10
    q = q * p - 2.0547431491290985e-07
    q = q * p + 1.3385015468946058e-06
    q = q * p - 2.5889950290372764e-06
    q = q * p - 1.7545859751750962e-05
    q = q * p + 0.00014559614213986716
    q = q * p - 0.0003608378162548181
    q = q * p - 0.000804329775604247
    q = q * p + 0.008023273022267347
    q = q * p - 0.01764524455014432
    q = q * p - 0.024552490005400017
    q = q * p + 0.1910911013876915
    q = q * p - 0.23309373642178674
    q = q * p - 0.42278433509846713
    return p * q


def stirling(x: f64) -> f64:
    """The remainder of Stirling's series for log Γ(x) at `x` from 10 up: the sum of
    B₂ₖ / (2k(2k − 1) x^(2k − 1)) for k from 1 to 10, below 1e-19 relative from 10 up."""
    w = 1.0 / (x * x)
    s = -1.3924322169059011
    s = s * w + 0.17964437236883057
    s = s * w - 0.029550653594771242
    s = s * w + 0.00641025641025641
    s = s * w - 0.0019175269175269176
    s = s * w + 0.0008417508417508417
    s = s * w - 0.0005952380952380953
    s = s * w + 0.0007936507936507937
    s = s * w - 0.002777777777777778
    s = s * w + 0.08333333333333333
    return s / x


def _gamma_large(x: f64) -> f64:
    """Γ(x) for `x` from 10 to the largest argument that does not overflow, by Stirling's
    formula √(2π) x^(x − 1/2) e^(−x) e^S(x).

    `x` is exact, so each of `pow` and `exp` adds about one rounding. The power is taken in two
    halves so that it does not overflow before `exp(-x)` scales it down.
    """
    half = pow(x, 0.5 * x - 0.25)
    return SQRT_TWO_PI * half * (exp(-x) * half) * exp(stirling(x))


def gamma(x: f64) -> f64:
    """The gamma function Γ(x), as `scipy.special.gamma`: (x − 1)! at whole numbers.

    Infinity at 0 with the sign of the zero, NaN at the negative whole numbers and at −∞, and
    infinity above about 171.62, where Γ overflows. Whole numbers up to 23 give the exact
    factorial. Accurate to a few ULP elsewhere. Below 0 the reflection formula
    Γ(x) = −π / (x sin(πx) Γ(−x)) is used, with Γ(−x) rather than Γ(1 − x) so that no argument
    is rounded; the result is 0 below about −171.

    ```python
    from special import gamma

    print(gamma(5.0))   # 24.0
    print(gamma(0.5))   # 1.772453850905516, the square root of π to within a ULP
    ```
    """
    if isnan(x) or x == -inf:
        return nan
    if x == inf:
        return inf
    if x == 0.0:
        return 1.0 / x
    if x < 0.0 and is_integer(x):
        return nan
    if abs(x) < 0.5:
        return 1.0 / (x * (1.0 + _rgamma_minus_one(x)))
    if x < 0.0:
        return -pi / (x * sinpi(x) * gamma(-x))
    if x < 2.5:
        return 1.0 / (1.0 + _rgamma_minus_one(x))
    if x > LARGEST_GAMMA:
        return inf
    if x < 10.0 or (x < 24.0 and is_integer(x)):
        steps = floor(x - 1.5)
        y = x - steps
        product = 1.0
        for k in range(steps):
            product *= y + k
        return product / (1.0 + _rgamma_minus_one(y))
    return _gamma_large(x)


def rgamma(x: f64) -> f64:
    """The reciprocal of the gamma function, 1/Γ(x), as `scipy.special.rgamma`.

    An entire function: 0 at 0 and at the negative whole numbers, with the sign of a zero
    argument, and 0 at ∞ and at −∞, as SciPy gives, though at −∞ it has no limit. It stays
    finite, and correct, where `gamma` overflows above 171.62, down to where it underflows near
    179.

    ```python
    from special import rgamma

    print(rgamma(4.0))  # 0.16666666666666666
    print(rgamma(-2.0)) # 0.0
    ```
    """
    if isnan(x):
        return nan
    if isinf(x):
        return 0.0
    if x <= 0.0 and is_integer(x):
        if x == 0.0:
            return x
        return 0.0
    if abs(x) < 0.5:
        return x * (1.0 + _rgamma_minus_one(x))
    if x < 0.0:
        return -x * sinpi(x) * gamma(-x) / pi
    if x < 2.5:
        return 1.0 + _rgamma_minus_one(x)
    if x < 10.0:
        return 1.0 / gamma(x)
    half = pow(x, 0.5 * x - 0.25)
    return exp(x) / half / half * exp(-stirling(x)) / SQRT_TWO_PI


def gammasgn(x: f64) -> f64:
    """The sign of the gamma function, as `scipy.special.gammasgn`: 1.0 or −1.0.

    1.0 above 0 and at +0.0, −1.0 at −0.0, NaN at the negative whole numbers, at −∞ and at NaN.
    Between −1 and 0 Γ is negative, between −2 and −1 positive, and so on.

    ```python
    from special import gammasgn

    print(gammasgn(-0.5))   # -1.0
    print(gammasgn(-1.5))   # 1.0
    ```
    """
    if isnan(x) or x == -inf:
        return nan
    if x == 0.0:
        if 1.0 / x < 0.0:
            return -1.0
        return 1.0
    if x > 0.0:
        return 1.0
    if is_integer(x):
        return nan
    if is_odd(float(floor(x))):
        return -1.0
    return 1.0


def gammaln(x: f64) -> f64:
    """The logarithm of the absolute value of the gamma function, log|Γ(x)|, as
    `scipy.special.gammaln`.

    Infinity at 0, at the negative whole numbers and at ∞, and −∞ at −∞ as SciPy gives, though
    log|Γ| has no limit there. Near the zeros at 1 and 2 the
    result keeps its relative precision. Below 0 the reflection formula is used, which loses
    relative precision near the zeros of log|Γ| between −3 and −2 and further left.

    ```python
    from special import gammaln

    print(gammaln(100.0))   # 359.1342053695754
    print(gammaln(1.0))     # 0.0
    ```
    """
    if isnan(x):
        return nan
    if isinf(x):
        return x
    if x <= 0.0 and is_integer(x):
        return inf
    if abs(x) < 0.5:
        return -log(abs(x)) - log1p(_rgamma_minus_one(x))
    if x < 0.0:
        return log(pi / abs(x * sinpi(x))) - gammaln(-x)
    if x < 2.5:
        # `0.0 -` rather than `-`, so the zeros at 1 and 2 are +0.0, as SciPy gives.
        return 0.0 - log1p(_rgamma_minus_one(x))
    if x < 10.0:
        steps = floor(x - 1.5)
        y = x - steps
        product = 1.0
        for k in range(steps):
            product *= y + k
        return log(product) - log1p(_rgamma_minus_one(y))
    logarithm = log(x)
    return x * (logarithm - 1.0) - 0.5 * logarithm + HALF_LOG_TWO_PI + stirling(x)


def loggamma(x: f64) -> f64:
    """The logarithm of the gamma function, as `scipy.special.loggamma` of a real argument:
    `gammaln(x)` from 0 up, and NaN below 0, where Γ can be negative and its logarithm is not
    real.

    Infinity at +0.0 and at −0.0, as SciPy gives. The complex `loggamma` is not built yet.

    ```python
    from special import loggamma

    print(loggamma(3.0))    # 0.6931471805599453, log 2
    print(loggamma(-0.5))   # nan
    ```
    """
    if x < 0.0:
        return nan
    return gammaln(x)


def _psi_near_root(x: f64) -> f64:
    """ψ(x) for `x` from 1 to 2, by its Taylor series around its zero x₀ ≈ 1.4616.

    The distance from the zero, d = x − x₀, is formed in two parts so that ψ(x) ≈ ψ′(x₀) d
    keeps its relative precision near x₀, where adding up terms of the recurrence would not.
    """
    d = (x - _PSI_ROOT) - _PSI_ROOT_LOW
    s = 2.549626552021554e-07
    s = s * d - 3.7266161283438227e-07
    s = s * d + 5.446941930669446e-07
    s = s * d - 7.96142543124197e-07
    s = s * d + 1.1636675363548843e-06
    s = s * d - 1.7008538854332607e-06
    s = s * d + 2.486022733129538e-06
    s = s * d - 3.6336507898010456e-06
    s = s * d + 5.3110609208898636e-06
    s = s * d - 7.762817668462094e-06
    s = s * d + 1.134638458466385e-05
    s = s * d - 1.6584242271854135e-05
    s = s * d + 2.424006611860132e-05
    s = s * d - 3.5430070947659604e-05
    s = s * d + 5.178575795222081e-05
    s = s * d - 7.569179582195066e-05
    s = s * d + 0.0001106337276874741
    s = s * d - 0.00016170622091974803
    s = s * d + 0.00023635601564027053
    s = s * d - 0.0003454680251063077
    s = s * d + 0.000504953265834602
    s = s * d - 0.0007380709389960052
    s = s * d + 0.0010788252019162967
    s = s * d - 0.0015769367714301972
    s = s * d + 0.002305126326734928
    s = s * d - 0.003369801655439328
    s = s * d + 0.004926781395729853
    s = s * d - 0.007204534386356869
    s = s * d + 0.010538791616612175
    s = s * d - 0.01542476590494896
    s = s * d + 0.022597648232218104
    s = s * d - 0.03316112647484736
    s = s * d + 0.04880428816414311
    s = s * d - 0.07219956125645471
    s = s * d + 0.10782405069126237
    s = s * d - 0.16394270544240652
    s = s * d + 0.258499760955651
    s = s * d - 0.4427631689835921
    s = s * d + 0.9676722454476212
    return s * d


def psi(x: f64) -> f64:
    """The digamma function ψ(x) = Γ′(x) / Γ(x), as `scipy.special.psi`.

    −∞ at −0.0 and ∞ at +0.0 as SciPy gives, NaN at the negative whole numbers and at −∞, and
    ∞ at ∞. Below 0 the reflection formula ψ(x) = ψ(−x) − 1/x − π / tan(πx) is used, with
    ψ(−x) rather than ψ(1 − x) so that no argument is rounded.

    ```python
    from special import psi

    print(psi(1.0))     # -0.5772156649015329, minus Euler's constant
    ```
    """
    if isnan(x) or x == -inf:
        return nan
    if x == inf:
        return inf
    if x == 0.0:
        return -1.0 / x
    if x < 0.0:
        if is_integer(x):
            return nan
        return psi(-x) - 1.0 / x - pi * cospi(x) / sinpi(x)
    if x < 1.0:
        return psi(x + 1.0) - 1.0 / x
    if x < 2.0:
        return _psi_near_root(x)
    if x < 10.0:
        steps = floor(x - 1.0)
        y = x - steps
        total = 0.0
        for k in range(steps):
            total += 1.0 / (y + k)
        return _psi_near_root(y) + total
    w = 1.0 / (x * x)
    s = -26.456212121212122
    s = s * w + 3.0539543302701198
    s = s * w - 0.4432598039215686
    s = s * w + 0.08333333333333333
    s = s * w - 0.021092796092796094
    s = s * w + 0.007575757575757576
    s = s * w - 0.004166666666666667
    s = s * w + 0.003968253968253968
    s = s * w - 0.008333333333333333
    s = s * w + 0.08333333333333333
    return log(x) - 0.5 / x - s * w


def digamma(x: f64) -> f64:
    """The digamma function, SciPy's other name for `psi`.

    ```python
    from special import digamma

    print(digamma(2.0))     # 0.42278433509846713
    ```
    """
    return psi(x)


def hurwitz_zeta(s: f64, q: f64) -> f64:
    """The Hurwitz zeta function ζ(s, q), the sum of (q + k)^(−s) over k from 0, for `s` from 0
    up other than 1, by the Euler–Maclaurin formula, which holds on both sides of the pole.

    Sums the first terms directly until q + k is at least 10 more than `s`, then adds the
    integral, half the next term and Bernoulli terms until they stop changing the sum. A `q` at
    0 or a negative whole number is a pole: infinity.
    """
    if q <= 0.0 and is_integer(q):
        return inf
    a = q
    total = 0.0
    while a < 10.0 + s:
        total += pow(a, -s)
        a += 1.0
    term = pow(a, -s)
    total += a * term / (s - 1.0) + 0.5 * term
    factor = s
    power = term / a
    weights = Array([
        0.08333333333333333,
        -0.001388888888888889,
        3.306878306878307e-05,
        -8.267195767195768e-07,
        2.08767569878681e-08,
        -5.284190138687493e-10,
        1.3382536530684679e-11,
        -3.3896802963225827e-13,
        8.586062056277845e-15,
        -2.174868698558062e-16,
        5.5090028283602295e-18,
        -1.3954464685812522e-19,
    ])
    for j in range(len(weights)):
        change = weights[j] * factor * power
        total += change
        if abs(change) <= 1.0e-17 * abs(total):
            break
        factor *= (s + 2.0 * j + 1.0) * (s + 2.0 * j + 2.0)
        power /= a * a
    return total


def polygamma(n: int, x: f64) -> f64:
    """The polygamma function ψ⁽ⁿ⁾(x), the `n`th derivative of `psi`, as
    `scipy.special.polygamma`: `psi(x)` for `n` 0, and (−1)ⁿ⁺¹ n! ζ(n + 1, x) above.

    NaN for a negative `n`. A pole at 0 and the negative whole numbers, infinite with the sign
    of (−1)ⁿ⁺¹; 0 at ∞.

    ```python
    from special import polygamma

    print(polygamma(1, 1.0))    # 1.6449340668482264, π²/6
    ```
    """
    if n < 0 or isnan(x):
        return nan
    if n == 0:
        return psi(x)
    if x == inf:
        return 0.0
    if x == -inf:
        return nan
    factorial = 1.0
    for k in range(2, n + 1):
        factorial *= k
    value = factorial * hurwitz_zeta(n + 1.0, x)
    if n % 2 == 0:
        return -value
    return value


def factorial(n: f64, exact: bool = False) -> f64:
    """n!, as `scipy.special.factorial`: Γ(n + 1), and 0 for a negative `n`. With `exact`, `n`
    is rounded down and the product formed in integer arithmetic, as in `comb`.

    ```python
    from special import factorial

    print(factorial(5))     # 120.0
    ```
    """
    if isnan(n):
        return nan
    if n < 0.0:
        return 0.0
    if not exact:
        return gamma(n + 1.0)
    count = 1
    for i in range(2, int(floor(n)) + 1):
        count = count * i
    return float(count)
