"""The names every module can use without an import that are written in Baryon (decision 0038).

The rest, such as `print`, `len` and `Exception`, are built into the compiler.
"""

from os import ErrorKind


class OSError(Exception):
    """The one error every operation on files, the environment and processes raises
    (decision 0036, part 2). Test `kind` to tell one failure from another.

    The runtime writes this error into memory field by field, so the fields' order is fixed.
    """

    kind: ErrorKind  # what went wrong, for a program to test
    errno: i32  # the operating system's error number, 0 when there is none
    strerror: str  # the operating system's message, such as "No such file or directory"
    filename: str  # the path involved, or "" when there is none


class EOFError(Exception):
    """The end of standard input, where `input` has no line left to give (decision 0036,
    part 6). It has no fields: there is nothing more to say about it.
    """


class ValueError(Exception):
    """A value of the right type whose content is wrong, such as text that is not a number:
    what `int(text)` and `float(text)` raise (decision 0037). `message` says what was wrong, in
    Python's words where Python has them.
    """

    message: str


class KeyError(Exception):
    """A key that is not there: what reading a missing keyword of a FITS `Header` raises, with
    AstroPy's message, such as `Keyword 'EXPTIME' not found.` (decision 0044). `message` says
    which key, and why.
    """

    message: str


class AttributeError(Exception):
    """An attribute that is not there: what reading a missing attribute of a NetCDF file or
    variable raises, with `netCDF4`'s message, `NetCDF: Attribute not found` (decision 0047),
    or one that does not hold the type the program reads. `message` says which, and why.
    """

    message: str
