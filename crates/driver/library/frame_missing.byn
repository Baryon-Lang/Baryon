"""Arrays with missing values, written in Baryon (decision 0045, part 3).

The compiler calls these functions; a program cannot import this file.

An `Array[T | None, 1]` is stored as two arrays, as Arrow stores a column that may hold
nulls: the values, an `Array[T, 1]`, and the validity bitmap, an `Array[u8, 1]` with one bit
for each element, eight to a byte, lowest bit first. Bit `at % 8` of byte `at // 8` is 1 when
element `at` is there and 0 when it is `None`. The value stored where an element is missing
is a filler that is never read as a value. The functions here take and give the two arrays,
and the compiler puts them together.

- `optional_parts` builds the two arrays from a list, for `Array(items)`.
- `optional_element` reads one element as a `T | None`, for `values[i]`.
- `missing` gives the mask `isna()` and `notna()` return, and `both` joins the masks of a
  frame's columns for `dropna()`.
- `masked_bits` and `taken_bits` rebuild the bitmap for the rows of a frame that a mask or
  positions choose.
- `valid_positions` splits row positions into those with a value and those without, for
  `sort_values`, which puts `None` last.
- `stacked` and `stacked_bits` put two columns end to end, for `concat`.
- `filled` gives the values with one value where an element is `None`, for `fillna(value)`.
- `present_count`, `present` and `present_extreme` count, gather and compare the elements
  that are there, for `count()`, `sum()`, `mean()`, `min()` and `max()`.
- `presence` and `present_rows` let `drop_duplicates` and `value_counts` compare rows whose
  columns may hold `None`.
- `present_starts`, `group_bits` and `group_present_integers` reduce a column that may hold
  `None` for `groupby`, each group by the values that are there.
- `optional_cells`, `optional_float_cells` and `optional_single_cells` give a column's cells
  for `print(df)`, with `<NA>` for a missing value, and `optional_shown` gives the text of
  an array alone, `[1.5 None 2.5]`.
- Text that may be `None` is stored as a text array with an empty text under each `None`.
  `text_optional_parts`, `text_optional_element`, `text_filled` and `text_present` do for
  it what the functions without `text_` do for numbers, `text_copied` copies one field of a
  row for `DataFrame(rows)`, and `gap_cells` puts `<NA>` in the cells of such a column.
"""

from math import isinf, isnan


def _valid(bits: Array[u8, 1], at: int) -> bool:
    """Whether element `at` is there: its bit in the validity bitmap `bits` is 1."""
    return ((bits[at // 8] >> u8(at % 8)) & u8(1)) == u8(1)


def optional_parts[T: Copy](
    items: list[T | None], filler: T
) -> tuple[Array[T, 1], Array[u8, 1]]:
    """The values and the validity bitmap of an array holding `items`. `filler` is stored
    where an item is `None`. Cost: one pass over `items` and two allocations, of the size of
    the values and of one bit for each."""
    count = len(items)
    values = Array.fill((count,), filler)
    bits = Array.fill(((count + 7) // 8,), u8(0))
    for at in range(count):
        item = items[at]
        if item is not None:
            values[at] = item
            bits[at // 8] = bits[at // 8] | (u8(1) << u8(at % 8))
    return (values, bits)


def optional_element[T: Copy](values: Array[T, 1], bits: Array[u8, 1], at: int) -> T | None:
    """Element `at` of the array stored as `values` and `bits`: the value, or `None` when
    its bit is 0. The compiler has checked that `at` is in range."""
    if _valid(bits, at):
        return values[at]
    return None


def _word(item: str | None) -> str:
    """A copy of the text `item`, or an empty text for `None`: what is stored for one item of
    a text array with missing values."""
    if item is not None:
        return item.copy()
    return ""


def text_copied(item: str | None) -> str | None:
    """A copy of `item` that the caller owns: `DataFrame(rows)` gathers a field of text that
    may be `None` from each row with it. Cost: one allocation, of the size of the text."""
    if item is not None:
        return item.copy()
    return None


def text_optional_parts(items: list[str | None]) -> tuple[Array[str, 1], Array[u8, 1]]:
    """`optional_parts` for text: the values, a text array with an empty text where an item
    is `None`, and the validity bitmap. Cost: one copy of each text in a list before the
    array is built from it, and the bitmap."""
    count = len(items)
    bits = Array.fill(((count + 7) // 8,), u8(0))
    at = 0
    for item in items:
        if item is not None:
            bits[at // 8] = bits[at // 8] | (u8(1) << u8(at % 8))
        at += 1
    return (Array([_word(item) for item in items]), bits)


def text_optional_element(values: Array[str, 1], bits: Array[u8, 1], at: int) -> str | None:
    """`optional_element` for text: a copy of element `at`, or `None` when its bit is 0.
    Cost: one allocation, of the size of the text."""
    if _valid(bits, at):
        return values[at].copy()
    return None


def text_filled(values: Array[str, 1], bits: Array[u8, 1], value: str) -> Array[str, 1]:
    """`filled` for text: a new text array with `value` where `bits` says `None`. Cost: one
    copy of each element in a list before the array is built from it."""
    return Array([
        values[at].copy() if _valid(bits, at) else value.copy() for at in range(len(values))
    ])


def text_present(values: Array[str, 1], bits: Array[u8, 1]) -> Array[str, 1]:
    """`present` for text: the elements whose bit in `bits` is 1, in order, as a new text
    array. Cost: as `text_filled`."""
    return Array([values[at].copy() for at in range(len(values)) if _valid(bits, at)])


def missing(bits: Array[u8, 1], count: int, wanted: bool) -> Array[bool, 1]:
    """For each of the `count` elements whose validity bitmap is `bits`, whether it is
    missing, when `wanted`, or there, when not: the masks of `isna()` and `notna()`. Cost:
    one pass and one array of `count` `bool`s."""
    return Array([_valid(bits, at) != wanted for at in range(count)])


def both(mask: Array[bool, 1], bits: Array[u8, 1]) -> Array[bool, 1]:
    """A new mask that is true where `mask` is and the validity bitmap `bits` has its bit set.

    `dropna()` of a frame joins the masks of its columns this way, so a row is kept when
    every column has a value in it.
    """
    return Array([mask[at] and _valid(bits, at) for at in range(len(mask))])


def filled[T: Copy](values: Array[T, 1], bits: Array[u8, 1], value: T) -> Array[T, 1]:
    """A copy of `values` with `value` where the validity bitmap `bits` says `None`."""
    result = values.copy()
    for at in range(len(values)):
        if not _valid(bits, at):
            result[at] = value
    return result


def presence(bits: Array[u8, 1], count: int) -> Array[i64, 1]:
    """For each of the `count` elements the validity bitmap `bits` covers, 1 when it is there
    and 0 when it is `None`: a key column that keeps rows with a `None` apart from rows with
    a value, for `drop_duplicates` and `value_counts`. Cost: one pass and the new array."""
    flags = Array.fill((count,), 0)
    for at in range(count):
        if _valid(bits, at):
            flags[at] = 1
    return flags


def present_rows(bits: Array[u8, 1], rows: Array[i64, 1]) -> Array[i64, 1]:
    """The positions of `rows` whose element is there by the validity bitmap `bits`, in the
    order of `rows`: `value_counts` counts no `None`. Cost: one pass over `rows`."""
    return Array([rows[at] for at in range(len(rows)) if _valid(bits, rows[at])])


def present_starts(
    bits: Array[u8, 1], order: Array[i64, 1], starts: Array[i64, 1]
) -> Array[i64, 1]:
    """Where each group of `groupby` starts once the rows of `order` whose element is `None`
    by `bits` are left out, which `present_rows` does: `starts` for the rows that stay. A
    group with no row left starts where the next one does. Cost: one pass over `order`."""
    groups = len(starts) - 1
    result = Array.fill((groups + 1,), 0)
    kept = 0
    for group in range(groups):
        result[group] = kept
        for at in range(starts[group], starts[group + 1]):
            if _valid(bits, order[at]):
                kept += 1
    result[groups] = kept
    return result


def group_bits(starts: Array[i64, 1]) -> Array[u8, 1]:
    """The validity bitmap of a column `agg` makes from a column that may hold `None`: bit
    `g` is 1 when group `g` of `starts` has a row, so a value to give, and 0 when it has
    none, so the group's `min`, `max`, `first` or `last` is `None`."""
    groups = len(starts) - 1
    bits = Array.fill(((groups + 7) // 8,), u8(0))
    for group in range(groups):
        if starts[group + 1] > starts[group]:
            bits[group // 8] = bits[group // 8] | (u8(1) << u8(group % 8))
    return bits


def group_present_integers(
    column: Array[i64, 1], order: Array[i64, 1], starts: Array[i64, 1], how: int
) -> Array[i64, 1]:
    """One integer for each group from the values of `column` in it, as the `group_integers`
    of `<std>/frames.byn` gives, for groups that may have no rows: 0 sum, 1 min, 2 max,
    3 first, 4 last, 5 count. A group with no rows has the sum and the count 0, and 0 stands
    under the `None` of the others. Cost: one pass over `order`."""
    groups = len(starts) - 1
    result = Array.fill((groups,), 0)
    for group in range(groups):
        low = starts[group]
        high = starts[group + 1]
        if how == 5:
            result[group] = high - low
        elif high > low:
            value = column[order[low]]
            if how == 4:
                value = column[order[high - 1]]
            for at in range(low + 1, high):
                other = column[order[at]]
                if how == 0:
                    value += other
                if how == 1:
                    value = min(value, other)
                if how == 2:
                    value = max(value, other)
            result[group] = value
    return result


def present_count(bits: Array[u8, 1], count: int) -> int:
    """How many of the `count` elements the validity bitmap `bits` covers are there."""
    there = 0
    for at in range(count):
        if _valid(bits, at):
            there += 1
    return there


def present[T: Copy](values: Array[T, 1], bits: Array[u8, 1]) -> Array[T, 1]:
    """The elements of `values` that are there, in order, as a new array.

    `sum()` and `mean()` add this array up as they add any array, so each gives exactly what
    it gives `values.dropna()`: a float sum adds in the pairwise order of every array's sum.
    Cost: a mask of a byte for each element, freed here, and a copy of the values kept.
    """
    return values[missing(bits, len(values), False)]


def present_extreme[T: Number](
    values: Array[T, 1], bits: Array[u8, 1], start: T, smallest: bool
) -> T:
    """The smallest element that is there, or the largest when `smallest` is false.

    A float NaN that is there is the answer, as it is for `min` and `max` of any array: it
    replaces the best so far, and nothing compares smaller or larger than a NaN to replace
    it. `start` is returned when no element is there; the compiler checks that one is before
    it calls this.
    """
    best = start
    found = False
    for at in range(len(values)):
        if _valid(bits, at):
            value = values[at]
            if not found or value != value:
                best = value
                found = True
            elif smallest and value < best:
                best = value
            elif not smallest and value > best:
                best = value
    return best


def taken_bits(bits: Array[u8, 1], positions: Array[i64, 1]) -> Array[u8, 1]:
    """The validity bitmap of the elements at `positions`, in that order: bit `at` of the
    result is the bit `bits` has for element `positions[at]`. The values are chosen by
    `taken`, so the two stay in step."""
    count = len(positions)
    result = Array.fill(((count + 7) // 8,), u8(0))
    for at in range(count):
        if _valid(bits, positions[at]):
            result[at // 8] = result[at // 8] | (u8(1) << u8(at % 8))
    return result


def masked_bits(bits: Array[u8, 1], mask: Array[bool, 1]) -> Array[u8, 1]:
    """The validity bitmap of the elements where `mask` is true, in order. The values are
    chosen by `masked`, so the two stay in step."""
    count = 0
    for chosen in mask:
        if chosen:
            count += 1
    result = Array.fill(((count + 7) // 8,), u8(0))
    to = 0
    for at in range(len(mask)):
        if mask[at]:
            if _valid(bits, at):
                result[to // 8] = result[to // 8] | (u8(1) << u8(to % 8))
            to += 1
    return result


def valid_positions(bits: Array[u8, 1], order: Array[i64, 1], wanted: bool) -> Array[i64, 1]:
    """The positions of `order`, in order, whose element is there, when `wanted`, or is
    `None`, when not, by the validity bitmap `bits`."""
    return Array([at for at in order if _valid(bits, at) == wanted])


def stacked[T: Copy](left: Array[T, 1], right: Array[T, 1], filler: T) -> Array[T, 1]:
    """The elements of `left`, then those of `right`, as a new array. `filler` is any value
    of the element type, which every element then replaces."""
    count = len(left)
    result = Array.fill((count + len(right),), filler)
    for at in range(count):
        result[at] = left[at]
    for at in range(len(right)):
        result[count + at] = right[at]
    return result


def stacked_bits(
    left: Array[u8, 1], left_count: int, right: Array[u8, 1], right_count: int
) -> Array[u8, 1]:
    """The validity bitmap of `left_count` elements with the bitmap `left`, then
    `right_count` elements with the bitmap `right`."""
    count = left_count + right_count
    result = Array.fill(((count + 7) // 8,), u8(0))
    for at in range(count):
        there = _valid(left, at) if at < left_count else _valid(right, at - left_count)
        if there:
            result[at // 8] = result[at // 8] | (u8(1) << u8(at % 8))
    return result


def _shown_row(cell: int, count: int) -> int:
    """The row that cell `cell` of a printed column of `count` rows shows: every row of 60
    rows or fewer, or else the first 5 and the last 5, as `<std>/frames.byn` chooses them."""
    if count <= 60 or cell < 5:
        return cell
    return count - 10 + cell


def _shown_count(count: int) -> int:
    """How many rows of a frame of `count` rows are printed: all of 60 or fewer, or else 10."""
    if count <= 60:
        return count
    return 10


def optional_cells[T: Copy](values: Array[T, 1], bits: Array[u8, 1]) -> list[str]:
    """The cells of a column of integers or of `bool` that may hold `None`: each value as
    `print` writes it, and `<NA>` for a missing one, as pandas shows its nullable columns.
    Cost: one text for each row that is printed, at most 60."""
    count = len(values)
    cells: list[str] = []
    for cell in range(_shown_count(count)):
        row = _shown_row(cell, count)
        if _valid(bits, row):
            text = f"{values[row]}"
            if text.startswith("-"):
                cells.append(text)
            else:
                cells.append(" " + text)
        else:
            cells.append(" <NA>")
    return cells


def gap_cells(cells: list[str], bits: Array[u8, 1], count: int) -> list[str]:
    """The cells of a column of `str` that may hold `None`: `cells`, the cells of its values
    for the rows that are printed of `count`, with `<NA>` where the validity bitmap `bits`
    says the row holds `None`. Cost: one copy of each cell, at most 60."""
    return [
        cells[cell].copy() if _valid(bits, _shown_row(cell, count)) else " <NA>"
        for cell in range(len(cells))
    ]


def _float_cell(value: f64) -> str:
    """One cell of a column of floats that may hold `None`: `value` with 6 decimals and the
    zeros it ends with removed, down to one decimal, so 1.5 is ` 1.5` and 2.0 is ` 2.0`.
    pandas formats each cell of a nullable column alone like this, where a plain column of
    floats shares one number of decimals."""
    if isnan(value):
        return " NaN"
    if isinf(value):
        if value > 0.0:
            return " inf"
        return "-inf"
    text = f"{value:.6f}"
    while text.endswith("0") and not text.endswith(".0"):
        text = text[:len(text) - 1]
    if text.startswith("-"):
        return text
    return " " + text


def optional_float_cells(values: Array[f64, 1], bits: Array[u8, 1]) -> list[str]:
    """The cells of an `f64` column that may hold `None`: `<NA>` for a missing value, and a
    real NaN as `NaN`. Cost: one text for each row that is printed, at most 60."""
    count = len(values)
    cells: list[str] = []
    for cell in range(_shown_count(count)):
        row = _shown_row(cell, count)
        if _valid(bits, row):
            cells.append(_float_cell(values[row]))
        else:
            cells.append(" <NA>")
    return cells


def optional_single_cells(values: Array[f32, 1], bits: Array[u8, 1]) -> list[str]:
    """The cells of an `f32` column that may hold `None`, formatted as the same values in
    `f64`. Cost: one text for each row that is printed, at most 60."""
    count = len(values)
    cells: list[str] = []
    for cell in range(_shown_count(count)):
        row = _shown_row(cell, count)
        if _valid(bits, row):
            cells.append(_float_cell(f64(values[row])))
        else:
            cells.append(" <NA>")
    return cells


def optional_shown[T: Copy](values: Array[T, 1], bits: Array[u8, 1]) -> str:
    """An array with missing values as `print` shows it, which is how NumPy shows an array of
    objects: each element as `print` writes it, `None` for a missing one, a space between
    two, the whole in brackets, so `[1.5 None 2.5]`. Of more than 1000 elements the first
    three and the last three are shown, with `...` between. Cost: one text for each element
    shown."""
    count = len(values)
    shown = [at for at in range(count)]
    if count > 1000:
        shown = [0, 1, 2, -1, count - 3, count - 2, count - 1]
    text = "["
    for position in range(len(shown)):
        at = shown[position]
        if position > 0:
            text = f"{text} "
        if at < 0:
            text = f"{text}..."
        elif _valid(bits, at):
            text = f"{text}{values[at]}"
        else:
            text = f"{text}None"
    return f"{text}]"
