"""The `artist` library file: the things an axes holds and where they land on the page, as
matplotlib's `Artist` classes and its data-to-display transform (decision 0046).

It is internal to the standard library: `byplot` and the files under it import it, and a
program cannot, so a program's own `artist.byn` is never hidden by it.

`byplot`'s `Axes` keeps one `Artist` for each line, set of markers, set of bars, set of error
bars or filled area, one `Image` for each image and one `Text` for each piece of text; when a
figure is drawn, a `View` maps data to points on the page, and the `legend` module reads the
artists to draw a legend.
"""

from math import isfinite, log10, nan


class Kind(Enum):
    """What an `Artist` draws."""

    LINE = 0  # a line through the points, with or without markers, from `plot`
    MARKERS = 1  # a marker at each point, from `scatter`
    BARS = 2  # a bar for each point, from `bar` and `hist`
    ERRORS = 3  # error bars, from `errorbar`: segments from point to point, NaN between them
    FILL = 4  # filled polygons through the points, NaN between them, from `fill_between`
    CONTOUR = 5  # the lines of one contour level, NaN between them, from `contour`
    FILLED = 6  # the polygons of one band between two levels, from `contourf`


class Artist(Struct):
    """One thing drawn on an axes, in data coordinates: a line, a set of markers, a set of
    bars, a set of error bars or a filled area, as matplotlib's `Line2D`, `PathCollection`,
    `BarContainer`, `LineCollection` and `FillBetweenPolyCollection` are. `byplot` makes them.

    Error bars are segments of two points each, with a NaN point between segments; their
    `marker` is the cap at each end of a segment, `"_"` or `"|"`, `markersize` across, or no
    cap when that is 0. The `LINE` drawn right after them carries their legend label, so the
    legend shows both together, as matplotlib's `ErrorbarContainer` does.
    """

    kind: Kind  # what is drawn
    x: Array[f64, 1]  # the x of each point, or the left edge of each bar
    y: Array[f64, 1]  # the y of each point, or the top of each bar, whose base is 0
    widths: Array[f64, 1]  # each bar's width; a contour's grid box, x0, x1, y0, y1; else empty
    color: str  # an SVG color, `#rrggbb`
    linewidth: f64  # a line's width in points; 0 for no line
    dashes: list[f64]  # a line's on and off lengths in points; empty for a solid line
    marker: str  # the marker at each point, as `backend_svg` names them; "" for none
    markersize: f64  # a marker's size across, in points
    label: str  # the legend's text; "" keeps the artist out of the legend
    alpha: f64  # the opacity a filled area is drawn with, from 0 to 1; 1 for the others


class Image(Struct):
    """An image on an axes, as matplotlib's `AxesImage`: the values of `data`, colored by the
    colormap `cmap` from `vmin` to `vmax`, stretched over the rectangle `extent` gives as its
    left, right, bottom and top in data coordinates, column 0 at the left and row 0 at the top
    when `upper` is set, as matplotlib's `origin="upper"` puts it, or at the bottom. imshow's
    default extent centres cell `(i, j)` on x = `j` and y = `i`.
    """

    data: Array[f64, 2]  # the values, rows by columns
    cmap: str  # the colormap's name, as `cm.get_cmap` takes it
    vmin: f64  # the value drawn in the colormap's first color
    vmax: f64  # the value drawn in its last color
    extent: tuple[f64, f64, f64, f64]  # left, right, bottom and top, in data coordinates
    upper: bool  # row 0 at the top edge, matplotlib's default `origin="upper"`; else the bottom


class Text(Struct):
    """A piece of text on an axes, as matplotlib's `Text`: `text` written `size` points tall at
    the data point `(x, y)`, aligned to it by `ha` and `va` as `byplot`'s `Axes.text` says. It is
    not clipped to the axes and does not change the range shown, as matplotlib's is not and does
    not."""

    x: f64  # where it is anchored, in data coordinates
    y: f64  # where it is anchored, in data coordinates
    text: str  # what it says
    size: f64  # its font size, in points
    ha: str  # `"left"`, `"center"` or `"right"`: which of its sides is at `x`
    va: str  # `"baseline"`, `"bottom"`, `"center"` or `"top"`: what is at `y`


class View(Struct):
    """Where an axes sits on the page and what it shows: the box from `left` to `right` and
    `top` to `bottom`, in points from the page's top left corner, showing x from `x0` to `x1`
    and y from `y0` to `y1`, as matplotlib's `transData` maps them. `x0` larger than `x1`, or
    `y0` larger than `y1`, turns that axis around. With `log_x` or `log_y` set, that axis is
    laid out by the logarithm of the value, as matplotlib's `"log"` scale lays it; a value at
    or below 0 then maps to no point, so a line breaks there.
    """

    left: f64  # the box's left edge, in points
    top: f64  # its top edge, in points
    right: f64  # its right edge, in points
    bottom: f64  # its bottom edge, in points
    x0: f64  # the x shown at the left edge
    x1: f64  # the x shown at the right edge
    y0: f64  # the y shown at the bottom edge
    y1: f64  # the y shown at the top edge
    log_x: bool  # whether x is laid out by its logarithm
    log_y: bool  # whether y is laid out by its logarithm

    def to_x(self: Self, x: Array[f64, 1]) -> Array[f64, 1]:
        """Where the data `x` fall across the page, in points."""
        if self.log_x:
            low = log10(self.x0)
            scale = (self.right - self.left) / (log10(self.x1) - low)
            return self.left + (_log10(x) - low) * scale
        return self.left + (x - self.x0) * ((self.right - self.left) / (self.x1 - self.x0))

    def to_y(self: Self, y: Array[f64, 1]) -> Array[f64, 1]:
        """Where the data `y` fall down the page, in points."""
        if self.log_y:
            low = log10(self.y0)
            scale = (self.bottom - self.top) / (log10(self.y1) - low)
            return self.bottom - (_log10(y) - low) * scale
        return self.bottom - (y - self.y0) * ((self.bottom - self.top) / (self.y1 - self.y0))


def _log10(values: Array[f64, 1]) -> Array[f64, 1]:
    """The base-10 logarithm of each of `values`, NaN for one at or below 0, as matplotlib masks
    such values on a logarithmic axis. Costs one logarithm a value."""
    logs = Array.zeros(len(values))
    for i in range(len(values)):
        logs[i] = log10(values[i]) if values[i] > 0.0 else 0.0 / 0.0
    return logs


def dashes(style: str, linewidth: f64) -> list[f64]:
    """The on and off lengths, in points, of a matplotlib line style: its pattern for a line
    one point wide, scaled by `linewidth`. Empty for a solid line. Panics on an unknown style."""
    pattern: list[f64] = []
    if style == "--" or style == "dashed":
        pattern = [3.7, 1.6]
    elif style == ":" or style == "dotted":
        pattern = [1.0, 1.65]
    elif style == "-." or style == "dashdot":
        pattern = [6.4, 1.6, 1.0, 1.6]
    else:
        known = style == "-" or style == "solid"
        assert known, f"{style!r} is not a line style: use '-', '--', ':', '-.' or ''"
    return [length * linewidth for length in pattern]


def error_bars(
    x: Array[f64, 1], y: Array[f64, 1], error: Array[f64, 1], across: bool, color: str, capsize: f64
) -> Artist:
    """`byplot.errorbar`'s bars of `error` about each point `(x[i], y[i])`, across in x when
    `across` is set and up and down in y otherwise, in `color`, with caps `capsize` points long
    on each side, as matplotlib's `errorbar` draws them: three points a bar, the low end, the
    high end and a NaN to lift the pen. Panics when `error` and `x` differ in length."""
    assert len(error) == len(x), "errorbar needs an error for each point"
    ends_x = Array.fill(3 * len(x), nan)
    ends_y = Array.fill(3 * len(x), nan)
    for i in range(len(x)):
        ends_x[3 * i] = x[i] - error[i] if across else x[i]
        ends_x[3 * i + 1] = x[i] + error[i] if across else x[i]
        ends_y[3 * i] = y[i] if across else y[i] - error[i]
        ends_y[3 * i + 1] = y[i] if across else y[i] + error[i]
    cap = "|" if across else "_"
    hue = color.copy()
    size = 2.0 * capsize
    return Artist(Kind.ERRORS, ends_x, ends_y, Array.zeros(0), hue, 1.5, [], cap, size, "", 1.0)


def filled(
    x: Array[f64, 1], y1: Array[f64, 1], y2: Array[f64, 1], color: str, alpha: f64
) -> Artist:
    """`byplot.fill_between`'s area between the curves `(x[i], y1[i])` and `(x[i], y2[i])`, in
    `color` at opacity `alpha`: a polygon along `y1` and back along `y2` for each run of points
    whose values are all finite, with a NaN point after each, so a NaN or infinite value splits
    the area there, as matplotlib splits it. Costs one pass over the points."""
    outline_x: list[f64] = []
    outline_y: list[f64] = []
    start = 0
    for i in range(len(x) + 1):
        end = i == len(x)
        if not end:
            end = not (isfinite(x[i]) and isfinite(y1[i]) and isfinite(y2[i]))
        if end:
            for k in range(start, i):
                outline_x.append(x[k])
                outline_y.append(y1[k])
            for k in range(i - 1, start - 1, -1):
                outline_x.append(x[k])
                outline_y.append(y2[k])
            outline_x.append(nan)
            outline_y.append(nan)
            start = i + 1
    across = Array(outline_x)
    up = Array(outline_y)
    hue = color.copy()
    return Artist(Kind.FILL, across, up, Array.zeros(0), hue, 0.0, [], "", 0.0, "", alpha)
