"""The `artist` module: the things an axes holds and where they land on the page, as
matplotlib's `Artist` classes and its data-to-display transform (decision 0046).

`pyplot`'s `Axes` keeps one `Artist` for each line, set of markers or set of bars, and one
`Image` for each image; when a figure is drawn, a `View` maps data to points on the page, and
the `legend` module reads the artists to draw a legend.
"""


class Kind(Enum):
    """What an `Artist` draws."""

    LINE = 0  # a line through the points, with or without markers, from `plot`
    MARKERS = 1  # a marker at each point, from `scatter`
    BARS = 2  # a bar for each point, from `bar` and `hist`


class Artist(Struct):
    """One thing drawn on an axes, in data coordinates: a line, a set of markers or a set of
    bars, as matplotlib's `Line2D`, `PathCollection` and `BarContainer` are. `pyplot` makes
    them; a program reads them only to draw something of its own.

    ```python
    from artist import Artist, Kind

    def main():
        x = Array([0.0, 1.0])
        line = Artist(Kind.LINE, x, x.copy(), Array.zeros(0), "#1f77b4", 1.5, [], "", 6.0, "rising")
        print(line.label)  # rising
    ```
    """

    kind: Kind  # what is drawn
    x: Array[f64, 1]  # the x of each point, or the left edge of each bar
    y: Array[f64, 1]  # the y of each point, or the top of each bar, whose base is 0
    widths: Array[f64, 1]  # each bar's width; empty for lines and markers
    color: str  # an SVG color, `#rrggbb`
    linewidth: f64  # a line's width in points; 0 for no line
    dashes: list[f64]  # a line's on and off lengths in points; empty for a solid line
    marker: str  # the marker at each point, as `backend_svg` names them; "" for none
    markersize: f64  # a marker's size across, in points
    label: str  # the legend's text; "" keeps the artist out of the legend


class Image(Struct):
    """An image on an axes, as matplotlib's `AxesImage`: the values of `data`, colored by the
    colormap `cmap` from `vmin` to `vmax`, stretched over the rectangle `extent` gives as its
    left, right, bottom and top in data coordinates, column 0 at the left and row 0 at the top
    when `upper` is set, as matplotlib's `origin="upper"` puts it, or at the bottom. imshow's
    default extent centres cell `(i, j)` on x = `j` and y = `i`.

    ```python
    from artist import Image

    def main():
        image = Image(Array.zeros((2, 3)), "viridis", 0.0, 1.0, (-0.5, 2.5, 1.5, -0.5), True)
        print(image.data.shape)  # (2, 3)
    ```
    """

    data: Array[f64, 2]  # the values, rows by columns
    cmap: str  # the colormap's name, as `cm.get_cmap` takes it
    vmin: f64  # the value drawn in the colormap's first color
    vmax: f64  # the value drawn in its last color
    extent: tuple[f64, f64, f64, f64]  # left, right, bottom and top, in data coordinates
    upper: bool  # row 0 at the top edge, matplotlib's default `origin="upper"`; else the bottom


class View(Struct):
    """Where an axes sits on the page and what it shows: the box from `left` to `right` and
    `top` to `bottom`, in points from the page's top left corner, showing x from `x0` to `x1`
    and y from `y0` to `y1`, as matplotlib's `transData` maps them. `x0` larger than `x1`, or
    `y0` larger than `y1`, turns that axis around.

    ```python
    from artist import View

    def main():
        view = View(50.0, 10.0, 150.0, 110.0, 0.0, 10.0, 0.0, 1.0)
        print(view.to_x(Array([5.0])), view.to_y(Array([1.0])))  # [100.] [10.]
    ```
    """

    left: f64  # the box's left edge, in points
    top: f64  # its top edge, in points
    right: f64  # its right edge, in points
    bottom: f64  # its bottom edge, in points
    x0: f64  # the x shown at the left edge
    x1: f64  # the x shown at the right edge
    y0: f64  # the y shown at the bottom edge
    y1: f64  # the y shown at the top edge

    def to_x(self: Self, x: Array[f64, 1]) -> Array[f64, 1]:
        """Where the data `x` fall across the page, in points."""
        return self.left + (x - self.x0) * ((self.right - self.left) / (self.x1 - self.x0))

    def to_y(self: Self, y: Array[f64, 1]) -> Array[f64, 1]:
        """Where the data `y` fall down the page, in points."""
        return self.bottom - (y - self.y0) * ((self.bottom - self.top) / (self.y1 - self.y0))
