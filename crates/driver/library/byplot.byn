"""The `byplot` module: plots with matplotlib's object-oriented names, drawn by Baryon code to SVG
(decision 0046).

Make an `Axes` with `axes()`, draw on it with its methods, and write it with `savefig`, or
make a grid of them with `subplots(nrows, ncols)` and write the whole `Figure`:

```python
import byplot as plt

def main() -> Raises[None, OSError | ValueError]:
    t = Array([0.0, 1.0, 2.0, 3.0])
    ax = plt.axes()
    ax.plot(t, t * t, label="t squared")
    ax.set_xlabel("time (s)")
    ax.savefig("square.svg")
```

A figure looks as matplotlib's default style draws it: 6.4 by 4.8 inches, DejaVu Sans at 10
points, colors from the `tab10` cycle, and ticks placed and labelled by `ticker`'s
`MaxNLocator` and `ScalarFormatter`, as matplotlib's are.
"""

from artist import Artist, Image, Kind, Text, dashes, error_bars, filled
from backend_svg import RendererSVG
from cm import get_cmap
from colors import to_hex
from figure import Figure, check_format, draw_axes, subplot_box
from legend import location_code
from math import inf, isfinite
from transforms import fixed_limits
from stats import histogram

WIDTH: Final = 460.8  # the figure's width in points: 6.4 inches
HEIGHT: Final = 345.6  # the figure's height in points: 4.8 inches


class Axes(Struct):
    """A plot: the data drawn in a rectangle, with an axis below it and one to its left, as
    matplotlib's `Axes`.

    Make one with `axes()`. Each method that draws or labels changes the axes in place, so a
    plot is built up call by call and written once with `savefig`. The x and y ranges follow
    the data, with a margin of 5% on each side, until `set_xlim` or `set_ylim` fixes them.
    """

    artists: list[Artist]  # every line, set of markers and set of bars, in the order drawn
    title: str  # above the axes; "" for none
    xlabel: str  # under the x axis; "" for none
    ylabel: str  # left of the y axis; "" for none
    xlim: tuple[f64, f64] | None  # the x range shown when fixed, `None` to follow the data
    ylim: tuple[f64, f64] | None  # the y range shown when fixed, `None` to follow the data
    line_colors: int  # how many colors of the cycle `plot` has taken
    patch_colors: int  # how many `scatter`, `bar` and `hist` have taken, from their own cycle
    legend_loc: str  # where the legend goes, as `legend`'s `loc`; "" for no legend
    images: list[Image]  # every image, in the order drawn
    texts: list[Text]  # every piece of text, in the order written
    colorbar_label: str  # the colorbar's label; "" for none
    grid_on: bool  # whether grid lines are drawn at the ticks
    aspect_equal: bool  # whether a unit of x and of y are the same length, as for images
    colorbar_on: bool  # whether a colorbar of the last image is drawn beside the axes
    xlog: bool  # whether the x axis is logarithmic, as `set_xscale("log")` makes it
    ylog: bool  # whether the y axis is logarithmic

    def plot(
        self: InOut[Self],
        x: Array[f64, 1],
        y: Array[f64, 1],
        color: str = "",
        linewidth: f64 = 1.5,
        linestyle: str = "-",
        marker: str = "",
        markersize: f64 = 6.0,
        label: str = "",
    ) -> None:
        """Draws the points `(x[i], y[i])` joined by straight lines, as matplotlib's `plot`.

        `color` is a name `colors.to_hex` knows: `"#rrggbb"`, `"C0"` to `"C9"`, one of the
        letters `"bgrcmykw"`, or a `tab10` name such as `"tab:orange"`; left out, or `""`, each
        line takes the next color of the cycle. `linestyle` is `"-"`, `"--"`, `":"` or
        `"-."`, or their names `"solid"`, `"dashed"`, `"dotted"` and `"dashdot"`, with dashes
        that grow with `linewidth` as matplotlib's do, or `""` or `"None"` for no line.
        `marker` puts a marker `markersize` points across at each point: `"o"`, `"."`, `"s"`,
        `"^"`, `"v"`, `"D"`, `"+"`, `"x"`, `"_"` or `"|"`. A point with a NaN or infinite
        coordinate breaks the line there. Copies `x` and `y`, so they can change afterwards.

        Panics when `x` and `y` differ in length, or `color` or `linestyle` is not one of
        those, and `savefig` panics on a `marker` that is not, where matplotlib raises
        `ValueError`: a mistake in the program, not its data.
        """
        assert len(x) == len(y), "plot needs x and y of the same length"
        width = 0.0 if linestyle == "" or linestyle == "None" else linewidth
        pattern: list[f64] = []
        if width > 0.0:
            pattern = dashes(linestyle, linewidth)
        self.artists.append(
            Artist(
                Kind.LINE,
                x.copy(),
                y.copy(),
                Array.zeros(0),
                self._color(color, True),
                width,
                pattern,
                marker.copy(),
                markersize,
                label.copy(),
                1.0,
            )
        )

    def scatter(
        self: InOut[Self],
        x: Array[f64, 1],
        y: Array[f64, 1],
        s: f64 = 36.0,
        color: str = "",
        marker: str = "o",
        label: str = "",
    ) -> None:
        """Draws a marker at each point `(x[i], y[i])`, as matplotlib's `scatter`: `s` is the
        marker's area in points squared, so `s=36.0` is 6 points across, and `color` and
        `marker` are `plot`'s. Copies `x` and `y`. Panics as `plot` does."""
        assert len(x) == len(y), "scatter needs x and y of the same length"
        self.artists.append(
            Artist(
                Kind.MARKERS,
                x.copy(),
                y.copy(),
                Array.zeros(0),
                self._color(color, False),
                0.0,
                [],
                marker.copy(),
                s**0.5,
                label.copy(),
                1.0,
            )
        )

    def bar(
        self: InOut[Self],
        x: Array[f64, 1],
        height: Array[f64, 1],
        width: f64 = 0.8,
        color: str = "",
        label: str = "",
    ) -> None:
        """Draws a bar from 0 to `height[i]` centred on each `x[i]`, `width` wide, as
        matplotlib's `bar`; a negative height hangs below 0. Copies its arguments. Panics when
        `x` and `height` differ in length, or `color` is not a color."""
        assert len(x) == len(height), "bar needs x and height of the same length"
        self.artists.append(
            Artist(
                Kind.BARS,
                x - 0.5 * width,
                height.copy(),
                Array.fill(len(x), width),
                self._color(color, False),
                0.0,
                [],
                "",
                0.0,
                label.copy(),
                1.0,
            )
        )

    def hist(
        self: InOut[Self], x: Array[f64, 1], bins: int = 10, color: str = "", label: str = ""
    ) -> tuple[Array[f64, 1], Array[f64, 1]]:
        """Draws the histogram of `x` in `bins` equal bins from its smallest to its largest
        element, as matplotlib's `hist`, and returns the counts and the `bins + 1` edges, which
        `stats.histogram` computes with NumPy's bits. matplotlib returns its bars too, as a
        third value; here they stay in the axes. Panics as `stats.histogram` does, on fewer than
        one bin or a NaN or infinite element."""
        counts, edges = histogram(x, bins)
        heights = Array.zeros(bins)
        widths = Array.zeros(bins)
        for k in range(bins):
            heights[k] = f64(counts[k])
            widths[k] = edges[k + 1] - edges[k]
        self.artists.append(
            Artist(
                Kind.BARS,
                edges[0:bins].copy(),
                heights.copy(),
                widths,
                self._color(color, False),
                0.0,
                [],
                "",
                0.0,
                label.copy(),
                1.0,
            )
        )
        return (heights, edges)

    def errorbar(
        self: InOut[Self],
        x: Array[f64, 1],
        y: Array[f64, 1],
        yerr: Array[f64, 1] = Array.zeros(0),
        xerr: Array[f64, 1] = Array.zeros(0),
        fmt: str = "",
        color: str = "",
        capsize: f64 = 0.0,
        label: str = "",
    ) -> None:
        """Draws the points `(x[i], y[i])` with an error bar from `y[i] - yerr[i]` to
        `y[i] + yerr[i]` and one from `x[i] - xerr[i]` to `x[i] + xerr[i]`, as matplotlib's
        `errorbar` does with errors of the same length as the data. `fmt` draws the points:
        `""` or `"-"` joins them with a line, one of `plot`'s markers such as `"o"` marks each
        one, the marker then `"-"`, `"o-"`, does both, and `"none"` draws only the bars.
        `capsize` puts a cap that many points long, on each side, across both ends of each bar.
        The bars, caps and points take one color, `color` or the next of the lines' cycle, and
        the legend shows them together. An error left out, or empty, draws no bars, where
        matplotlib takes `None`. Copies its arguments.

        Panics when the lengths differ, or on a `fmt` or `color` that is not one of those.
        """
        assert len(x) == len(y), "errorbar needs x and y of the same length"
        line = fmt == "" or fmt.endswith("-")
        known = fmt == "none" or len(fmt) == 1 or (len(fmt) == 2 and line)
        assert known, f"{fmt!r} is not a format: use '', '-', 'none', a marker or 'o-'"
        hue = self._color(color, True)
        if len(xerr) > 0:
            self.artists.append(error_bars(x, y, xerr, True, hue, capsize))
        if len(yerr) > 0:
            self.artists.append(error_bars(x, y, yerr, False, hue, capsize))
        marker = ""
        if fmt != "" and fmt != "-" and fmt != "none":
            marker = fmt[0:1]
        width = 1.5 if line else 0.0
        points = Artist(
            Kind.LINE, x.copy(), y.copy(), Array.zeros(0), hue, width, [], marker, 6.0, "", 1.0
        )
        points.label = label.copy()
        self.artists.append(points)

    def fill_between(
        self: InOut[Self],
        x: Array[f64, 1],
        y1: Array[f64, 1],
        y2: Array[f64, 1] = Array.zeros(0),
        color: str = "",
        alpha: f64 = 1.0,
        label: str = "",
    ) -> None:
        """Fills the area between the curves `(x[i], y1[i])` and `(x[i], y2[i])`, or down to 0
        when `y2` is left out or empty, as matplotlib's `fill_between`, in `color` or the next
        color of the cycle `bar` takes from, at opacity `alpha` from 0 to 1. A point with a NaN
        or infinite value splits the area in two there. Panics when the lengths differ, on a
        `color` that is not a color, or an `alpha` outside 0 to 1, where matplotlib raises
        `ValueError`."""
        base = Array.zeros(len(x))
        if len(y2) > 0:
            base = y2.copy()
        same = len(x) == len(y1) and len(x) == len(base)
        assert same, "fill_between needs x, y1 and y2 of the same length"
        assert 0.0 <= alpha and alpha <= 1.0, f"alpha ({alpha}) is outside 0-1 range"
        area = filled(x, y1, base, self._color(color, False), alpha)
        area.label = label.copy()
        self.artists.append(area)

    def text(
        self: InOut[Self],
        x: f64,
        y: f64,
        s: str,
        fontsize: f64 = 10.0,
        ha: str = "left",
        va: str = "baseline",
    ) -> None:
        """Writes `s` at the data point `(x, y)`, `fontsize` points tall, as matplotlib's `text`:
        `ha` puts its `"left"`, `"center"` or `"right"` side at `x`, and `va` puts its
        `"baseline"`, `"bottom"`, `"center"` or `"top"` at `y`. The text is not clipped to the
        axes and leaves the range shown alone. Panics on any other `ha` or `va`."""
        across = ha == "left" or ha == "center" or ha == "right"
        assert across, f"{ha!r} is not a horizontal alignment: use 'left', 'center' or 'right'"
        up = va == "baseline" or va == "bottom" or va == "center" or va == "top"
        assert up, f"{va!r} is not a vertical alignment: 'baseline', 'bottom', 'center' or 'top'"
        self.texts.append(Text(x, y, s.copy(), fontsize, ha.copy(), va.copy()))

    def imshow(
        self: InOut[Self],
        X: Array[f64, 2],
        cmap: str = "viridis",
        vmin: f64 | None = None,
        vmax: f64 | None = None,
        origin: str = "upper",
        aspect: str = "equal",
        extent: tuple[f64, f64, f64, f64] | None = None,
    ) -> None:
        """Draws `X` as an image, as matplotlib's `imshow`: element `X[i, j]` is a cell centred
        on x = `j` and y = `i`, colored by the colormap `cmap`, a name `cm.get_cmap` knows,
        from `vmin` to `vmax`, which default to the smallest and largest finite element. A NaN
        element is left transparent. `origin="upper"` puts row 0 at the top, as matplotlib
        does, and `"lower"` at the bottom. `extent=(left, right, bottom, top)` stretches the
        image over that rectangle of data coordinates instead. `aspect="equal"` keeps a unit of
        x and of y the same length by narrowing the axes, and `"auto"` lets the image fill the
        axes. Copies `X`.

        Panics on an unknown `cmap`, `origin` or `aspect`, where matplotlib raises
        `ValueError`.
        """
        assert origin == "upper" or origin == "lower", "imshow's origin is 'upper' or 'lower'"
        assert aspect == "equal" or aspect == "auto", "imshow's aspect is 'equal' or 'auto'"
        get_cmap(cmap)
        low = inf
        high = -inf
        for i in range(X.shape[0]):
            for j in range(X.shape[1]):
                if isfinite(X[i, j]):
                    low = min(low, X[i, j])
                    high = max(high, X[i, j])
        if low > high:
            low = 0.0
            high = 1.0
        bottom = low if vmin is None else vmin
        top = high if vmax is None else vmax
        upper = origin == "upper"
        right = f64(X.shape[1]) - 0.5
        down = f64(X.shape[0]) - 0.5
        edges = (-0.5, right, down, -0.5) if upper else (-0.5, right, -0.5, down)
        if extent is not None:
            edges = extent
        self.images.append(Image(X.copy(), cmap.copy(), bottom, top, edges, upper))
        self.aspect_equal = aspect == "equal"

    def colorbar(self: InOut[Self], label: str = "") -> None:
        """Draws a colorbar of the last image beside the axes, as matplotlib's
        `Figure.colorbar(im, ax=ax)`: it takes 15% of the axes' width on the right, after a
        gap of 5%, and `label` is written beside its ticks. Panics when there is no image yet,
        where matplotlib raises `RuntimeError`."""
        assert len(self.images) > 0, "colorbar needs an image: call imshow first"
        self.colorbar_on = True
        self.colorbar_label = label.copy()

    def _color(self: InOut[Self], color: str, line: bool) -> str:
        """The SVG color of `color`, or when it is `""` the next color of the cycle: the lines'
        cycle or the one `scatter`, `bar` and `hist` share. matplotlib keeps the two apart, so a
        plot's first line and its first bars are both blue."""
        if color != "":
            return to_hex(color)
        if line:
            self.line_colors += 1
            return to_hex(f"C{(self.line_colors - 1) % 10}")
        self.patch_colors += 1
        return to_hex(f"C{(self.patch_colors - 1) % 10}")

    def set_title(self: InOut[Self], label: str) -> None:
        """Sets the title, centred above the axes."""
        self.title = label.copy()

    def set_xlabel(self: InOut[Self], xlabel: str) -> None:
        """Sets the label centred under the x axis."""
        self.xlabel = xlabel.copy()

    def set_ylabel(self: InOut[Self], ylabel: str) -> None:
        """Sets the label centred left of the y axis, turned to read upwards."""
        self.ylabel = ylabel.copy()

    def set_xlim(self: InOut[Self], left: f64, right: f64) -> None:
        """Shows x from `left` to `right`; `left` larger than `right` turns the axis around.
        Limits too close to tell apart are widened by 5% each way, as matplotlib widens them,
        so `set_xlim(1.0, 1.0)` shows 0.95 to 1.05.

        Panics when a limit is NaN or infinite, where matplotlib raises `ValueError`."""
        assert isfinite(left) and isfinite(right), "Axis limits cannot be NaN or Inf"
        self.xlim = fixed_limits(left, right)

    def set_ylim(self: InOut[Self], bottom: f64, top: f64) -> None:
        """Shows y from `bottom` to `top`; `bottom` larger than `top` turns the axis around.
        Widens limits and panics as `set_xlim` does."""
        assert isfinite(bottom) and isfinite(top), "Axis limits cannot be NaN or Inf"
        self.ylim = fixed_limits(bottom, top)

    def set_xscale(self: InOut[Self], value: str) -> None:
        """Lays the x axis out evenly, `"linear"`, or by the logarithm of x, `"log"`, as
        matplotlib's `set_xscale`. A log axis is ticked at powers of ten labelled `10³`, with
        minor ticks between, and leaves out points at or below 0. Panics on any other scale,
        where matplotlib raises `ValueError`."""
        known = value == "linear" or value == "log"
        assert known, f"{value!r} is not a scale: use 'linear' or 'log'"
        self.xlog = value == "log"

    def set_yscale(self: InOut[Self], value: str) -> None:
        """Lays the y axis out evenly or by the logarithm of y, as `set_xscale` does x."""
        known = value == "linear" or value == "log"
        assert known, f"{value!r} is not a scale: use 'linear' or 'log'"
        self.ylog = value == "log"

    def legend(self: InOut[Self], loc: str = "best") -> None:
        """Shows a legend of every artist with a label, as matplotlib's `legend`: a sample of
        each beside its label, in the order drawn, in a white box inside the axes.

        `loc` is matplotlib's: `"upper right"`, `"upper left"`, `"lower left"`,
        `"lower right"`, `"right"`, `"center left"`, `"center right"`, `"lower center"`,
        `"upper center"` or `"center"`, or `"best"`, which takes the first of those, in that
        order, that covers the fewest data points, as matplotlib's `"best"` does. Panics on any
        other `loc`.
        """
        assert location_code(loc) >= 0, "legend's loc must be 'best' or one of matplotlib's places"
        self.legend_loc = loc.copy()

    def grid(self: InOut[Self], visible: bool = True) -> None:
        """Draws light gray grid lines across the axes at every tick, or stops drawing them, as
        matplotlib's `grid`. They lie above bars and markers and below lines, as matplotlib's
        default puts them."""
        self.grid_on = visible

    def savefig(self: Self, fname: str) -> Raises[None, OSError | ValueError]:
        """Writes a figure holding these axes to the file `fname`, as matplotlib's
        `Figure.savefig`; the extension picks the format.

        The SVG's text is left as text, as matplotlib's `svg.fonttype = "none"` leaves it, so
        the viewer draws it in DejaVu Sans or the nearest font it has. The file holds every
        point of every artist: about 15 bytes a point of a line and 60 a marker.

        # Errors

        `ValueError` when the extension is not `.svg`, the only format so far, with
        matplotlib's message; `OSError` when the file cannot be written.
        """
        check_format(fname)
        renderer = RendererSVG(WIDTH, HEIGHT, [], 0)
        draw_axes(self, subplot_box(0, 0, 1, 1), renderer)
        with open(fname, "w") as file:
            file.write(renderer.tostring())


def axes() -> Axes:
    """New, empty axes in the default figure, as matplotlib's `pyplot.axes()`.

    ```python
    import byplot as plt

    def main():
        ax = plt.axes()
        ax.set_title("empty")
    ```
    """
    return Axes([], "", "", "", None, None, 0, 0, "", [], [], "", False, False, False, False, False)


def subplots(nrows: int = 1, ncols: int = 1) -> Figure:
    """A new figure with a grid of `nrows` by `ncols` empty axes, as matplotlib's
    `pyplot.subplots`, which returns the figure and the axes; here the axes are `fig.axes`
    (decision 0046). The grid fills matplotlib's default space, with gaps of a fifth of an axes
    between them. Panics when either count is below 1, where matplotlib raises `ValueError`.

    ```python
    import byplot as plt

    def main() -> Raises[None, OSError | ValueError]:
        fig = plt.subplots(2, 1)
        fig.axes[0].plot(Array([0.0, 1.0]), Array([0.0, 1.0]))
        fig.axes[1].set_title("below")
        fig.savefig("two.svg")
    ```
    """
    assert nrows >= 1, f"Number of rows must be a positive integer, not {nrows}"
    assert ncols >= 1, f"Number of columns must be a positive integer, not {ncols}"
    grid: list[Axes] = []
    for _ in range(nrows * ncols):
        grid.append(axes())
    return Figure(grid, nrows, ncols)
