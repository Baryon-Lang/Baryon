"""Bessel functions of the first and second kinds and integer order for `special` (roadmap
3.18.4): `j0`, `j1`, `jn`, `y0`, `y1` and `yn`.

The compiler reads this file for `<std>/special.byn`; a program cannot import it.
"""

from math import cos, floor, inf, isinf, isnan, log, nan, pi, sin, sqrt
from special_common import EULER


def _bessel_j_series(order: int, x: f64) -> f64:
    """Jₙ(x) for |x| up to 2 by its power series (x/2)ⁿ Σ (−x²/4)ᵏ / (k! (k + n)!), whose
    largest term is the first, so nothing cancels."""
    w = -0.25 * x * x
    term = 1.0
    for k in range(1, order + 1):
        term *= 0.5 * x / k
    total = term
    for k in range(1, 40):
        term *= w / (k * (k + order))
        total += term
        if abs(term) <= 1.0e-17 * abs(total):
            break
    return total


def _bessel_j_ladder(x: f64) -> Array[f64, 1]:
    """J₀(x), J₁(x), … for `x` from 2 to 5, by Miller's backward recurrence
    Jₖ₋₁ = (2k/x) Jₖ − Jₖ₊₁, started far enough above `x` that the start's error has died
    away, and scaled so that J₀ + 2 Σ J₂ₖ = 1.

    Returns the whole ladder, from J₀ to the start, so `y0` and `y1` can sum their Neumann
    series over it. Backward recurrence is stable for J, whose values fall as the order rises
    past `x`.
    """
    top = 2 * floor(0.5 * x + 15.0 + sqrt(x))
    ladder = Array.zeros(top + 2)
    ladder[top] = 1.0e-300
    for k in range(top, 0, -1):
        ladder[k - 1] = 2.0 * k / x * ladder[k] - ladder[k + 1]
        if abs(ladder[k - 1]) > 1.0e250:
            for i in range(k - 1, top + 1):
                ladder[i] *= 1.0e-250
    norm = ladder[0]
    for k in range(2, top + 1, 2):
        norm += 2.0 * ladder[k]
    for k in range(top + 2):
        ladder[k] /= norm
    return ladder


def _hankel_p0(z: f64) -> f64:
    """P of Hankel's expansion of J₀ and Y₀ at z = 1/x², x from 5 up, fitted with mpmath."""
    top = 4206377.580044236
    top = top * z + 20604774.56178375
    top = top * z + 15189927.189747807
    top = top * z + 3458933.2756562657
    top = top * z + 309290.5655621448
    top = top * z + 11820.316545118923
    top = top * z + 188.34132551271043
    top = top * z + 1.0
    bottom = 4941235.9032213
    bottom = bottom * z + 21421090.757963475
    bottom = bottom * z + 15405542.04107145
    bottom = bottom * z + 3479511.971228022
    bottom = bottom * z + 310102.0469025809
    bottom = bottom * z + 11833.452086317091
    bottom = bottom * z + 188.41163801271043
    bottom = bottom * z + 1.0
    return top / bottom


def _hankel_q0(z: f64) -> f64:
    """x Q of Hankel's expansion of J₀ and Y₀ at z = 1/x², fitted as `_hankel_p0` is."""
    top = -1356779.9339803623
    top = top * z - 6169275.005520304
    top = top * z - 3790667.036569122
    top = top * z - 728320.9241640473
    top = top * z - 55975.96812035948
    top = top * z - 1868.347323729643
    top = top * z - 26.336932794125346
    top = top * z - 0.125
    bottom = 23931240.15176483
    bottom = bottom * z + 61947666.46786055
    bottom = bottom * z + 33224046.35282348
    bottom = bottom * z + 6069258.729913674
    bottom = bottom * z + 456267.0484335255
    bottom = bottom * z + 15068.759421050176
    bottom = bottom * z + 211.28139985300268
    bottom = bottom * z + 1.0
    return top / bottom


def _hankel_p1(z: f64) -> f64:
    """P of Hankel's expansion of J₁ and Y₁ at z = 1/x², fitted as `_hankel_p0` is."""
    top = 4081549.4238493256
    top = top * z + 18124632.50742543
    top = top * z + 13670757.34818872
    top = top * z + 3204657.0454153847
    top = top * z + 293787.78720482026
    top = top * z + 11460.121573649225
    top = top * z + 185.708435511422
    top = top * z + 1.0
    bottom = 2988052.2585857008
    bottom = bottom * z + 16880945.20509651
    bottom = bottom * z + 13334638.885653926
    bottom = bottom * z + 3171913.5139477826
    bottom = bottom * z + 292473.4208586638
    bottom = bottom * z + 11438.516794829518
    bottom = bottom * z + 185.591248011422
    bottom = bottom * z + 1.0
    return top / bottom


def _hankel_q1(z: f64) -> f64:
    """x Q of Hankel's expansion of J₁ and Y₁ at z = 1/x², fitted as `_hankel_p0` is."""
    top = 4395714.042474209
    top = top * z + 17264046.872343943
    top = top * z + 10586293.31173112
    top = top * z + 2063922.5702360424
    top = top * z + 161260.55950964693
    top = top * z + 5465.329605541083
    top = top * z + 78.08716117536554
    top = top * z + 0.375
    bottom = 17228320.831322625
    bottom = bottom * z + 51478155.372255325
    bottom = bottom * z + 29507898.3023356
    bottom = bottom * z + 5612638.7202212345
    bottom = bottom * z + 433879.6612813072
    bottom = bottom * z + 14630.485400675701
    bottom = bottom * z + 208.50586730097473
    bottom = bottom * z + 1.0
    return top / bottom


def _bessel_hankel(order: int, x: f64) -> tuple[f64, f64]:
    """Jₙ(x) and Yₙ(x) for `n` 0 or 1 and `x` from 5 up, by Hankel's form
    √(2/(πx)) (P cos χ − Q sin χ) and √(2/(πx)) (P sin χ + Q cos χ), χ = x − (2n + 1)π/4.

    P and xQ are rational functions of 1/x² fitted with mpmath (roadmap 3.18.17; the script is in
    `crates/driver/tests/fixtures/special/README.md`), each within 3 ULP: a dozen
    multiplications, where summing the asymptotic series took up to sixty divisions and Miller's
    recurrence below 25 a ladder of up to fifty terms. cos χ and sin χ are formed from `cos(x)`
    and `sin(x)`, whose argument is exact, so χ is never rounded; near a zero the result is
    accurate to a few ULP of the envelope √(2/(πx)) rather than of itself.
    """
    z = 1.0 / (x * x)
    p = 0.0
    q = 0.0
    if order == 0:
        p = _hankel_p0(z)
        q = _hankel_q0(z) / x
    else:
        p = _hankel_p1(z)
        q = _hankel_q1(z) / x
    cosine = cos(x)
    sine = sin(x)
    if order == 0:
        along = cosine + sine
        across = sine - cosine
    else:
        along = sine - cosine
        across = -sine - cosine
    scale = sqrt(1.0 / (pi * x))
    return (scale * (p * along - q * across), scale * (p * across + q * along))


def j0(x: f64) -> f64:
    """The Bessel function of the first kind of order 0, J₀(x), as `scipy.special.j0`.

    An even function, 1 at 0, oscillating with an envelope √(2/(πx)) far out. The power series
    below |x| = 2, Miller's backward recurrence to 5 and Hankel's form beyond; near a
    zero away from 0 the error is a few ULP of the envelope, not of the value itself.

    ```python
    from special import j0

    print(j0(1.0))  # 0.7651976865579666
    ```
    """
    if isnan(x):
        return nan
    size = abs(x)
    if size <= 2.0:
        return _bessel_j_series(0, size)
    if size < 5.0:
        return _bessel_j_ladder(size)[0]
    if isinf(size):
        return 0.0
    first, _ = _bessel_hankel(0, size)
    return first


def j1(x: f64) -> f64:
    """The Bessel function of the first kind of order 1, J₁(x), as `scipy.special.j1`: an odd
    function, 0 at 0, computed as `j0` is.

    ```python
    from special import j1

    print(j1(1.0))  # 0.44005058574493355
    ```
    """
    if isnan(x):
        return nan
    size = abs(x)
    if size <= 2.0:
        value = _bessel_j_series(1, size)
    elif size < 5.0:
        value = _bessel_j_ladder(size)[1]
    elif isinf(size):
        value = 0.0
    else:
        value, _ = _bessel_hankel(1, size)
    if x < 0.0:
        return -value
    return value


def _bessel_y_small(order: int, x: f64) -> f64:
    """Y₀(x) or Y₁(x) for `x` above 0 up to 2, from the series of J and the logarithmic
    series of Y: Y₀ = (2/π)(log(x/2) + γ) J₀ + (2/π) Σ (−1)ᵏ⁺¹ Hₖ (x²/4)ᵏ / (k!)², and
    Y₁ = (2/π)(log(x/2) J₁ − 1/x) − (x/(2π)) Σ (ψ(k + 1) + ψ(k + 2)) (−x²/4)ᵏ / (k! (k + 1)!),
    Hₖ being the harmonic numbers."""
    logarithm = log(0.5 * x) + EULER
    w = -0.25 * x * x
    if order == 0:
        term = 1.0
        harmonic = 0.0
        total = 0.0
        for k in range(1, 40):
            term *= w / (k * k)
            harmonic += 1.0 / k
            total -= term * harmonic
            if abs(term * harmonic) <= 1.0e-17 * abs(total):
                break
        return 2.0 / pi * (logarithm * _bessel_j_series(0, x) + total)
    term = 1.0
    digammas = 1.0 - 2.0 * EULER
    total = digammas
    for k in range(1, 40):
        term *= w / (k * (k + 1))
        digammas += 1.0 / k + 1.0 / (k + 1)
        total += term * digammas
        if abs(term * digammas) <= 1.0e-17 * abs(total):
            break
    plain = log(0.5 * x)
    return 2.0 / pi * (plain * _bessel_j_series(1, x) - 1.0 / x) - x / (2.0 * pi) * total


def _bessel_y_ladder(x: f64) -> tuple[f64, f64]:
    """Y₀(x) and Y₁(x) for `x` from 2 to 5, by Neumann's series over the ladder of J that
    `_bessel_j_ladder` gives: Y₀ = (2/π)(log(x/2) + γ) J₀ − (4/π) Σ (−1)ᵏ J₂ₖ / k, and Y₁ its
    derivative's negative, (2/π)((log(x/2) + γ) J₁ − J₀/x) + (2/π) Σ (−1)ᵏ (J₂ₖ₋₁ − J₂ₖ₊₁) / k."""
    ladder = _bessel_j_ladder(x)
    logarithm = log(0.5 * x) + EULER
    even = 0.0
    odd = 0.0
    for k in range(1, len(ladder) // 2 - 1):
        sign = 1.0
        if k % 2 == 1:
            sign = -1.0
        even += sign * ladder[2 * k] / k
        odd += sign * (ladder[2 * k - 1] - ladder[2 * k + 1]) / k
    zeroth = 2.0 / pi * logarithm * ladder[0] - 4.0 / pi * even
    first = 2.0 / pi * (logarithm * ladder[1] - ladder[0] / x) + 2.0 / pi * odd
    return (zeroth, first)


def y0(x: f64) -> f64:
    """The Bessel function of the second kind of order 0, Y₀(x), as `scipy.special.y0`.

    −∞ at 0 and NaN below 0, as SciPy gives. Accurate to a few ULP of the envelope
    √(2/(πx)) away from 0, as `j0` is.

    ```python
    from special import y0

    print(y0(1.0))  # 0.088256964215677
    ```
    """
    if isnan(x) or x < 0.0:
        return nan
    if x == 0.0:
        return -inf
    if x <= 2.0:
        return _bessel_y_small(0, x)
    if x < 5.0:
        zeroth, _ = _bessel_y_ladder(x)
        return zeroth
    if isinf(x):
        return 0.0
    _, second = _bessel_hankel(0, x)
    return second


def y1(x: f64) -> f64:
    """The Bessel function of the second kind of order 1, Y₁(x), as `scipy.special.y1`: about
    −2/(πx) near 0, −∞ at 0 and NaN below 0.

    ```python
    from special import y1

    print(y1(1.0))  # -0.7812128213002887
    ```
    """
    if isnan(x) or x < 0.0:
        return nan
    if x == 0.0:
        return -inf
    if x <= 2.0:
        return _bessel_y_small(1, x)
    if x < 5.0:
        _, first = _bessel_y_ladder(x)
        return first
    if isinf(x):
        return 0.0
    _, second = _bessel_hankel(1, x)
    return second


def jn(n: int, x: f64) -> f64:
    """The Bessel function of the first kind of whole order `n`, Jₙ(x), as `scipy.special.jn`.

    Upward recurrence from J₀ and J₁ while the order is below |x|, where it is stable, and
    Miller's backward recurrence above, normalized by J₀ + 2 Σ J₂ₖ = 1. J₋ₙ = (−1)ⁿ Jₙ.

    ```python
    from special import jn

    print(jn(5, 2.0))   # 0.007039629755871685
    ```
    """
    if isnan(x):
        return nan
    if n < 0:
        if n % 2 == 0:
            return jn(-n, x)
        return -jn(-n, x)
    if n == 0:
        return j0(x)
    if n == 1:
        return j1(x)
    if x == 0.0:
        return 0.0
    if isinf(x):
        return 0.0
    size = abs(x)
    if n < size:
        before = j0(size)
        current = j1(size)
        for k in range(1, n):
            after = 2.0 * k / size * current - before
            before = current
            current = after
        value = current
    else:
        value = _bessel_j_high(n, size)
    if x < 0.0 and n % 2 == 1:
        return -value
    return value


def _bessel_j_high(n: int, x: f64) -> f64:
    """Jₙ(x) for an order `n` from 2 up and at least `x`, by Miller's backward recurrence from
    an order well above both, normalized by J₀ + 2 Σ J₂ₖ = 1."""
    top = 2 * floor(0.5 * (n + x) + 15.0 + sqrt(n + x))
    above = 0.0
    current = 1.0e-300
    norm = 0.0
    wanted = 0.0
    for k in range(top, 0, -1):
        below = 2.0 * k / x * current - above
        above = current
        current = below
        if k - 1 == n:
            wanted = current
        if (k - 1) % 2 == 0 and k - 1 > 0:
            norm += 2.0 * current
        if abs(current) > 1.0e250:
            current *= 1.0e-250
            above *= 1.0e-250
            norm *= 1.0e-250
            wanted *= 1.0e-250
    norm += current
    return wanted / norm


def yn(n: int, x: f64) -> f64:
    """The Bessel function of the second kind of whole order `n`, Yₙ(x), as
    `scipy.special.yn`, by upward recurrence from Y₀ and Y₁, which is stable for Y at every
    order. Y₋ₙ = (−1)ⁿ Yₙ; −∞ at 0 and NaN below 0.

    ```python
    from special import yn

    print(yn(3, 2.0))   # -1.1277837768404282
    ```
    """
    if n < 0:
        if n % 2 == 0:
            return yn(-n, x)
        return -yn(-n, x)
    if n == 0:
        return y0(x)
    if n == 1:
        return y1(x)
    if isnan(x) or x < 0.0:
        return nan
    if x == 0.0:
        return -inf
    if isinf(x):
        return 0.0
    before = y0(x)
    current = y1(x)
    for k in range(1, n):
        after = 2.0 * k / x * current - before
        before = current
        current = after
        if isinf(current):
            break
    return current
