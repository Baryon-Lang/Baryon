"""The `cm` module: matplotlib's colormaps, which turn a number from 0 to 1 into a color, for
images and their colorbars (decision 0046).

Each colormap is matplotlib's table of 256 colors, written here as the bytes matplotlib's
`cmap(x, bytes=True)` gives, so an image is colored exactly as matplotlib colors it. The
perceptually uniform maps `viridis` (the default), `plasma`, `inferno`, `magma` and `cividis`
are here, with `gray` and `Greys`, and the diverging `coolwarm` and `RdBu`; a name ending in
`_r` is the same map reversed.
"""

from math import isnan


class Colormap(Struct):
    """A colormap: its `name` and its 256 colors, as matplotlib's `Colormap`. Get one by name
    with `get_cmap`.

    ```python
    from cm import get_cmap

    def main():
        cmap = get_cmap("viridis")
        print(cmap.to_rgba_bytes(0.0))  # (68, 1, 84, 255)
    ```
    """

    name: str  # matplotlib's name for it, such as "viridis"
    colors: Array[u8, 2]  # 256 rows of red, green and blue, 0 to 255, from 0 up to 1

    def to_rgba_bytes(self: Self, x: f64) -> tuple[u8, u8, u8, u8]:
        """The color of `x`, as matplotlib's `cmap(x, bytes=True)` gives it: the table entry
        `int(x * 256)`, with 1 itself the last entry; below 0 the first color and above 1 the
        last, as matplotlib's default under and over colors are; NaN fully transparent black,
        its default bad color."""
        if isnan(x):
            return (u8(0), u8(0), u8(0), u8(0))
        index = 0
        if x >= 1.0:
            index = 255
        elif x > 0.0:
            index = int(x * 256.0)
        return (self.colors[index, 0], self.colors[index, 1], self.colors[index, 2], u8(255))


def get_cmap(name: str) -> Colormap:
    """The colormap called `name`, as matplotlib's `colormaps[name]`, or reversed when `name`
    ends in `"_r"`. Builds its table of 256 colors, about 2,000 operations.

    Panics on a name it does not know, where matplotlib raises `ValueError`.
    """
    reverse = name.endswith("_r")
    base = name[0 : len(name) - 2] if reverse else name.copy()
    table = _table(base)
    known = len(table) == 1536
    assert known, (
        f"{name!r} is not a colormap: use 'viridis', 'plasma', 'inferno', 'magma', 'cividis', "
        + "'gray', 'Greys', 'coolwarm' or 'RdBu', or one of them with '_r'"
    )
    colors: Array[u8, 2] = Array.zeros((256, 3))
    digits = "0123456789abcdef"
    for k in range(256):
        row = 255 - k if reverse else k
        for channel in range(3):
            at = 6 * k + 2 * channel
            high = digits.find(table[at])
            low = digits.find(table[at + 1])
            colors[row, channel] = u8(16 * high + low)
    return Colormap(name.copy(), colors)


