"""Internal file of `linalg` (decision 0040): solving and factoring, `lu_factor`, `lu_solve`,
`solve`, `det`, `inv`, `cholesky` and `qr`. `linalg` re-exports each (decision 0062); a program
cannot import this file. The `complex128` overloads call their bodies in `linalg_complex`.
"""

from math import copysign, fabs, hypot, sqrt
from linalg_common import LinAlgError
from linalg_complex import complex_cholesky, complex_det, complex_inv, complex_lu_factor, complex_qr
from linalg_complex import complex_lu_solve_matrix, complex_lu_solve_vector


def lu_factor[T: Float](a: Array[T, 2]) -> Raises[tuple[Array[T, 2], Array[int, 1]], LinAlgError]:
    """The LU factors of a square matrix `a` with partial pivoting, as `scipy.linalg.lu_factor`.

    Returns `(lu, piv)`: `lu` holds the unit lower triangle `L` below its diagonal and the upper
    triangle `U` on and above it, and row `k` was swapped with row `piv[k]` at step `k`, so
    `a[perm] == L @ U` for the permutation the swaps make. The order of operations is LAPACK's
    unblocked `getf2`: about 2n³/3 multiply-adds. Raises `LinAlgError` when a pivot is exactly
    zero, where SciPy only warns; panics when `a` is not square.
    """
    n = a.shape[0]
    assert a.shape[1] == n, "lu_factor needs a square matrix"
    lu = a.copy()
    piv = Array.zeros(n, int)
    for k in range(n):
        pivot = k
        largest = fabs(lu[k, k])
        for i in range(k + 1, n):
            if fabs(lu[i, k]) > largest:
                largest = fabs(lu[i, k])
                pivot = i
        if largest == 0.0:
            raise LinAlgError("Singular matrix")
        piv[k] = pivot
        if pivot != k:
            for j in range(n):
                swap = lu[k, j]
                lu[k, j] = lu[pivot, j]
                lu[pivot, j] = swap
        for i in range(k + 1, n):
            factor = lu[i, k] / lu[k, k]
            lu[i, k] = factor
            for j in range(k + 1, n):
                lu[i, j] -= factor * lu[k, j]
    return lu, piv


def lu_factor(
    a: Array[complex128, 2],
) -> Raises[tuple[Array[complex128, 2], Array[int, 1]], LinAlgError]:
    """`lu_factor` of a `complex128` matrix, beside the generic one, whose `Float` bound excludes
    complex numbers (decision 0067). The pivot is the entry with the largest `|re| + |im|`, as in
    LAPACK's `zgetrf`.
    """
    return complex_lu_factor(a)


def lu_solve(lu: Array[f64, 2], piv: Array[int, 1], b: Array[f64, 1]) -> Array[f64, 1]:
    """The vector `x` with `a @ x == b`, from `lu_factor(a)`'s `lu` and `piv`, as
    `scipy.linalg.lu_solve((lu, piv), b)`.

    Swaps `b`'s rows as `piv` says, then solves with `L` forward and `U` backward: about 2n²
    multiply-adds, so factoring once and solving many times saves the n³ work. Panics when the
    lengths do not fit.
    """
    return _lu_solve_vector(lu, piv, b)


def lu_solve(lu: Array[f32, 2], piv: Array[int, 1], b: Array[f32, 1]) -> Array[f32, 1]:
    """`lu_solve` of an `f32` factorization and vector, worked in `f32`."""
    return _lu_solve_vector(lu, piv, b)


def lu_solve(lu: Array[f64, 2], piv: Array[int, 1], b: Array[f64, 2]) -> Array[f64, 2]:
    """The matrix `x` with `a @ x == b`, one column for each column of `b`, from `lu_factor(a)`'s
    `lu` and `piv`, as `scipy.linalg.lu_solve((lu, piv), b)` for a two-dimensional `b`.

    About 2n² multiply-adds for each of `b`'s k columns. Panics when `b` has not as many rows as
    `lu`.
    """
    return _lu_solve_matrix(lu, piv, b)


def lu_solve(lu: Array[f32, 2], piv: Array[int, 1], b: Array[f32, 2]) -> Array[f32, 2]:
    """`lu_solve` of an `f32` factorization and matrix, worked in `f32`."""
    return _lu_solve_matrix(lu, piv, b)


def lu_solve(
    lu: Array[complex128, 2], piv: Array[int, 1], b: Array[complex128, 1],
) -> Array[complex128, 1]:
    """`lu_solve` of a `complex128` factorization and vector."""
    return complex_lu_solve_vector(lu, piv, b)


def lu_solve(
    lu: Array[complex128, 2], piv: Array[int, 1], b: Array[complex128, 2],
) -> Array[complex128, 2]:
    """`lu_solve` of a `complex128` factorization and matrix of right-hand sides."""
    return complex_lu_solve_matrix(lu, piv, b)


def solve(a: Array[f64, 2], b: Array[f64, 1]) -> Raises[Array[f64, 1], LinAlgError]:
    """The vector `x` with `a @ x == b`, for a square matrix `a`, as `numpy.linalg.solve`.

    `lu_factor` then `lu_solve`, LAPACK's `gesv` order unblocked: about 2n³/3 multiply-adds and
    one n × n copy of `a`. Raises `LinAlgError` when a pivot is exactly zero; panics when `a` is
    not square or `b`'s length is not `a`'s.
    """
    assert len(b) == a.shape[0], "solve needs b as long as a has rows"
    lu, piv = lu_factor(a)
    return _lu_solve_vector(lu, piv, b)


def solve(a: Array[f32, 2], b: Array[f32, 1]) -> Raises[Array[f32, 1], LinAlgError]:
    """`solve` of an `f32` matrix and vector, worked in `f32`."""
    assert len(b) == a.shape[0], "solve needs b as long as a has rows"
    lu, piv = lu_factor(a)
    return _lu_solve_vector(lu, piv, b)


def solve(a: Array[f64, 2], b: Array[f64, 2]) -> Raises[Array[f64, 2], LinAlgError]:
    """The matrix `x` with `a @ x == b`, one column for each column of `b`, for a square matrix
    `a`, as `numpy.linalg.solve` for a two-dimensional `b`.

    Factors `a` once, about 2n³/3 multiply-adds, then solves each of `b`'s k columns in about 2n²
    more. Raises `LinAlgError` when a pivot is exactly zero; panics when `a` is not square or `b`
    has not as many rows as `a`.
    """
    assert b.shape[0] == a.shape[0], "solve needs b with as many rows as a"
    lu, piv = lu_factor(a)
    return _lu_solve_matrix(lu, piv, b)


def solve(a: Array[f32, 2], b: Array[f32, 2]) -> Raises[Array[f32, 2], LinAlgError]:
    """`solve` of an `f32` matrix and a matrix of right-hand sides, worked in `f32`."""
    assert b.shape[0] == a.shape[0], "solve needs b with as many rows as a"
    lu, piv = lu_factor(a)
    return _lu_solve_matrix(lu, piv, b)


def solve(
    a: Array[complex128, 2], b: Array[complex128, 1],
) -> Raises[Array[complex128, 1], LinAlgError]:
    """`solve` of a `complex128` matrix and vector, as NumPy's `zgesv`."""
    assert len(b) == a.shape[0], "solve needs b as long as a has rows"
    lu, piv = complex_lu_factor(a)
    return complex_lu_solve_vector(lu, piv, b)


def solve(
    a: Array[complex128, 2], b: Array[complex128, 2],
) -> Raises[Array[complex128, 2], LinAlgError]:
    """`solve` of a `complex128` matrix and a matrix of right-hand sides."""
    assert b.shape[0] == a.shape[0], "solve needs b with as many rows as a"
    lu, piv = complex_lu_factor(a)
    return complex_lu_solve_matrix(lu, piv, b)


def _lu_solve_vector[T: Float](lu: Array[T, 2], piv: Array[int, 1], b: Array[T, 1]) -> Array[T, 1]:
    """The body of `lu_solve` for one right-hand side: the swaps of `piv`, then forward and back
    substitution, in the order LAPACK's `getrs` uses, so each `x[i]` adds its terms left to
    right.
    """
    n = lu.shape[0]
    assert lu.shape[1] == n, "lu_solve needs a square lu"
    assert len(piv) == n, "lu_solve needs piv as long as lu has rows"
    assert len(b) == n, "lu_solve needs b as long as lu has rows"
    x = b.copy()
    for k in range(n):
        pivot = piv[k]
        if pivot != k:
            swap = x[k]
            x[k] = x[pivot]
            x[pivot] = swap
    for i in range(n):
        total = x[i]
        for k in range(i):
            total -= lu[i, k] * x[k]
        x[i] = total
    for k in range(n - 1, -1, -1):
        total = x[k]
        for j in range(k + 1, n):
            total -= lu[k, j] * x[j]
        x[k] = total / lu[k, k]
    return x


def _lu_solve_matrix[T: Float](lu: Array[T, 2], piv: Array[int, 1], b: Array[T, 2]) -> Array[T, 2]:
    """The body of `lu_solve` for a matrix of right-hand sides: each column of `b` is copied out,
    solved by `_lu_solve_vector`, and copied into the result, so every column gets the bits it
    would get alone.
    """
    n = lu.shape[0]
    assert b.shape[0] == n, "lu_solve needs b with as many rows as lu"
    columns = b.shape[1]
    x = Array.zeros((n, columns), T)
    column = Array.zeros(n, T)
    for j in range(columns):
        for i in range(n):
            column[i] = b[i, j]
        solved = _lu_solve_vector(lu, piv, column)
        for i in range(n):
            x[i, j] = solved[i]
    return x


def det[T: Float](a: Array[T, 2]) -> T:
    """The determinant of a square matrix `a`, as `numpy.linalg.det`: the product of `U`'s
    diagonal from `lu_factor`, negated once for each row swap. A singular matrix gives `0.0`.

    About 2n³/3 multiply-adds. Panics when `a` is not square.
    """
    try:
        lu, piv = lu_factor(a)
    except LinAlgError:
        return 0.0
    result: T = 1.0
    for k in range(len(piv)):
        result *= lu[k, k]
        if piv[k] != k:
            result = -result
    return result


def det(a: Array[complex128, 2]) -> complex128:
    """`det` of a `complex128` matrix; a singular one gives `0j`."""
    return complex_det(a)


def inv[T: Float](a: Array[T, 2]) -> Raises[Array[T, 2], LinAlgError]:
    """The inverse of a square matrix `a`, as `numpy.linalg.inv`: `lu_solve` of each column of
    the identity. Prefer `solve(a, b)` to `inv(a) @ b`, which costs more and is less accurate.

    About 8n³/3 multiply-adds. Raises `LinAlgError` when `a` is singular; panics when `a` is not
    square.
    """
    n = a.shape[0]
    lu, piv = lu_factor(a)
    result = Array.zeros((n, n), T)
    column = Array.zeros(n, T)
    for j in range(n):
        column.fill(0.0)
        column[j] = 1.0
        x = _lu_solve_vector(lu, piv, column)
        for i in range(n):
            result[i, j] = x[i]
    return result


def inv(a: Array[complex128, 2]) -> Raises[Array[complex128, 2], LinAlgError]:
    """`inv` of a `complex128` matrix. Raises `LinAlgError` when it is singular."""
    return complex_inv(a)


def cholesky[T: Float](a: Array[T, 2]) -> Raises[Array[T, 2], LinAlgError]:
    """The lower triangular `l` with `l @ lᵀ == a`, for a symmetric positive definite matrix
    `a`, as `numpy.linalg.cholesky`.

    Reads only `a`'s lower triangle, as NumPy does, in LAPACK's unblocked `potf2` order: about
    n³/3 multiply-adds. Raises `LinAlgError` when a diagonal entry is not positive, so `a` is not
    positive definite; panics when `a` is not square.
    """
    n = a.shape[0]
    assert a.shape[1] == n, "cholesky needs a square matrix"
    l = Array.zeros((n, n), T)
    for j in range(n):
        diagonal = a[j, j]
        for k in range(j):
            diagonal -= l[j, k] * l[j, k]
        if not diagonal > 0.0:
            raise LinAlgError("Matrix is not positive definite")
        pivot = sqrt(diagonal)
        l[j, j] = pivot
        for i in range(j + 1, n):
            total = a[i, j]
            for k in range(j):
                total -= l[i, k] * l[j, k]
            l[i, j] = total / pivot
    return l


def cholesky(a: Array[complex128, 2]) -> Raises[Array[complex128, 2], LinAlgError]:
    """`cholesky` of a Hermitian positive definite `complex128` matrix: the lower triangular `l`
    with `l @ lᴴ == a`, its diagonal real. Raises `LinAlgError` when `a` is not positive definite.
    """
    return complex_cholesky(a)


def qr[T: Float](a: Array[T, 2]) -> tuple[Array[T, 2], Array[T, 2]]:
    """The factors `q` and `r` of an m × n matrix `a` with `q @ r == a`, as
    `numpy.linalg.qr(a)`: `q` is m × k with orthonormal columns and `r` is k × n upper
    triangular, for k = min(m, n).

    Householder reflections in LAPACK's unblocked `geqr2` and `org2r` order, with LAPACK's signs,
    so `q` and `r` match NumPy's and not only up to sign: about 2mn² - 2n³/3 multiply-adds for
    the factors and as many again for `q`. Never fails.
    """
    m = a.shape[0]
    n = a.shape[1]
    k = min(m, n)
    work = a.copy()
    tau = Array.zeros(k, T)
    for i in range(k):
        alpha = work[i, i]
        squares: T = 0.0
        for row in range(i + 1, m):
            squares += work[row, i] * work[row, i]
        if squares == 0.0:
            continue
        beta = -copysign(hypot(alpha, sqrt(squares)), alpha)
        tau[i] = (beta - alpha) / beta
        scale = 1.0 / (alpha - beta)
        for row in range(i + 1, m):
            work[row, i] *= scale
        work[i, i] = 1.0
        _reflect(work, tau[i], i, i + 1, n)
        work[i, i] = beta
    r = Array.zeros((k, n), T)
    for row in range(k):
        for column in range(row, n):
            r[row, column] = work[row, column]
    q = Array.zeros((m, k), T)
    for row in range(m):
        for column in range(k):
            q[row, column] = work[row, column]
    for i in range(k - 1, -1, -1):
        if i < k - 1:
            q[i, i] = 1.0
            _reflect(q, tau[i], i, i + 1, k)
        for row in range(i + 1, m):
            q[row, i] *= -tau[i]
        q[i, i] = 1.0 - tau[i]
        for row in range(i):
            q[row, i] = 0.0
    return q, r


def qr(a: Array[complex128, 2]) -> tuple[Array[complex128, 2], Array[complex128, 2]]:
    """`qr` of a `complex128` matrix: `q` with orthonormal columns, `qᴴ @ q` the identity, and
    upper triangular `r` with a real diagonal, with LAPACK's phases so they match NumPy's.
    """
    return complex_qr(a)


def _reflect[T: Float](matrix: InOut[Array[T, 2]], tau: T, i: int, start: int, stop: int):
    """Applies the reflection `I - tau v vᵀ` from the left to columns `start` to `stop` of
    `matrix`, rows `i` on, where `v` is column `i` from row `i` down: LAPACK's `larf`.
    """
    if tau == 0.0:
        return
    m = matrix.shape[0]
    for column in range(start, stop):
        total: T = 0.0
        for row in range(i, m):
            total += matrix[row, i] * matrix[row, column]
        total *= tau
        for row in range(i, m):
            matrix[row, column] -= total * matrix[row, i]
