"""The `legend` library file: draws a legend inside an axes, placed where matplotlib's `Legend` puts
it, `"best"` included (decision 0046).

It is internal to the standard library: `byplot` and the files under it import it, and a
program cannot, so a program's own `legend.byn` is never hidden by it.

`byplot`'s `Axes.legend` records where the legend goes; when the figure is drawn, `draw_legend`
lays it out from the axes' artists and draws it.
"""

from artist import Artist, Kind, View
from backend_bases import RendererBase

FONT_SIZE: Final = 10.0  # the labels, in points


def location_code(loc: str) -> int:
    """matplotlib's code for the legend location `loc`: 0 for `"best"`, 1 to 10 for
    `"upper right"`, `"upper left"`, `"lower left"`, `"lower right"`, `"right"`,
    `"center left"`, `"center right"`, `"lower center"`, `"upper center"` and `"center"`, and
    -1 for a name it does not know.
    """
    names = [
        "best",
        "upper right",
        "upper left",
        "lower left",
        "lower right",
        "right",
        "center left",
        "center right",
        "lower center",
        "upper center",
        "center",
    ]
    for code in range(len(names)):
        if loc == names[code]:
            return code
    return -1


def draw_legend[R: RendererBase](
    artists: list[Artist], loc: str, view: View, renderer: InOut[R]
) -> None:
    """Draws a legend of the `artists` with a label at `loc`, inside the axes `view` shows, as
    matplotlib's `Legend` draws one with its default spacing: 4 points of padding, a 20 point
    sample of each artist, 8 points before its label and 5 between rows, 5 points in from the
    axes' edge, in a white box at 80% opacity with a light gray edge. Draws nothing when no
    artist has a label.

    `loc` is `"best"` or one of the places `location_code` knows; `"best"` costs ten passes
    over every point drawn.
    """
    widest = 0.0
    rows = 0
    for artist in artists:
        if artist.label != "":
            width, _, _ = renderer.get_text_width_height_descent(artist.label, FONT_SIZE)
            widest = max(widest, width)
            rows += 1
    if rows == 0:
        return
    _, row, descent = renderer.get_text_width_height_descent("0", FONT_SIZE)
    width = 2.0 * 4.0 + 20.0 + 8.0 + widest
    height = 2.0 * 4.0 + f64(rows) * row + f64(rows - 1) * 5.0
    code = location_code(loc)
    if code == 0:
        code = _best(artists, view, width, height)
    left, top = _corner(code, view, width, height)
    renderer.draw_rectangle(left, top, width, height, "#ffffff", 0.8, "#cccccc", 1.0, False)
    k = 0
    index = -1
    for artist in artists:
        index += 1
        if artist.label != "":
            middle = top + 4.0 + f64(k) * (row + 5.0) + 0.5 * row
            start = left + 4.0
            if artist.kind == Kind.BARS or artist.kind == Kind.FILL:
                renderer.draw_rectangle(
                    start, middle - 3.5, 20.0, 7.0, artist.color, artist.alpha, "none", 0.0, False
                )
            _draw_errors(artists, index, start + 10.0, middle, renderer)
            if artist.kind == Kind.LINE and artist.linewidth > 0.0:
                across = Array([start, start + 20.0])
                level = Array([middle, middle])
                width = artist.linewidth
                cap = "projecting" if len(artist.dashes) == 0 else "butt"
                renderer.draw_path(across, level, artist.color, width, artist.dashes, cap, False)
            if artist.marker != "":
                edge = 1.5 if artist.kind == Kind.MARKERS else 1.0
                at = Array([start + 10.0])
                level = Array([middle])
                size = artist.markersize
                renderer.draw_markers(at, level, artist.marker, size, artist.color, edge, False)
            baseline = middle + 0.5 * row - descent
            renderer.draw_text(start + 28.0, baseline, artist.label, FONT_SIZE, "start", False)
            k += 1


def _draw_errors[R: RendererBase](
    artists: list[Artist], index: int, x: f64, y: f64, renderer: InOut[R]
) -> None:
    """Draws, centred on `(x, y)`, a sample of the error bars `errorbar` added just before the
    line `artists[index]`, as matplotlib's `HandlerErrorbar` does: each bar 10 points long,
    with its caps, before the line's own sample. Draws nothing for a line with no error bars."""
    first = index
    while first > 0 and artists[first - 1].kind == Kind.ERRORS:
        first -= 1
    for k in range(first, index):
        across = artists[k].marker == "|"
        ends_x = Array([x - 5.0, x + 5.0]) if across else Array([x, x])
        ends_y = Array([y, y]) if across else Array([y + 5.0, y - 5.0])
        width = artists[k].linewidth
        renderer.draw_path(ends_x, ends_y, artists[k].color, width, [], "butt", False)
        if artists[k].markersize > 0.0:
            size = artists[k].markersize
            cap = "|" if across else "_"
            renderer.draw_markers(ends_x, ends_y, cap, size, artists[k].color, 1.0, False)


def _corner(code: int, view: View, width: f64, height: f64) -> tuple[f64, f64]:
    """The top left corner of a legend `width` by `height` points at matplotlib's location
    `code`, 5 points inside the axes."""
    inset = 5.0
    left_edge = view.left
    right_edge = view.right
    top_edge = view.top
    bottom_edge = view.bottom
    left = (left_edge + right_edge - width) / 2.0
    if code == 2 or code == 3 or code == 6:
        left = left_edge + inset
    elif code == 1 or code == 4 or code == 5 or code == 7:
        left = right_edge - inset - width
    top = (top_edge + bottom_edge - height) / 2.0
    if code == 1 or code == 2 or code == 9:
        top = top_edge + inset
    elif code == 3 or code == 4 or code == 8:
        top = bottom_edge - inset - height
    return (left, top)


def _best(artists: list[Artist], view: View, width: f64, height: f64) -> int:
    """matplotlib's `"best"` location: the first of the ten places, in `legend`'s order, whose
    box holds the fewest points of lines, markers, error bar caps and filled areas' outlines,
    overlaps the fewest bars, and crosses the fewest lines and outlines. Error bars without caps
    and contours do not count, as matplotlib's do not; text does not count yet, though
    matplotlib's does. Costs ten passes over every point drawn."""
    best = 1
    least = -1
    for code in range(1, 11):
        left, top = _corner(code, view, width, height)
        right = left + width
        bottom = top + height
        badness = 0
        for artist in artists:
            if artist.kind == Kind.CONTOUR or artist.kind == Kind.FILLED:
                continue
            px = view.to_x(artist.x)
            py = view.to_y(artist.y)
            crossed = False
            for i in range(len(px)):
                if artist.kind == Kind.BARS:
                    base = view.to_y(Array([0.0]))[0]
                    xscale = (view.right - view.left) / (view.x1 - view.x0)
                    across = px[i] + artist.widths[i] * xscale
                    apart_x = min(px[i], across) >= right or max(px[i], across) <= left
                    apart_y = min(py[i], base) >= bottom or max(py[i], base) <= top
                    if not apart_x and not apart_y:
                        badness += 1
                elif artist.kind != Kind.ERRORS or artist.markersize > 0.0:
                    if left < px[i] and px[i] < right and top < py[i] and py[i] < bottom:
                        badness += 1
                    outline = artist.kind == Kind.LINE or artist.kind == Kind.FILL
                    if outline and i > 0 and not crossed:
                        box = (left, top, right, bottom)
                        crossed = _crosses(px[i - 1], py[i - 1], px[i], py[i], box)
            if crossed:
                badness += 1
        if badness == 0:
            return code
        if least < 0 or badness < least:
            least = badness
            best = code
    return best


def _crosses(xa: f64, ya: f64, xb: f64, yb: f64, box: tuple[f64, f64, f64, f64]) -> bool:
    """Whether the segment from `(xa, ya)` to `(xb, yb)` touches the rectangle `box`, given
    as its left, top, right and bottom, found by clipping the segment to each side in turn
    (Liang and Barsky's method)."""
    left, top, right, bottom = box
    start = 0.0
    end = 1.0
    steps = [-(xb - xa), xb - xa, -(yb - ya), yb - ya]
    gaps = [xa - left, right - xa, ya - top, bottom - ya]
    for k in range(4):
        if steps[k] == 0.0:
            if gaps[k] < 0.0:
                return False
        else:
            t = gaps[k] / steps[k]
            if steps[k] < 0.0:
                start = max(start, t)
            else:
                end = min(end, t)
    return start <= end
