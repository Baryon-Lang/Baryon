"""Mathieu functions for `special` (roadmap 3.18.14): the characteristic values `mathieu_a` and
`mathieu_b`, and the angular functions `mathieu_cem` and `mathieu_sem` with their derivatives.

The periodic solutions of Mathieu's equation y″ + (a − 2q cos 2x) y = 0 (DLMF 28.2) exist only
for characteristic values of a. Each is a Fourier series: ce_m(x, q) = Σ A_k cos kx and
se_m(x, q) = Σ B_k sin kx, with k running over the even or the odd numbers as m does. Put into
the equation, the coefficients satisfy a three-term recurrence (DLMF 28.4.5 to 28.4.8), which
makes a a characteristic value exactly when it is an eigenvalue of a symmetric tridiagonal
matrix, one for each of the four families of m and kind:

| Family | k | Diagonal | Off-diagonal |
| --- | --- | --- | --- |
| ce of even m | 0, 2, 4, … | k² | q, but √2 q beside the first, for A₀ scaled by √2 |
| ce of odd m | 1, 3, 5, … | k², and 1 + q first | q |
| se of odd m | 1, 3, 5, … | k², and 1 − q first | q |
| se of even m | 2, 4, 6, … | k² | q |

The eigenvalues of each matrix rise with m for every real q, so the one for m is found by
bisection on the count of eigenvalues below a point and then Rayleigh quotient iteration, and
its coefficients by a twisted factorization of the matrix less the eigenvalue. The coefficients
are scaled as SciPy scales them, after Abramowitz and Stegun (20.4.4): 2A₀² + A₂² + A₄² + … = 1
for ce of even m and the plain sum of squares 1 otherwise, so that the integral of the square
over a period is π, with ce_m(0) and se_m′(0) above 0 (DLMF 28.2.29).

The compiler reads this file for `<std>/special.byn`; a program cannot import it.
"""

from math import inf, nan, sqrt
from special_common import cospi, is_integer, sinpi

_SQRT_TWO: Final = 1.4142135623730951  # √2

# The four families of matrix, as the table of the module's documentation lists them.
_CE_EVEN: Final = 0
_CE_ODD: Final = 1
_SE_ODD: Final = 2
_SE_EVEN: Final = 3


def _order(family: int, i: int) -> f64:
    """k, the order of the i-th coefficient of `family`: 2i, 2i + 1 or 2i + 2."""
    if family == _CE_EVEN:
        return 2.0 * i
    if family == _SE_EVEN:
        return 2.0 * i + 2.0
    return 2.0 * i + 1.0


def _diagonal(family: int, q: f64, i: int) -> f64:
    """The i-th diagonal entry of the matrix of `family`."""
    k = _order(family, i)
    if i == 0 and family == _CE_ODD:
        return 1.0 + q
    if i == 0 and family == _SE_ODD:
        return 1.0 - q
    return k * k


def _off(family: int, q: f64, i: int) -> f64:
    """The entry beside the i-th diagonal entry, between rows i and i + 1."""
    if i == 0 and family == _CE_EVEN:
        return _SQRT_TWO * q
    return q


def _size(m: f64, q: f64) -> int:
    """How many coefficients to keep: past the one for m and past 2√|q|, where the coefficients
    fall by a factor q/k² of at most 1/16 each, and 20 more take them below 1e-24 of the largest."""
    return int(0.5 * m + 2.0 * sqrt(abs(q))) + 20


def _count_below(family: int, q: f64, n: int, x: f64) -> int:
    """How many eigenvalues of the n × n matrix of `family` are below x: the number of negative
    pivots of its LDLᵀ factorization less x (Sylvester's law of inertia). A pivot of 0 is
    taken as a tiny negative one, as for an eigenvalue at x."""
    count = 0
    pivot = 1.0
    for i in range(n):
        shift = _diagonal(family, q, i) - x
        if i > 0:
            off = _off(family, q, i - 1)
            shift -= off * off / pivot
        if shift == 0.0:
            shift = -1.0e-300
        if shift < 0.0:
            count += 1
        pivot = shift
    return count


def _characteristic(family: int, q: f64, index: int, n: int) -> f64:
    """The eigenvalue of rank `index`, counted from 0 upward, of the n × n matrix of `family`.

    Bisection between Gershgorin's bounds narrows it to within ¼, less than a quarter of the
    gap to its neighbours in the family, which is at least 4. Rayleigh quotient iteration then
    takes it to the last bit, each step correcting a by γ/|x|² from the twisted factorization
    that `_twisted` makes, three steps or so. Should a step leave the bracket, bisection goes on
    to the last bit instead."""
    reach = 1.5 * abs(q) + 1.0
    low = -abs(q) - reach
    top = _order(family, n - 1)
    high = top * top + abs(q) + reach
    while high - low > 0.25:
        middle = 0.5 * (low + high)
        if _count_below(family, q, n, middle) > index:
            high = middle
        else:
            low = middle
    a = 0.5 * (low + high)
    for _ in range(8):
        vector, residue = _twisted(family, q, a, n)
        total = 0.0
        for i in range(n):
            total += vector[i] * vector[i]
        step = residue / total
        a += step
        if abs(step) <= 1.0e-16 * abs(a) or step == 0.0:
            break
    if low <= a and a <= high:
        return a
    for _ in range(2000):
        middle = 0.5 * (low + high)
        if middle == low or middle == high:
            break
        if _count_below(family, q, n, middle) > index:
            high = middle
        else:
            low = middle
    return 0.5 * (low + high)


def _twisted(family: int, q: f64, a: f64, n: int) -> tuple[Array[f64, 1], f64]:
    """An eigenvector of the matrix of `family` for a close to an eigenvalue, with 1 at one
    place and not scaled, and the residue γ there: the matrix less a times the vector is γ at
    that place and 0 elsewhere.

    It is the twisted factorization of the matrix less a: the pivots from the top, the pivots
    from the bottom, and the row where they meet with the smallest residue
    γ = upper + lower − (diagonal − a), where the vector is set to 1 and carried outward, each
    step dividing by a pivot that is not small (Dhillon and Parlett's method, as in LAPACK's
    MRRR)."""
    upper = Array.zeros(n, f64)
    lower = Array.zeros(n, f64)
    for i in range(n):
        upper[i] = _diagonal(family, q, i) - a
        if i > 0:
            off = _off(family, q, i - 1)
            upper[i] -= off * off / upper[i - 1]
        if upper[i] == 0.0:
            upper[i] = 1.0e-300
    for i in range(n - 1, -1, -1):
        lower[i] = _diagonal(family, q, i) - a
        if i < n - 1:
            off = _off(family, q, i)
            lower[i] -= off * off / lower[i + 1]
        if lower[i] == 0.0:
            lower[i] = 1.0e-300
    twist = 0
    residue = upper[0] + lower[0] - (_diagonal(family, q, 0) - a)
    for i in range(1, n):
        candidate = upper[i] + lower[i] - (_diagonal(family, q, i) - a)
        if abs(candidate) < abs(residue):
            residue = candidate
            twist = i
    vector = Array.zeros(n, f64)
    vector[twist] = 1.0
    for i in range(twist - 1, -1, -1):
        vector[i] = -_off(family, q, i) * vector[i + 1] / upper[i]
    for i in range(twist + 1, n):
        vector[i] = -_off(family, q, i - 1) * vector[i - 1] / lower[i]
    return (vector, residue)


def _coefficients(family: int, q: f64, a: f64, n: int, index: int) -> Array[f64, 1]:
    """The coefficients for the characteristic value `a`, from `_twisted`, scaled and signed as
    the module says. `index` is the rank of a, which fixes the sign."""
    vector, _ = _twisted(family, q, a, n)
    total = 0.0
    for i in range(n):
        total += vector[i] * vector[i]
    scale = 1.0 / sqrt(total)
    sign = 0.0
    for i in range(n):
        sign += vector[i] * _sign_weight(family, q, _order(family, i))
    if q > 0.0:
        sign *= _sign_weight(family, q, _order(family, 0) + 2.0 * index)
    if sign < 0.0:
        scale = -scale
    for i in range(n):
        vector[i] *= scale
    if family == _CE_EVEN:
        # The matrix carries √2 A₀ so that it is symmetric.
        vector[0] /= _SQRT_TWO
    return vector


def _sign_weight(family: int, q: f64, k: f64) -> f64:
    """What the term of order k adds, per unit of its coefficient, to the quantity whose sign
    fixes the sign of the function.

    The rule (DLMF 28.2.29) is ce_m(0) > 0 and se_m′(0) > 0, but for q above 0 the functions
    gather about x = π/2 and are exponentially small at 0, so the sum for ce_m(0) or se_m′(0)
    cancels to nothing in `f64`. The sign there follows from the count of zeros between 0 and
    π/2, which no q changes: ce_m and se_m at π/2, or their derivative where they are 0 there,
    have the sign that cos mx and sin mx have, where each sum is its largest. For q below 0 the
    functions gather about 0, and the rule is used as it stands."""
    cosine = family == _CE_EVEN or family == _CE_ODD
    if q <= 0.0:
        return 1.0 if cosine else k
    # cos(kπ/2) and sin(kπ/2) are 0 or ±1; the derivatives carry the factor k.
    half = 0.5 * k
    if family == _CE_EVEN:
        return cospi(half)
    if family == _CE_ODD:
        return -k * sinpi(half)
    if family == _SE_ODD:
        return sinpi(half)
    return k * cospi(half)


def _family(m: f64, cosine: bool) -> int:
    """The family of matrix for order m and the cosine (ce) or sine (se) kind."""
    odd = m - 2.0 * int(0.5 * m) == 1.0
    if cosine:
        return _CE_ODD if odd else _CE_EVEN
    return _SE_ODD if odd else _SE_EVEN


def _index(m: f64, cosine: bool) -> int:
    """The rank of the characteristic value for m among its family's, from 0."""
    if cosine:
        return int(0.5 * m)
    return int(0.5 * (m - 1.0))


def _value(m: f64, q: f64, cosine: bool) -> f64:
    """a_m(q) or b_m(q) for a whole m that its kind allows."""
    if q == 0.0:
        return m * m
    family = _family(m, cosine)
    return _characteristic(family, q, _index(m, cosine), _size(m, q))


def fourier_coefficients(m: f64, q: f64, cosine: bool, least: int) -> Array[f64, 1]:
    """The Fourier coefficients of ce_m (`cosine`) or se_m for a whole m its kind allows,
    scaled and signed as the module says, at least `least` of them: A₀, A₂, … or A₁, A₃, …
    for ce, and B₁, B₃, … or B₂, B₄, … for se. The radial functions of `special_mathieu_radial`
    sum their Bessel products over them, and `mathieu_even_coef` returns them."""
    family = _family(m, cosine)
    n = max(_size(m, q), least)
    index = _index(m, cosine)
    a = m * m if q == 0.0 else _characteristic(family, q, index, n)
    return _coefficients(family, q, a, n, index)


def _function(m: f64, q: f64, x: f64, cosine: bool) -> tuple[f64, f64]:
    """ce_m(x, q) or se_m(x, q) and its derivative in x, for x in degrees and the derivative
    per radian, as SciPy gives them."""
    family = _family(m, cosine)
    vector = fourier_coefficients(m, q, cosine, 0)
    n = vector.shape[0]
    turn = x / 180.0
    value = 0.0
    slope = 0.0
    for i in range(n):
        k = _order(family, i)
        if cosine:
            value += vector[i] * cospi(k * turn)
            slope -= k * vector[i] * sinpi(k * turn)
        else:
            value += vector[i] * sinpi(k * turn)
            slope += k * vector[i] * cospi(k * turn)
    return (value, slope)


def allowed(m: f64, least: f64) -> bool:
    """Whether m is a whole number from `least` up, below 1e9, as each Mathieu function
    requires of its order; `special_mathieu_radial` checks its orders with it too."""
    return m == m and m >= least and is_integer(m) and m < 1.0e9


def mathieu_a(m: f64, q: f64) -> f64:
    """The characteristic value a_m(q) of the even Mathieu function ce_m(x, q), as
    `scipy.special.mathieu_a`: the a for which y″ + (a − 2q cos 2x) y = 0 has a solution of
    period π or 2π that is even in x. m is a whole number from 0 up; any other m gives NaN.

    ```python
    from special import mathieu_a

    print(mathieu_a(2.0, 1.5))    # 4.746779468115387
    ```
    """
    if not allowed(m, 0.0) or q != q:
        return nan
    return _value(m, q, True)


def mathieu_b(m: f64, q: f64) -> f64:
    """The characteristic value b_m(q) of the odd Mathieu function se_m(x, q), as
    `scipy.special.mathieu_b`. m is a whole number from 1 up; any other m gives NaN.

    ```python
    from special import mathieu_b

    print(mathieu_b(2.0, 1.5))    # 3.814290870563324
    ```
    """
    if not allowed(m, 1.0) or q != q:
        return nan
    return _value(m, q, False)


def mathieu_cem(m: f64, q: f64, x: f64) -> tuple[f64, f64]:
    """The even Mathieu function ce_m(x, q) and its derivative, as `scipy.special.mathieu_cem`:
    x is in degrees, as SciPy takes it, and the derivative is per radian, as SciPy gives it.

    ```python
    from special import mathieu_cem

    value, slope = mathieu_cem(2.0, 1.5, 30.0)
    print(value)    # 0.7944735999023059
    print(slope)    # -1.1494447465718143
    ```
    """
    if not allowed(m, 0.0) or q != q or x != x or abs(x) == inf:
        return (nan, nan)
    return _function(m, q, x, True)


def mathieu_sem(m: f64, q: f64, x: f64) -> tuple[f64, f64]:
    """The odd Mathieu function se_m(x, q) and its derivative, as `scipy.special.mathieu_sem`,
    with x in degrees and the derivative per radian.

    ```python
    from special import mathieu_sem

    value, slope = mathieu_sem(2.0, 1.5, 30.0)
    print(value)    # 0.7531661996621758
    print(slope)    # 1.2043246333574347
    ```
    """
    if not allowed(m, 1.0) or q != q or x != x or abs(x) == inf:
        return (nan, nan)
    return _function(m, q, x, False)
