"""Internal file of `linalg` (decision 0040): the bodies of `lu_factor`, `lu_solve`, `solve`,
`det`, `inv`, `cholesky` and `qr` for `complex128` matrices (roadmap 3.10.8 and 3.10.9). The
overloads in `linalg_factor` call them (decision 0067); they are their own file so that
`linalg_factor` stays under 500 lines. A program cannot import this file.

They follow the real bodies step for step, in the order of LAPACK's complex routines. A generic
body cannot serve both, since under `[T: Float]` a value is real, and the pivot's size, `abs` of
a complex number, is a float rather than a `T`.
"""

from math import copysign, fabs, hypot, sqrt
from linalg_common import LinAlgError


def complex_lu_factor(
    a: Array[complex128, 2],
) -> Raises[tuple[Array[complex128, 2], Array[int, 1]], LinAlgError]:
    """The LU factors of a square complex matrix `a` with partial pivoting, as
    `scipy.linalg.lu_factor`. A column's pivot is the entry with the largest `|re| + |im|`, the
    size LAPACK's `izamax` compares, so the rows swap as they do in NumPy. Raises `LinAlgError`
    when a pivot is exactly zero; panics when `a` is not square.
    """
    n = a.shape[0]
    assert a.shape[1] == n, "lu_factor needs a square matrix"
    lu = a.copy()
    piv = Array.zeros(n, int)
    for k in range(n):
        pivot = k
        largest = _size(lu[k, k])
        for i in range(k + 1, n):
            if _size(lu[i, k]) > largest:
                largest = _size(lu[i, k])
                pivot = i
        if largest == 0.0:
            raise LinAlgError("Singular matrix")
        piv[k] = pivot
        if pivot != k:
            for j in range(n):
                swap = lu[k, j]
                lu[k, j] = lu[pivot, j]
                lu[pivot, j] = swap
        for i in range(k + 1, n):
            factor = lu[i, k] / lu[k, k]
            lu[i, k] = factor
            for j in range(k + 1, n):
                lu[i, j] -= factor * lu[k, j]
    return lu, piv


def complex_lu_solve_vector(
    lu: Array[complex128, 2], piv: Array[int, 1], b: Array[complex128, 1],
) -> Array[complex128, 1]:
    """`lu_solve` of a complex factorization and one right-hand side: the swaps of `piv`, then
    forward and back substitution, each `x[i]` adding its terms left to right.
    """
    n = lu.shape[0]
    assert lu.shape[1] == n, "lu_solve needs a square lu"
    assert len(piv) == n, "lu_solve needs piv as long as lu has rows"
    assert len(b) == n, "lu_solve needs b as long as lu has rows"
    x = b.copy()
    for k in range(n):
        pivot = piv[k]
        if pivot != k:
            swap = x[k]
            x[k] = x[pivot]
            x[pivot] = swap
    for i in range(n):
        total = x[i]
        for k in range(i):
            total -= lu[i, k] * x[k]
        x[i] = total
    for k in range(n - 1, -1, -1):
        total = x[k]
        for j in range(k + 1, n):
            total -= lu[k, j] * x[j]
        x[k] = total / lu[k, k]
    return x


def complex_lu_solve_matrix(
    lu: Array[complex128, 2], piv: Array[int, 1], b: Array[complex128, 2],
) -> Array[complex128, 2]:
    """`lu_solve` of a complex factorization and a matrix of right-hand sides, one column at a
    time, so every column gets the bits it would get alone.
    """
    n = lu.shape[0]
    assert b.shape[0] == n, "lu_solve needs b with as many rows as lu"
    columns = b.shape[1]
    x = Array.zeros((n, columns), complex128)
    column = Array.zeros(n, complex128)
    for j in range(columns):
        for i in range(n):
            column[i] = b[i, j]
        solved = complex_lu_solve_vector(lu, piv, column)
        for i in range(n):
            x[i, j] = solved[i]
    return x


def complex_det(a: Array[complex128, 2]) -> complex128:
    """The determinant of a square complex matrix: the product of `U`'s diagonal, negated once
    for each row swap. A singular matrix gives `0j`.
    """
    try:
        lu, piv = complex_lu_factor(a)
    except LinAlgError:
        return 0j
    result = 1 + 0j
    for k in range(len(piv)):
        result *= lu[k, k]
        if piv[k] != k:
            result = -result
    return result


def complex_inv(a: Array[complex128, 2]) -> Raises[Array[complex128, 2], LinAlgError]:
    """The inverse of a square complex matrix: `lu_solve` of each column of the identity."""
    n = a.shape[0]
    lu, piv = complex_lu_factor(a)
    result = Array.zeros((n, n), complex128)
    column = Array.zeros(n, complex128)
    for j in range(n):
        column.fill(0j)
        column[j] = 1 + 0j
        x = complex_lu_solve_vector(lu, piv, column)
        for i in range(n):
            result[i, j] = x[i]
    return result


def _size(z: complex128) -> f64:
    """`|re| + |im|`, the size LAPACK's `izamax` and `dcabs1` give a complex number: cheaper
    than `abs(z)`, and the one that picks NumPy's pivots.
    """
    return fabs(z.real) + fabs(z.imag)


def complex_cholesky(a: Array[complex128, 2]) -> Raises[Array[complex128, 2], LinAlgError]:
    """The lower triangular `l` with `l @ lᴴ == a`, for a Hermitian positive definite complex
    matrix `a`, as `numpy.linalg.cholesky`. Reads only `a`'s lower triangle and the real parts of
    its diagonal, in LAPACK's unblocked `zpotf2` order: about 4n³/3 real multiply-adds. Raises
    `LinAlgError` when a diagonal entry is not positive; panics when `a` is not square.
    """
    n = a.shape[0]
    assert a.shape[1] == n, "cholesky needs a square matrix"
    l = Array.zeros((n, n), complex128)
    for j in range(n):
        diagonal = a[j, j].real
        for k in range(j):
            diagonal -= l[j, k].real * l[j, k].real + l[j, k].imag * l[j, k].imag
        if not diagonal > 0.0:
            raise LinAlgError("Matrix is not positive definite")
        pivot = sqrt(diagonal)
        l[j, j] = complex(pivot, 0.0)
        for i in range(j + 1, n):
            total = a[i, j]
            for k in range(j):
                total -= l[i, k] * l[j, k].conjugate()
            l[i, j] = complex(total.real / pivot, total.imag / pivot)
    return l


def complex_qr(a: Array[complex128, 2]) -> tuple[Array[complex128, 2], Array[complex128, 2]]:
    """The factors `q` and `r` of an m × n complex matrix `a` with `q @ r == a`, as
    `numpy.linalg.qr(a)`: `q` is m × k with orthonormal columns, `qᴴ @ q` the identity, and `r`
    is k × n upper triangular with a real diagonal, for k = min(m, n).

    Householder reflections in LAPACK's unblocked `zgeqr2` and `zung2r` order, each made as
    `zlarfg` makes it, so `q` and `r` match NumPy's and not only up to a phase. Never fails.
    """
    m = a.shape[0]
    n = a.shape[1]
    k = min(m, n)
    work = a.copy()
    tau = Array.zeros(k, complex128)
    for i in range(k):
        alpha = work[i, i]
        squares = 0.0
        for row in range(i + 1, m):
            squares += work[row, i].real * work[row, i].real + work[row, i].imag * work[row, i].imag
        if squares == 0.0 and alpha.imag == 0.0:
            continue
        beta = -copysign(hypot(hypot(alpha.real, alpha.imag), sqrt(squares)), alpha.real)
        tau[i] = complex((beta - alpha.real) / beta, -alpha.imag / beta)
        scale = (1 + 0j) / (alpha - complex(beta, 0.0))
        for row in range(i + 1, m):
            work[row, i] *= scale
        work[i, i] = 1 + 0j
        _reflect(work, tau[i].conjugate(), i, i + 1, n)
        work[i, i] = complex(beta, 0.0)
    r = Array.zeros((k, n), complex128)
    for row in range(k):
        for column in range(row, n):
            r[row, column] = work[row, column]
    q = Array.zeros((m, k), complex128)
    for row in range(m):
        for column in range(k):
            q[row, column] = work[row, column]
    for i in range(k - 1, -1, -1):
        if i < k - 1:
            q[i, i] = 1 + 0j
            _reflect(q, tau[i], i, i + 1, k)
        for row in range(i + 1, m):
            q[row, i] *= -tau[i]
        q[i, i] = 1 - tau[i]
        for row in range(i):
            q[row, i] = 0j
    return q, r


def _reflect(matrix: InOut[Array[complex128, 2]], tau: complex128, i: int, start: int, stop: int):
    """Applies the reflection `I - tau v vᴴ` from the left to columns `start` to `stop` of
    `matrix`, rows `i` on, where `v` is column `i` from row `i` down: LAPACK's `zlarf`.
    """
    if tau == 0j:
        return
    m = matrix.shape[0]
    for column in range(start, stop):
        total = 0j
        for row in range(i, m):
            total += matrix[row, i].conjugate() * matrix[row, column]
        total *= tau
        for row in range(i, m):
            matrix[row, column] -= total * matrix[row, i]
