"""The `backend_svg` library file: draws paths, markers, rectangles and text into an SVG file, as
matplotlib's `backend_svg` does (decision 0046).

It is internal to the standard library: `byplot` and the files under it import it, and a
program cannot, so a program's own `backend_svg.byn` is never hidden by it.

`byplot` lays a figure out in points, measured from the figure's top left corner, and hands each
piece to a `RendererSVG`; `tostring` then gives the file's text. `RendererSVG` has the trait
`backend_bases.RendererBase`, whose calls the PNG and PDF renderers of roadmap 3.15.6 and 3.15.7
take too, so `byplot` lays a figure out once for every format.
"""

from backend_bases import RendererBase
from font import approximate_width, math_layout
from math import isfinite
from png import encode


class RendererSVG(Struct, RendererBase):
    """An SVG drawing `width` by `height` points, built up one call at a time, as matplotlib's
    `RendererSVG`. Make one with no elements and no clip yet, `RendererSVG(460.8, 345.6, [], 0)`.

    Every coordinate is in points from the top left corner, y growing downwards, as SVG has it.
    Each call adds one element, so the cost is linear in what is drawn: about 15 bytes a point
    of a path, and about 60 a marker.
    """

    width: f64  # the drawing's width in points
    height: f64  # the drawing's height in points
    elements: list[str]  # the SVG elements drawn so far, in order
    clips: int  # how many clip rectangles `set_clip` has set; the last one is in force

    def set_clip(self: InOut[Self], x: f64, y: f64, width: f64, height: f64) -> None:
        """Sets the rectangle that the drawing calls clip to when asked: the axes, so data outside
        the range shown is cut off at its edge. Set it before drawing each axes of a figure; the
        first is called `axes` in the file, the next `axes2` and so on."""
        self.clips += 1
        self.elements.append(
            f'<clipPath id="{_clip_id(self.clips)}"><rect x="{_number(x)}" y="{_number(y)}" '
            + f'width="{_number(width)}" height="{_number(height)}"/></clipPath>'
        )

    def draw_path(
        self: InOut[Self],
        x: Array[f64, 1],
        y: Array[f64, 1],
        color: str,
        linewidth: f64,
        dashes: list[f64],
        capstyle: str,
        clip: bool,
    ) -> None:
        """Strokes straight lines through the points `(x[i], y[i])`, in `color`, `linewidth`
        points wide, dashed by the on and off lengths `dashes` when it is not empty. A point
        with a NaN or infinite coordinate lifts the pen, so the line breaks there. `capstyle` is
        matplotlib's: `"projecting"` ends reach half the width past the last point, as data
        lines and grid lines do, and `"butt"` ends stop at it, as ticks do. Joins are round."""
        cut = _clip(clip, self.clips)  # the clip attribute, if any
        path: list[str] = []
        pen_down = False
        for i in range(len(x)):
            if isfinite(x[i]) and isfinite(y[i]):
                command = "L" if pen_down else "M"
                path.append(f"{command}{_number(x[i])} {_number(y[i])}")
                pen_down = True
            else:
                pen_down = False
        if len(path) == 0:
            return
        pattern = ""
        if len(dashes) > 0:
            pattern = ' stroke-dasharray="' + ",".join([_number(d) for d in dashes]) + '"'
        self.elements.append(
            f'<path d="{"".join(path)}"{cut} fill="none" stroke="{color}" '
            + f'stroke-width="{linewidth}" stroke-linecap="{_cap(capstyle)}" '
            + 'stroke-linejoin="round"'
            + f"{pattern}/>"
        )

    def draw_polygon(
        self: InOut[Self], x: Array[f64, 1], y: Array[f64, 1], fill: str, opacity: f64, clip: bool
    ) -> None:
        """Fills the polygons through the points `(x[i], y[i])`, in `fill` at `opacity` from 0
        to 1, with no edge, as matplotlib fills a `PolyCollection`. A point with a NaN or
        infinite coordinate closes the polygon so far, and the next point starts a new one."""
        cut = _clip(clip, self.clips)  # the clip attribute, if any
        path: list[str] = []
        pen_down = False
        for i in range(len(x)):
            if isfinite(x[i]) and isfinite(y[i]):
                command = "L" if pen_down else "M"
                path.append(f"{command}{_number(x[i])} {_number(y[i])}")
                pen_down = True
            elif pen_down:
                path.append("Z")
                pen_down = False
        if pen_down:
            path.append("Z")
        if len(path) == 0:
            return
        shade = ""
        if opacity < 1.0:
            shade = f' fill-opacity="{opacity}"'
        self.elements.append(f'<path d="{"".join(path)}"{cut} fill="{fill}"{shade}/>')

    def draw_markers(
        self: InOut[Self],
        x: Array[f64, 1],
        y: Array[f64, 1],
        marker: str,
        size: f64,
        color: str,
        edgewidth: f64,
        clip: bool,
    ) -> None:
        """Draws the marker `marker` centred on each finite point, `size` points across, filled
        and edged in `color` with an edge `edgewidth` wide, as matplotlib's markers are:
        `"o"` a circle, `"."` a circle half as big, `"s"` a square, `"^"` and `"v"` triangles
        pointing up and down, `"D"` a diamond, `"+"` and `"x"` crosses, and `"_"` and `"|"`
        lines across and up, which are edge only.
        The marker is defined once and placed at each point, so a point costs one short element.
        """
        cut = _clip(clip, self.clips)  # the clip attribute, if any
        name = f"marker{len(self.elements)}"
        self.elements.append(
            f'<defs><path id="{name}" d="{_marker_path(marker, size)}" fill="{color}" '
            + f'stroke="{color}" stroke-width="{edgewidth}"/></defs>'
        )
        group: list[str] = [f"<g{cut}>"]
        for i in range(len(x)):
            if isfinite(x[i]) and isfinite(y[i]):
                group.append(f'<use href="#{name}" x="{_number(x[i])}" y="{_number(y[i])}"/>')
        group.append("</g>")
        self.elements.append("".join(group))

    def draw_rectangle(
        self: InOut[Self],
        x: f64,
        y: f64,
        width: f64,
        height: f64,
        fill: str,
        opacity: f64,
        edge: str,
        edgewidth: f64,
        clip: bool,
    ) -> None:
        """Draws a rectangle with its top left corner at `(x, y)`, filled with `fill` at
        `opacity` from 0 to 1 and edged in `edge` `edgewidth` points wide; `fill` or `edge`
        `"none"` leaves that part out. A negative width or height is drawn from the other
        side."""
        cut = _clip(clip, self.clips)  # the clip attribute, if any
        left = min(x, x + width)
        top = min(y, y + height)
        stroke = ""
        if edge != "none":
            stroke = f' stroke="{edge}" stroke-width="{edgewidth}" stroke-linejoin="miter"'
        shade = ""
        if opacity < 1.0:
            shade = f' fill-opacity="{opacity}"'
        self.elements.append(
            f'<rect x="{_number(left)}" y="{_number(top)}" width="{_number(abs(width))}" '
            + f'height="{_number(abs(height))}"{cut} fill="{fill}"{shade}{stroke}/>'
        )

    def draw_image(
        self: InOut[Self],
        x: f64,
        y: f64,
        width: f64,
        height: f64,
        pixels: Array[u8, 3],
        smooth: bool,
        clip: bool,
    ) -> None:
        """Draws the RGBA image `pixels`, rows from the top, stretched over the rectangle with
        its top left corner at `(x, y)`, `width` by `height` points, as a PNG embedded in the
        file, as matplotlib embeds images. `smooth` lets the viewer blend neighbouring pixels,
        as matplotlib's antialiasing does when it shrinks an image; otherwise each pixel stays
        a sharp rectangle, as its `"nearest"` interpolation draws an image it enlarges. Costs
        about 5.5 bytes of the file a pixel, until PNG data are compressed (roadmap 3.27)."""
        cut = _clip(clip, self.clips)  # the clip attribute, if any
        sharp = "" if smooth else ' style="image-rendering:pixelated"'
        self.elements.append(
            f'<image x="{_number(x)}" y="{_number(y)}" width="{_number(width)}" '
            + f'height="{_number(height)}" preserveAspectRatio="none"{cut}{sharp} '
            + f'href="data:image/png;base64,{_base64(encode(pixels))}"/>'
        )

    def draw_text(
        self: InOut[Self], x: f64, y: f64, text: str, size: f64, anchor: str, rotate: bool
    ) -> None:
        """Writes `text` with its baseline at `(x, y)`, `size` points tall in DejaVu Sans,
        anchored at `anchor`: `"start"`, `"middle"` or `"end"`. `rotate` turns it to read
        upwards, as a y label does. XML's special characters are escaped, so any text is safe.
        A label `ticker.LogFormatterSciNotation` writes, `$\\mathdefault{2\\times10^{3}}$`, is
        drawn as matplotlib's mathtext draws it, with the exponent raised and smaller; it is
        never turned.
        """
        if text.startswith("$\\mathdefault{"):
            self._draw_math(x, y, text, size, anchor)
            return
        place = f'x="{_number(x)}" y="{_number(y)}"'
        if rotate:
            place = f'transform="translate({_number(x)} {_number(y)}) rotate(-90)"'
        self.elements.append(
            f'<text {place} font-family="DejaVu Sans, Bitstream Vera Sans, Arial, Helvetica, '
            + f'sans-serif" font-size="{size}" text-anchor="{anchor}" fill="#000000">'
            + f"{_escape(text)}</text>"
        )

    def get_text_width_height_descent(self: Self, text: str, size: f64) -> tuple[f64, f64, f64]:
        """About how wide `text` is in DejaVu Sans at `size` points, how tall a line of it is,
        and how far its layout box reaches below the baseline, as matplotlib's renderers report
        them. The viewer draws the text, so the width is estimated from DejaVu Sans's widths
        of digits, the point and the minus sign, which tick labels are made of, and an average
        of 0.6 of the size for other characters. The height and descent are those of
        matplotlib's layout box for one line, which since matplotlib 3.11 is never smaller than
        the font's typographic ascent and descent: 1556 and 492 of DejaVu Sans's 2048 units, so
        0.7598 of the size above the baseline and 0.2402 below it, a line one size tall. A
        mathtext label's box is matplotlib's for one with an exponent: 0.854 of the size above
        the baseline and 0.322 below it.
        """
        if text.startswith("$\\mathdefault{"):
            return (math_layout(text, size)[4], 1.1762 * size, 0.3224 * size)
        return (approximate_width(text) * size, size, 492.0 / 2048.0 * size)

    def _draw_math(self: InOut[Self], x: f64, y: f64, text: str, size: f64, anchor: str) -> None:
        """Draws the mathtext label `text` as `draw_text` describes, each piece placed where
        matplotlib's mathtext puts it, so the viewer's own spacing cannot move it."""
        coefficient, exponent, at_ten, at_exponent, width = math_layout(text, size)
        left = x
        if anchor == "middle":
            left = x - 0.5 * width
        elif anchor == "end":
            left = x - width
        raised = y - 0.413 * size
        pieces = ""
        if coefficient != "":
            times = left + (approximate_width(coefficient) + 0.1948) * size
            pieces = (
                f'<tspan x="{_number(left)}" y="{_number(y)}">{coefficient}</tspan>'
                + f'<tspan x="{_number(times)}" y="{_number(y)}">\u00d7</tspan>'
            )
        self.elements.append(
            f'<text font-family="DejaVu Sans, Bitstream Vera Sans, Arial, Helvetica, '
            + f'sans-serif" font-size="{size}" fill="#000000">{pieces}'
            + f'<tspan x="{_number(left + at_ten)}" y="{_number(y)}">10</tspan>'
            + f'<tspan x="{_number(left + at_exponent)}" y="{_number(raised)}" '
            + f'font-size="{0.7 * size:.1f}">{exponent}</tspan></text>'
        )

    def tostring(self: Self) -> str:
        """The whole SVG file: its header, a white background, and every element in the order
        drawn."""
        head = [
            '<?xml version="1.0" encoding="utf-8" standalone="no"?>',
            f'<svg xmlns="http://www.w3.org/2000/svg" width="{self.width}pt" '
            + f'height="{self.height}pt" viewBox="0 0 {self.width} {self.height}" version="1.1">',
            f'<rect width="{self.width}" height="{self.height}" fill="#ffffff"/>',
        ]
        return "\n".join(head) + "\n" + "\n".join(self.elements) + "\n</svg>\n"


def _number(value: f64) -> str:
    """A coordinate in the SVG, to a thousandth of a point."""
    return f"{value:.3f}"


def _base64(data: list[u8]) -> str:
    """`data` in base64, as a `data:` URL holds it: each three bytes as four characters of
    `A` to `Z`, `a` to `z`, `0` to `9`, `+` and `/`, and `=` padding the end."""
    alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    out: list[str] = []
    for start in range(0, len(data), 3):
        left = len(data) - start
        group = int(data[start]) << 16
        if left > 1:
            group = group | (int(data[start + 1]) << 8)
        if left > 2:
            group = group | int(data[start + 2])
        out.append(alphabet[(group >> 18) & 63].copy())
        out.append(alphabet[(group >> 12) & 63].copy())
        out.append(alphabet[(group >> 6) & 63].copy() if left > 1 else "=")
        out.append(alphabet[group & 63].copy() if left > 2 else "=")
    return "".join(out)


def _cap(capstyle: str) -> str:
    """SVG's name for a matplotlib cap style: `"projecting"` is SVG's `"square"`."""
    return "square" if capstyle == "projecting" else capstyle.copy()


def _clip(clip: bool, clips: int) -> str:
    """The attribute that clips an element to the clip rectangle numbered `clips`, the last one
    set, or nothing."""
    return f' clip-path="url(#{_clip_id(clips)})"' if clip else ""


def _clip_id(clips: int) -> str:
    """The SVG id of the clip rectangle numbered `clips`: `axes` for the first, as a figure of
    one axes has, then `axes2`, `axes3` and so on."""
    return "axes" if clips <= 1 else f"axes{clips}"


def _escape(text: str) -> str:
    """`text` with XML's special characters escaped, so it is safe inside an element."""
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def _marker_path(marker: str, size: f64) -> str:
    """The SVG path of `marker` centred on 0, 0 and `size` points across, as matplotlib's
    `MarkerStyle` shapes it. Panics on a marker it does not know."""
    half = 0.5 * size
    if marker == "o" or marker == ".":
        radius = half if marker == "o" else 0.5 * half
        return (
            f"M{_number(-radius)} 0A{_number(radius)} {_number(radius)} 0 1 0 "
            + f"{_number(radius)} 0A{_number(radius)} {_number(radius)} 0 1 0 "
            + f"{_number(-radius)} 0Z"
        )
    if marker == "s":
        corner = _number(-half)
        return f"M{corner} {corner}H{_number(half)}V{_number(half)}H{corner}Z"
    if marker == "^":
        return f"M0 {_number(-half)}L{_number(half)} {_number(half)}H{_number(-half)}Z"
    if marker == "v":
        return f"M0 {_number(half)}L{_number(half)} {_number(-half)}H{_number(-half)}Z"
    if marker == "D":
        return f"M0 {_number(-half)}L{_number(half)} 0L0 {_number(half)}L{_number(-half)} 0Z"
    if marker == "+":
        return f"M{_number(-half)} 0H{_number(half)}M0 {_number(-half)}V{_number(half)}"
    if marker == "_":
        return f"M{_number(half)} 0H{_number(-half)}"
    if marker == "|":
        return f"M0 {_number(-half)}V{_number(half)}"
    known = marker == "x"
    assert known, f"{marker!r} is not a marker: 'o', '.', 's', '^', 'v', 'D', '+', 'x', '_' or '|'"
    return (
        f"M{_number(-half)} {_number(-half)}L{_number(half)} {_number(half)}"
        + f"M{_number(-half)} {_number(half)}L{_number(half)} {_number(-half)}"
    )
