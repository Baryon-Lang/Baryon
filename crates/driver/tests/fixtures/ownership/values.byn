# Ownership sweep sites (roadmap 1.18.2): Values in expressions: temporaries, variables, conditional and boolean expressions, `str` operations.
# Each `# site:` block is one function the test calls; `once` marks a site that does not use
# `ITEM` and runs only in the first kind's program. See crates/driver/tests/build/ownership.rs.


# site: temp_borrow
# A new value borrowed by a call, as a display and as a call's result.
def temp_borrow():
    show(NEW1)
    show(make(4))


# site: named_borrow
# A variable borrowed twice.
def named_borrow():
    a = NEW1
    show(a)
    show(a)


# site: rebind
# Assigning a variable a second value drops the first.
def rebind():
    a = NEW1
    a = NEW2
    show(a)


# site: discard_result
# A call's result that nothing uses, dropped at once.
def discard_result():
    make(3)
    make_list(2)


# site: cond_new_new
# A conditional expression choosing between two new values.
def cond_new_new():
    a = NEW1 if flag(1) else NEW2
    show(a)
    b = NEW1 if flag(0) else NEW2
    show(b)


# site: cond_named_named
# A conditional expression moving one of two variables into a third.
def cond_named_named():
    a = NEW1
    b = NEW2
    c = a if flag(1) else b
    show(c)


# site: cond_named_new
# A conditional expression choosing between a variable and a new value.
def cond_named_new():
    a = NEW1
    c = a if flag(0) else NEW2
    show(c)


# site: cond_arg_temp_named
# A conditional expression borrowed by a call, a new value on one side and a copy of a variable on
# the other. Naming the variable itself there is a compile error.
def cond_arg_temp_named():
    a = NEW1
    show(NEW2 if flag(1) else a.copy())
    show(NEW2 if flag(0) else a.copy())
    show(a)


# site: cond_arg_named_named
# A conditional expression borrowed by a call, a copy of a variable on each side; both variables
# stay usable. Naming the variables themselves there is a compile error.
def cond_arg_named_named():
    a = NEW1
    b = NEW2
    show(a.copy() if flag(1) else b.copy())
    show(a)
    show(b)


# site: boolean_and_temps
# New values borrowed inside `and` and `or`, which may skip their right side.
def boolean_and_temps():
    if size(NEW1) > 0 and size(NEW2) > 0:
        print("both")
    if size(NEW1) < 0 or size(NEW2) > 0:
        print("either")


# site: match_arm
# A variable assigned a value in each arm of a `match`.
def match_arm():
    for k in range(3):
        match k:
            case 0:
                a = NEW1
            case _:
                a = make(k)
        show(a)


# site: match_union_capture once
# A `match` on unions of structs that hold a `str` and a list.
def match_union_capture():
    for k in range(3):
        s = make_shape(k)
        match s:
            case Circle(label):
                print(label)
            case Square(size, tags):
                print(size, tags[0])


# site: optional_wrap
# A value stored in an optional variable, then replaced by `None`.
def optional_wrap():
    o: ITEM | None = None
    o = NEW1
    if o is not None:
        show(o)
    o = None
    print(o is None)


# site: optional_return
# A function returning a value or `None`.
def optional_return_maybe(k: int) -> ITEM | None:
    if flag(k):
        return make(k)
    return None


def optional_return():
    a = optional_return_maybe(1)
    if a is not None:
        show(a)
    b = optional_return_maybe(2)
    print(b is None)


# site: str_concat once
# `str` values built with `+` from new values and variables.
def str_concat():
    a = f"x{1}" + f"y{2}"
    b = a + f"z{3}"
    print(a, b)
    print(f"p{1}" + a)


# site: str_slice once
# Slices of a `str`, kept in a variable and chosen by a conditional expression.
def str_slice():
    s = f"hello{7}"
    t = s[0:2]
    print(t, s)
    print(f"wor{1}"[1:])
    u = s[1:3] if flag(1) else s
    print(u)


# site: str_methods_temp once
# `str` methods called on new values: `strip`, `upper`, `split` and `join`.
def str_methods_temp():
    print(f" a{1} ".strip().upper())
    parts = f"a{1},b{2}".split(",")
    print(parts[1])
    print("-".join(parts))


# site: compare_temps
# `==` between new values and a variable.
def compare_temps():
    print(make(1) == make(1))
    a = NEW1
    print(a == make(1))


# site: print_value
# `print` of a variable, a new value and a new list.
def print_value():
    a = NEW1
    print(a)
    print(make(2))
    print(make_list(2))


# site: fstring_value
# An f-string reading a variable and a new value.
def fstring_value():
    a = NEW1
    print(f"{size(a)} {size(make(3))}")
