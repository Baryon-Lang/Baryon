def statements(items: list[int]):
    first, *rest = items
    del first
    global counter
    nonlocal total
    while True:
        break
    else:
        pass
    for item in items:
        pass
    # else: in a comment is not the keyword
    else:
        pass
    with lock():
        pass
    try:
        work()
    except:
        pass
    else:
        done()
    finally:
        cleanup()
    try:
        work()
    except* ValueError:
        pass
    yield 1
    yield from items


type Vector = list[float]

from math import *


async def fetch():
    async for chunk in stream():
        pass
    async with lock():
        await chunk


def outer():
    def inner():
        pass
    inner()


def load(path: str) -> Raises[int, LoadError]:
    try:
        return parse(path)
    except ParseError as error:
        raise LoadError(path) from error


def quiet(path: str) -> Raises[int, LoadError]:
    raise LoadError(path) from None
